@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject AppNavigator Navigator
@inject IdentityService IdentityService
@inject AuthenticationStateProvider AuthProvider

<nav class="navbar navbar-expand-lg navbar-dark sticky-top border-bottom border-white border-opacity-10 shadow-lg py-2 bg-black">
    <div class="container">
        @* Brand / Logo *@
        <div class="navbar-brand d-flex align-items-center py-0 user-select-none pointer"
             @onclick='() => Navigator.NavigateTo(AppRoutes.Index)'>
            <img src="assets/logo.png" alt="RedSkia Logo" style="height: 45px; width: auto;" class="me-3 object-fit-contain">
            <div class="lh-1">
                <span class="fw-bolder fs-4 text-white d-block tracking-tight" style="letter-spacing: -1px;">REDSKIA</span>
                <small class="text-danger fw-bold text-uppercase" style="letter-spacing: 3px; font-size: 0.6rem;">Banking</small>
            </div>
        </div>

        <button class="navbar-toggler border-0 shadow-none p-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto ms-lg-5 py-3 py-lg-0 border-top border-white border-opacity-10 border-top-lg-0 mt-2 mt-lg-0">
                <li class="nav-item">
                    <span class="nav-link px-lg-3 py-2 fw-bold text-uppercase small tracking-widest text-center text-lg-start pointer"
                          @onclick='() => Navigator.NavigateTo(AppRoutes.Dashboard)'>Dashboard</span>
                </li>
                <li class="nav-item">
                    <span class="nav-link px-lg-3 py-2 fw-bold text-uppercase small tracking-widest text-center text-lg-start pointer"
                          @onclick='() => Navigator.NavigateTo(AppRoutes.Market)'>Market</span>
                </li>
            </ul>

            <div class="d-flex flex-column flex-lg-row gap-3 align-items-center py-3 py-lg-0 border-top border-white border-opacity-10 border-top-lg-0 mt-2 mt-lg-0">
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex flex-column flex-lg-row align-items-center gap-3 ps-lg-3 w-100">

                            @* Profile Capsule *@
                            <div class="d-flex align-items-center gap-3 order-1 order-lg-0 border border-white border-opacity-10 rounded-pill pe-4 ps-2 py-1 transition-base hover-bg-dark pointer"
                                 @onclick='() => Navigator.NavigateTo(AppRoutes.Account)'>

                                <div class="text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm border border-white border-opacity-25"
                                     style="width: 38px; height: 38px; background-color: @(currentRole?.RoleColor ?? "#c80000"); flex-shrink: 0; font-size: 0.9rem;">
                                    @GetInitials(currentUser?.FullName ?? context.User.Identity?.Name)
                                </div>

                                <div class="text-center text-lg-start">
                                    <div class="text-white fw-bold lh-1 mb-1" style="font-size: 0.85rem;">
                                        @(currentUser?.FullName ?? context.User.Identity?.Name ?? "User")
                                    </div>
                                    <span class="badge rounded-pill fw-bolder px-2 py-1"
                                          style="background-color: @(currentRole?.RoleColor ?? "#808080")33;
                                                 color: @(currentRole?.RoleColor ?? "#808080");
                                                 border: 1px solid @(currentRole?.RoleColor ?? "#808080")66;
                                                 font-size: 0.55rem; letter-spacing: 1px;">
                                        @FormatRole(currentRole?.Name)
                                    </span>
                                </div>
                            </div>

                            <button class="btn btn-outline-danger btn-sm rounded-pill px-4 py-2 order-0 order-lg-1 w-100 w-lg-auto fw-bold"
                                    @onclick="HandleLogout">
                                LOGOUT
                            </button>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="d-flex flex-column flex-lg-row gap-2 w-100 w-lg-auto text-center">
                            <button class="btn btn-link text-white-50 text-decoration-none fw-bold small py-2"
                                    @onclick='() => Navigator.NavigateTo(AppRoutes.Login)'>
                                LOGIN
                            </button>
                            <button class="btn btn-primary rounded-pill px-4 py-2 shadow-lg fw-bold w-100 w-lg-auto text-uppercase"
                                    @onclick='() => Navigator.NavigateTo(AppRoutes.LoginRegister)'>
                                SIGN UP
                            </button>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</nav>

@code {
    private ApplicationUser? currentUser;
    private ApplicationRole? currentRole;

    protected override void OnInitialized()
    {
        AuthProvider.AuthenticationStateChanged += AuthChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUser();
    }

    private async void AuthChanged(Task<AuthenticationState> task)
    {
        await InvokeAsync(async () =>
        {
            await LoadUser();
            StateHasChanged();
        });
    }

    private async Task LoadUser()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();

        if (state.User.Identity?.IsAuthenticated == true)
        {
            currentUser = await IdentityService.GetCurrentApplicationUserAsync();
            currentRole = await IdentityService.GetCurrentApplicationRoleAsync();
        }
        else
        {
            currentUser = null;
            currentRole = null;
        }
    }

    private string FormatRole(string? roleName)
    {
        if (string.IsNullOrEmpty(roleName)) return "CUSTOMER";
        if (roleName.Equals("LoanOfficer", StringComparison.OrdinalIgnoreCase)) return "OFFICER";
        return roleName.ToUpper();
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return parts[0][0].ToString().ToUpper();
    }

    private async Task HandleLogout()
    {
        await IdentityService.Logout();
        await Navigator.NavigateTo(AppRoutes.Index);
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= AuthChanged;
    }
}