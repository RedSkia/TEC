@typeparam TItem

<div class="input-auto-container position-relative rounded-3 bg-light border shadow-sm">
    @* GHOST SUGGESTION LAYER *@
    <div class="position-absolute start-0 top-0 w-100 h-100 px-3 py-2 text-muted opacity-50 pointer-events-none"
         style="z-index: 1; white-space: pre; font-family: inherit; font-size: inherit; pointer-events: none;">
        <span style="visibility: hidden;">@Value</span>@ghostText
    </div>

    @* ACTUAL INPUT *@
    <input type="text"
           class="form-control border-0 bg-transparent py-2 px-3"
           style="z-index: 2; position: relative;"
           placeholder="@Placeholder"
           autocomplete="off"
           value="@Value"
           @oninput="HandleInput"
           @onkeydown="HandleKeyDown"
           @onblur="HideDropdownWithDelay" />

    @* SUGGESTIONS DROPDOWN *@
    @if (isDropdownVisible && FilteredItems.Any())
    {
        <div class="list-group position-absolute w-100 shadow-lg z-3 mt-1 rounded-3 overflow-hidden border-0"
             style="top: 100%; left: 0;">
            @foreach (var item in FilteredItems.Take(MaxSuggestions))
            {
                <button type="button"
                        class="list-group-item list-group-item-action py-2 px-3 border-0 d-flex align-items-center"
                        @onclick="() => SelectItem(item)">
                    @ItemTemplate(item)
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IEnumerable<TItem> Data { get; set; } = Enumerable.Empty<TItem>();
    [Parameter] public Func<TItem, string> SearchSelector { get; set; } = default!;
    [Parameter] public RenderFragment<TItem> ItemTemplate { get; set; } = default!;
    [Parameter] public EventCallback<TItem> OnItemSelected { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search...";

    // Controlled via Parameter as requested
    [Parameter] public int MaxSuggestions { get; set; } = 5;

    private List<TItem> FilteredItems = new();
    private string ghostText = "";
    private bool isDropdownVisible = false;

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? "";
        await ValueChanged.InvokeAsync(Value);

        if (!string.IsNullOrWhiteSpace(Value))
        {
            // 1. Filter the list for the dropdown
            FilteredItems = Data
                .Where(x => SearchSelector(x).Contains(Value, StringComparison.OrdinalIgnoreCase))
                .ToList();

            // 2. Handle Ghost Text (Only if the first match starts with the input)
            var firstMatch = FilteredItems.FirstOrDefault();
            if (firstMatch != null && SearchSelector(firstMatch).StartsWith(Value, StringComparison.OrdinalIgnoreCase))
            {
                ghostText = SearchSelector(firstMatch).Substring(Value.Length);
            }
            else
            {
                ghostText = "";
            }

            isDropdownVisible = FilteredItems.Any();
        }
        else
        {
            ResetState();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Tab, Enter, or ArrowRight completes the suggestion
        if ((e.Key == "Enter" || e.Key == "Tab" || e.Key == "ArrowRight") && FilteredItems.Any())
        {
            await SelectItem(FilteredItems.First());
        }
        // Escape closes the list
        else if (e.Key == "Escape")
        {
            isDropdownVisible = false;
        }
    }

    private async Task SelectItem(TItem item)
    {
        Value = SearchSelector(item);
        await ValueChanged.InvokeAsync(Value);
        await OnItemSelected.InvokeAsync(item);
        ResetState();
    }

    private void ResetState()
    {
        FilteredItems.Clear();
        ghostText = "";
        isDropdownVisible = false;
    }

    // Delay blur slightly so the @onclick of the button can fire before the div disappears
    private async Task HideDropdownWithDelay()
    {
        await Task.Delay(200);
        isDropdownVisible = false;
        StateHasChanged();
    }
}