@typeparam TItem

<div class="card border-0 shadow-sm @Class">
    @if (HeaderContent is not null)
    {
        <div class="card-header bg-transparent border-0 pt-4 pb-0">
            @HeaderContent
        </div>
    }

    <div class="card-body p-4">
        <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit" FormName="@FormName" @attributes="AdditionalAttributes">
            <DataAnnotationsValidator />

            @* The fields are rendered here. We now rely on per-field validation messages. *@
            <div class="form-fields">
                @ChildContent
            </div>

            <div class="form-actions mt-4">
                <button type="submit"
                        disabled="@IsLoading"
                        class="btn btn-primary w-100 py-2 fw-bold d-flex align-items-center justify-content-center">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        <span>@(string.IsNullOrEmpty(LoadingText) ? ButtonText : LoadingText)</span>
                    }
                    else
                    {
                        @ButtonText
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TItem Model { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter, EditorRequired] public EventCallback OnSubmit { get; set; }
    [Parameter] public string ButtonText { get; set; } = "Submit";
    [Parameter] public string? LoadingText { get; set; }
    [Parameter] public string FormName { get; set; } = "form";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private Task HandleValidSubmit() => OnSubmit.InvokeAsync();
}