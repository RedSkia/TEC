@page "/login"
@using BankApp.Data.Entities.Auth
@using BankApp.Services
@inject IAuthService AuthService
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <InputForm Model="user" OnSubmit="HandleLogin" ButtonText="Sign In" IsLoading="busy">
                <HeaderContent>
                    <h3 class="fw-bold text-center">Login</h3>
                    @if (error != null)
                    {
                        <div class="alert alert-danger py-2 small">@error</div>
                    }
                </HeaderContent>

                <ChildContent>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Username</label>
                        <InputText @bind-Value="user.UserName" class="form-control" placeholder="viking_banker" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Password</label>
                        <InputText @bind-Value="password" type="password" class="form-control" placeholder="••••••••" />
                    </div>
                </ChildContent>
            </InputForm>
        </div>
    </div>
</div>

@code {
    private ApplicationUser user = new() { FullName = "Bypass" };
    private string password = "";
    private bool busy;
    private string? error;

    async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(user.UserName) || string.IsNullOrWhiteSpace(password))
        {
            error = "Please fill in all fields.";
            return;
        }

        busy = true; error = null;
        try
        {
            // AuthService now handles NotifyUserLogin internally!
            var token = await AuthService.Login(user.UserName!, password);

            if (!string.IsNullOrEmpty(token))
            {
                Nav.NavigateTo("/"); // No forceLoad needed!
            }
            else
            {
                error = "Invalid username or password.";
            }
        }
        catch
        {
            error = "Server error. Please try again later.";
        }
        finally
        {
            busy = false;
        }
    }
}