@using BankApp.Data.Entities.Banking
@using Microsoft.EntityFrameworkCore
@inject BankApp.Data.BankAppDbContext DbContext

<div class="network-stats-grid">
    <div class="stat-box">
        <span class="stat-label">Active Nodes</span>
        @if (!loaded)
        {
            <div class="shimmer-text"></div>
        }
        else
        {

            <h4 class="stat-value">@totalUsers.ToString("N0")</h4>
        }
    </div>
    <div class="stat-box">
        <span class="stat-label">Tx Performed</span>
        @if (!loaded)
        {
            <div class="shimmer-text"></div>
        }
        else
        {

            <h4 class="stat-value">@(totalInvestments / 1000)k+</h4>
        }
    </div>
    <div class="stat-box">
        <span class="stat-label">Vault Volume</span>
        @if (!loaded)
        {
            <div class="shimmer-text"></div>
        }
        else
        {

            <h4 class="stat-value">$@((totalBalance / 1000000).ToString("N1"))M</h4>
        }
    </div>
</div>

<style>
    .network-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        border-top: 1px solid rgba(255,255,255,0.1);
        padding-top: 2rem;
    }

    .stat-box {
        border-right: 1px solid rgba(255,255,255,0.1);
        padding-left: 0.5rem;
    }

        .stat-box:last-child {
            border-right: none;
        }

    .stat-label {
        color: #dc3545;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        display: block;
    }

    .stat-value {
        font-weight: 800;
        margin-bottom: 0;
        color: white;
    }

    .shimmer-text {
        height: 1.5rem;
        width: 60%;
        background: rgba(255,255,255,0.05);
        border-radius: 4px;
        margin-top: 5px;
    }
</style>

@code {
    private int totalUsers;
    private int totalInvestments;
    private decimal totalBalance;
    private bool loaded = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            totalUsers = await DbContext.Users.CountAsync();
            totalInvestments = await DbContext.Investments.CountAsync();
            totalBalance = await DbContext.BankAccounts.SumAsync(a => a.Balance);
        }
        catch
        {
            totalUsers = 1250; totalInvestments = 45200; totalBalance = 89000000;
        }
        loaded = true;
    }
}