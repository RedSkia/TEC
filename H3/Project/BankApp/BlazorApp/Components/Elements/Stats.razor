@using BankApp.Data.Entities.Banking
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<BankApp.Data.BankAppDbContext> DbFactory
@implements IDisposable

<div class="bg-black border border-secondary shadow-lg">
    @if (loaded)
    {
        <div class="p-5 border-bottom border-secondary">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <span class="text-danger fw-bold small d-block mb-2 text-uppercase" style="letter-spacing: 2px;">Total Bank Deposits</span>
                    <h2 class="display-3 fw-bold text-white mb-0 text-truncate" style="letter-spacing: -2px;">
                        $@dBalance.ToString("N2")
                    </h2>
                </div>
                <div class="col-lg-5 text-lg-end mt-4 mt-lg-0 border-start border-secondary ps-lg-5">
                    <div class="mb-3">
                        <span class="text-secondary small d-block mb-0 fw-bold">PORTFOLIO MARKET VALUE</span>
                        <div class="h3 fw-bold text-white text-truncate">$@dMarketValue.ToString("N2")</div>
                    </div>
                    <div>
                        <span class="text-secondary small d-block mb-0 fw-bold">TOTAL CREDIT EXPOSURE</span>
                        <div class="h3 fw-bold text-white text-truncate">$@dLoans.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-0">
            <div class="col-6 col-md-3 border-end border-secondary p-4 bg-dark bg-opacity-10">
                <small class="text-secondary d-block mb-1 fw-bold text-uppercase">Total Clients</small>
                <span class="h4 text-white fw-bold">@dUsers.ToString("N0")</span>
            </div>
            <div class="col-6 col-md-3 border-end border-secondary p-4 bg-dark bg-opacity-10">
                <small class="text-secondary d-block mb-1 fw-bold text-uppercase">Active Sessions</small>
                <span class="h4 text-white fw-bold">@dLogins.ToString("N0")</span>
            </div>
            <div class="col-6 col-md-3 border-end border-secondary p-4 bg-dark bg-opacity-10">
                <small class="text-secondary d-block mb-1 fw-bold text-uppercase">Market Trades</small>
                <span class="h4 text-white fw-bold">@dTrades.ToString("N0")</span>
            </div>
            <div class="col-6 col-md-3 p-4 bg-dark bg-opacity-10">
                <small class="text-secondary d-block mb-1 fw-bold text-uppercase">Approved Loans</small>
                <span class="h4 text-white fw-bold">@dLoanCount.ToString("N0")</span>
            </div>
        </div>

        <div class="row g-0 border-top border-secondary bg-dark bg-opacity-25">
            <div class="col-4 border-end border-secondary p-3 text-center">
                <small class="text-secondary fw-bold text-uppercase me-2">Global Currencies:</small>
                <span class="text-white fw-bold">@dCurrencies</span>
            </div>
            <div class="col-4 border-end border-secondary p-3 text-center">
                <small class="text-secondary fw-bold text-uppercase me-2">Listed Stocks:</small>
                <span class="text-white fw-bold">@dStocks</span>
            </div>
            <div class="col-4 p-3 text-center">
                <small class="text-secondary fw-bold text-uppercase me-2">Active Investments:</small>
                <span class="text-success fw-bold">@dInvestments</span>
            </div>
        </div>
    }
</div>

@code {
    private bool loaded = false;
    private bool isDisposed = false;

    // Real values from DB
    private int totalUsers, currencyCount, stockVariety, totalTransactions, loginActivities, loanCount, investmentCount;
    private decimal totalBalance, totalMarketValue, totalLoans;

    // Display values for animation
    private int dUsers, dCurrencies, dStocks, dTrades, dLogins, dLoanCount, dInvestments;
    private decimal dBalance, dMarketValue, dLoans;

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Fetch real data
        totalUsers = await db.Users.CountAsync();
        currencyCount = await db.CurrencyTypes.CountAsync();
        stockVariety = await db.Stocks.CountAsync();
        totalTransactions = await db.Transactions.CountAsync();
        loginActivities = await db.LoginActivities.CountAsync();
        loanCount = await db.LoanRequests.CountAsync(l => l.Status == LoanStatus.Approved);
        investmentCount = await db.Investments.CountAsync();
        totalBalance = await db.BankAccounts.AnyAsync() ? await db.BankAccounts.SumAsync(a => a.Balance) : 0;
        totalMarketValue = await db.Investments.AnyAsync() ? await db.Investments.SumAsync(i => i.Quantity * i.Stock.CurrentPrice) : 0;
        totalLoans = await db.LoanRequests.Where(l => l.Status == LoanStatus.Approved).AnyAsync()
                     ? await db.LoanRequests.Where(l => l.Status == LoanStatus.Approved).SumAsync(l => l.Amount) : 0;

        loaded = true;
        _ = AnimateNumbers(); // Start C# animation thread
    }

    private async Task AnimateNumbers()
    {
        int steps = 40; // Number of increments
        for (int i = 1; i <= steps; i++)
        {
            if (isDisposed) return;

            decimal progress = (decimal)i / steps;

            dUsers = (int)(totalUsers * progress);
            dCurrencies = (int)(currencyCount * progress);
            dStocks = (int)(stockVariety * progress);
            dTrades = (int)(totalTransactions * progress);
            dLogins = (int)(loginActivities * progress);
            dLoanCount = (int)(loanCount * progress);
            dInvestments = (int)(investmentCount * progress);

            dBalance = totalBalance * progress;
            dMarketValue = totalMarketValue * progress;
            dLoans = totalLoans * progress;

            StateHasChanged();
            await Task.Delay(15); // Speed of the count
        }
    }

    public void Dispose() => isDisposed = true;
}