@page "/account"
@using BankApp.Data.Entities.Auth
@using BankApp.Data.Entities.Banking
@using BankApp.Data.Entities.Lending
@using Microsoft.AspNetCore.Components.Authorization
@using BankApp.Services
@using BlazorApp.Components.Elements
@using System.Globalization
@rendermode InteractiveServer

@inject NavigationManager Nav
@inject IdentityService IdentityService
@inject FinanceService FinanceService
@inject IJSRuntime JS

<Toast @ref="toast" DisplayTime="4.0" Location="Toast.DockLocation.BottomLeft" />

@* --- LEDGER MODAL --- *@
@if (showHistoryModal)
{
    <div class="modal-backdrop fade show shadow-overlay"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark border border-secondary border-opacity-25 shadow-lg overflow-hidden">
                <div class="modal-header border-bottom border-secondary border-opacity-25 py-3 bg-black">
                    <h5 class="modal-title fw-bold text-white uppercase ls-1"><i class="bi bi-clock-history text-danger me-2"></i>Account Ledger</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showHistoryModal = false"></button>
                </div>
                <div class="modal-body p-0 bg-black">
                    <div class="p-3 bg-dark border-bottom border-secondary border-opacity-25 d-flex gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-black border-secondary border-opacity-25 text-muted rounded-0"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control bg-black border-secondary border-opacity-25 text-white rounded-0 shadow-none" placeholder="Search transactions..." @bind="historySearchTerm" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-dark table-hover align-middle mb-0 border-0">
                            <thead class="bg-black sticky-top shadow-sm" style="z-index: 10;">
                                <tr class="tiny-caps text-secondary border-bottom border-secondary border-opacity-25">
                                    <th class="ps-4 py-3">Description</th>
                                    <th>Date</th>
                                    <th class="text-end pe-4">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!FilteredTransactions.Any())
                                {
                                    <tr><td colspan="3" class="text-center py-5 text-muted tiny-caps">No records found.</td></tr>
                                }
                                @foreach (var tx in FilteredTransactions)
                                {
                                    <tr class="border-secondary border-opacity-10">
                                        <td class="ps-4 py-3">
                                            <div class="fw-bold text-white">@tx.Type</div>
                                            <div class="text-secondary small">@tx.Note</div>
                                            <div class="text-danger opacity-50 font-monospace" style="font-size:0.65rem">REF: @tx.TransactionReference</div>
                                        </td>
                                        <td class="text-secondary small font-monospace">@tx.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end pe-4">
                                            <span class="fw-bold @(tx.Amount < 0 ? "text-danger" : "text-success") font-monospace">
                                                @(tx.Amount < 0 ? "-" : "+") @FormatValue(Math.Abs(tx.Amount))
                                            </span>
                                            <small class="text-muted ms-1">@tx.CurrencyType?.CurrencyCode</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="container-fluid py-5 min-vh-100">
    <div class="container fade-in">
        @if (user == null)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5">
                <div class="spinner-border text-danger mb-3" role="status"></div>
                <h6 class="text-muted tiny-caps">Decrypting Account...</h6>
            </div>
        }
        else
        {
            <div class="row g-4">
                @* --- LEFT NAVIGATION --- *@
                <div class="col-lg-3">
                    <div class="card bg-dark border-0 shadow-lg rounded-0 mb-4 border-top border-danger border-4">
                        <div class="card-body text-center pt-5 pb-4">
                            <div class="position-relative d-inline-block mb-3">
                                <div class="rounded-circle bg-black border border-danger text-danger d-flex align-items-center justify-content-center mx-auto shadow"
                                     style="width: 80px; height: 80px; font-size: 2rem; font-weight: 800;">
                                    @user.FullName[0]
                                </div>
                            </div>
                            <h5 class="fw-black text-white mb-1 uppercase tracking-tighter">@user.FullName</h5>
                            <p class="text-secondary small mb-4 font-monospace">ID: @user.Id.Substring(0, 8)</p>

                            <div class="nav flex-column nav-pills gap-1 px-2 text-start">
                                @RenderNavButton(AccountTab.Overview, "bi-grid", "Dashboard")
                                @RenderNavButton(AccountTab.Transfer, "bi-arrow-left-right", "Transfers")
                                @RenderNavButton(AccountTab.Lending, "bi-bank", "Lending")
                                @RenderNavButton(AccountTab.LoginHistory, "bi-shield-lock", "Access Logs")
                                @RenderNavButton(AccountTab.Profile, "bi-person-gear", "Settings")
                                <hr class="my-3 border-secondary border-opacity-25" />
                                @RenderNavButton(AccountTab.CloseAccount, "bi-x-circle", "Purge Account", "text-danger")
                            </div>
                        </div>
                    </div>

                    @if (user.BankAccount != null)
                    {
                        <div class="card bg-dark border-0 shadow-sm p-4 rounded-0 border-start border-danger border-4">
                            <label class="tiny-caps text-secondary mb-2 d-block">Base Protocol</label>
                            <select class="form-select bg-black border-secondary border-opacity-25 text-white rounded-0 fw-bold shadow-none tiny-caps" @onchange="HandleCurrencyChange">
                                @foreach (var curr in availableCurrencies)
                                {
                                    <option value="@curr.Id" selected="@(curr.Id == user.BankAccount.CurrencyTypeId)">
                                        @curr.CurrencyCode
                                    </option>
                                }
                            </select>
                        </div>
                    }
                </div>

                @* --- MAIN CONTENT --- *@
                <div class="col-lg-9">
                    <div class="card bg-dark border border-secondary border-opacity-10 shadow-lg rounded-0 h-100">
                        <div class="card-body p-4 p-md-5">
                            @CurrentTabContent
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900;
    }

    .tracking-tighter {
        letter-spacing: -1px;
    }

    .tiny-caps {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: 700;
    }

    .shadow-overlay {
        background-color: rgba(0,0,0,0.8);
    }

    .fade-in {
        animation: fadeIn 0.3s ease-in;
    }

    .nav-btn {
        color: #888;
        border-radius: 0;
        font-weight: 700;
        transition: 0.2s;
    }

        .nav-btn:hover {
            background-color: #1a1a1a;
            color: #fff;
        }

        .nav-btn.active {
            background-color: #dc3545;
            color: white !important;
        }

    .cursor-pointer {
        cursor: pointer;
    }

    .trade-input {
        background: #000 !important;
        border: 1px solid #333 !important;
        color: white !important;
        font-size: 0.9rem;
        border-radius: 0;
    }

        .trade-input:focus {
            border-color: #dc3545 !important;
            box-shadow: none !important;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private ApplicationUser? user;
    private List<ApplicationUser> allUsers = new();
    private List<CurrencyType> availableCurrencies = new();
    private List<LoanRequest> myLoans = new();
    private ApplicationUser? selectedRecipient;
    private Toast toast = default!;
    private string transferSearchValue = "";
    private bool isSubmitting = false;
    private LoanRequest loanRequest = new();
    private bool showHistoryModal = false;
    private string historySearchTerm = "";
    private string loginSearchTerm = "";
    private ApplicationUser editModel = new();
    private decimal transferAmount;

    private enum AccountTab { Overview, Transfer, Lending, Profile, LoginHistory, CloseAccount }
    private AccountTab ActiveTab { get; set; } = AccountTab.Overview;

    private IEnumerable<Transaction> FilteredTransactions =>
        (user?.BankAccount?.Transactions ?? new List<Transaction>())
        .Where(t => string.IsNullOrEmpty(historySearchTerm) ||
                   t.Type.ToString().Contains(historySearchTerm, StringComparison.OrdinalIgnoreCase) ||
                   (t.Note ?? "").Contains(historySearchTerm, StringComparison.OrdinalIgnoreCase) ||
                   (t.TransactionReference ?? "").Contains(historySearchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(t => t.CreatedAt);

    private IEnumerable<LoginActivity> FilteredLoginActivities =>
        (user?.LoginActivities ?? new List<LoginActivity>())
        .Where(l => string.IsNullOrEmpty(loginSearchTerm) ||
                   l.Status.ToString().Contains(loginSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                   l.IpAddress.Contains(loginSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                   (l.UserAgent ?? "").Contains(loginSearchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(l => l.LoginTime);

    protected override async Task OnInitializedAsync()
    {
        availableCurrencies = await FinanceService.GetList<CurrencyType>();
        await LoadData();
        if (user != null)
            allUsers = await IdentityService.GetAllUsersExceptAsync(user.Id);
    }

    private async Task LoadData()
    {
        user = await IdentityService.GetCurrentUserAsync();
        if (user != null)
        {
            editModel.FullName = user.FullName;
            editModel.Address = user.Address ?? new Address();
            if (loanRequest.CurrencyTypeId == 0)
                loanRequest.CurrencyTypeId = user.BankAccount?.CurrencyTypeId ?? 1;

            if (user.BankAccount != null)
            {
                // FORCE RE-FETCH LOANS SO THEY ACTUALLY SHOW UP
                myLoans = await FinanceService.GetUserLoansAsync(user.BankAccount.Id);
            }
        }
    }

    private RenderFragment CurrentTabContent => ActiveTab switch
    {
        AccountTab.Overview => RenderOverview(),
        AccountTab.Transfer => RenderTransfer(),
        AccountTab.Lending => RenderLending(),
        AccountTab.LoginHistory => RenderLoginHistory(),
        AccountTab.Profile => RenderProfile(),
        AccountTab.CloseAccount => RenderCloseAccount(),
        _ => __builder => { }
    };

    private RenderFragment RenderNavButton(AccountTab tab, string icon, string label, string extraClass = "") => __builder =>
    {
        var isActive = ActiveTab == tab;
        <button class="btn text-start border-0 py-3 px-3 w-100 d-flex align-items-center nav-btn @(isActive ? "active shadow" : "") @extraClass"
                @onclick="() => ActiveTab = tab">
            <i class="bi @icon me-3 fs-5"></i> <span class="tiny-caps">@label</span>
        </button>
    };

    private RenderFragment RenderOverview() => __builder =>
    {
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h4 class="fw-black mb-0 text-white uppercase tracking-tighter">Dashboard</h4>
            <button class="btn btn-danger px-4 rounded-0 tiny-caps" @onclick="() => ActiveTab = AccountTab.Transfer">
                <i class="bi bi-send me-2"></i> New Transfer
            </button>
        </div>

        @if (user?.BankAccount != null)
        {
            <div class="bg-danger text-white p-5 rounded-0 shadow-lg mb-5 position-relative overflow-hidden border-start border-white border-4">
                <div class="position-absolute top-0 end-0 p-4 opacity-10">
                    <i class="bi bi-shield-shaded" style="font-size: 8rem;"></i>
                </div>
                <h6 class="tiny-caps opacity-75 mb-2">Total Net Liquidity</h6>
                <h1 class="display-3 fw-black mb-0 tracking-tighter">
                    @FormatValue(user.BankAccount.Balance)
                    <span class="fs-4 fw-normal opacity-75 ms-2 font-monospace">@user.BankAccount.CurrencyType?.CurrencyCode</span>
                </h1>
                <div class="mt-4 pt-3 border-top border-white border-opacity-25 d-flex align-items-center">
                    <span class="tiny-caps opacity-75 me-3">Secure Account ID:</span>
                    <span class="fw-bold font-monospace">@user.BankAccount.AccountNumber</span>
                    <i class="bi bi-copy ms-3 cursor-pointer opacity-75" @onclick="() => CopyToClipboard(user.BankAccount.AccountNumber)"></i>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary border-opacity-25 pb-2">
                <h6 class="tiny-caps text-secondary mb-0">Recent Activity</h6>
                <button class="btn btn-link text-danger text-decoration-none p-0 tiny-caps" @onclick="() => showHistoryModal = true">Expand Ledger</button>
            </div>

            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0 border-0">
                    <tbody>
                        @if (!user.BankAccount.Transactions.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4 tiny-caps">No recent movements detected.</td></tr>
                        }
                        @foreach (var tx in (user.BankAccount.Transactions).Take(5))
                        {
                            <tr class="border-secondary border-opacity-10">
                                <td class="py-3 ps-2">
                                    <div class="fw-bold text-white uppercase" style="font-size:0.8rem">@tx.Type</div>
                                    <div class="text-secondary small">@tx.Note</div>
                                </td>
                                <td class="text-secondary small font-monospace">@tx.CreatedAt.ToString("MMM dd")</td>
                                <td class="text-end fw-bold @(tx.Amount < 0 ? "text-danger" : "text-success") pe-2 font-monospace">
                                    @(tx.Amount < 0 ? "-" : "+") @FormatValue(Math.Abs(tx.Amount))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    };

    private RenderFragment RenderLending() => __builder =>
    {
        <h4 class="fw-black mb-5 text-white uppercase tracking-tighter">Lending <span class="text-danger">Terminal</span></h4>

        <div class="row g-4">
            @* --- FORM --- *@
            <div class="col-md-5">
                <div class="bg-black p-4 rounded-0 h-100 border border-secondary border-opacity-25">
                    <h6 class="tiny-caps text-danger mb-4"><i class="bi bi-file-earmark-plus me-2"></i>Initiate Request</h6>
                    <div class="mb-4">
                        <label class="tiny-caps text-secondary mb-2">Target Units</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary border-opacity-25 text-white rounded-0">@user?.BankAccount?.CurrencyType?.CurrencyCode</span>
                            <input type="number" class="form-control trade-input fw-bold" @bind="loanRequest.Amount" min="100" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="tiny-caps text-secondary mb-2">Protocol Justification</label>
                        <textarea class="form-control trade-input" @bind="loanRequest.MessageFromCustomer" rows="4" placeholder="Reason for asset request..."></textarea>
                    </div>
                    <button class="btn btn-danger w-100 py-3 tiny-caps shadow" @onclick="HandleLoanRequest" disabled="@(isSubmitting || loanRequest.Amount < 100 || string.IsNullOrWhiteSpace(loanRequest.MessageFromCustomer))">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Transmit Application
                    </button>
                </div>
            </div>

            @* --- HISTORY --- *@
            <div class="col-md-7">
                <div class="bg-black p-4 rounded-0 h-100 border border-secondary border-opacity-25">
                    <h6 class="tiny-caps text-secondary mb-4"><i class="bi bi-list-check me-2"></i>Your Protocols</h6>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0">
                            <thead class="tiny-caps text-muted">
                                <tr>
                                    <th class="fw-medium">Date</th>
                                    <th class="fw-medium">Units</th>
                                    <th class="fw-medium">Status</th>
                                    <th class="text-end fw-medium pe-2">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!myLoans.Any())
                                {
                                    <tr><td colspan="4" class="text-center py-5 text-muted tiny-caps">No active protocols.</td></tr>
                                }
                                @foreach (var loan in myLoans)
                                {
                                    <tr class="border-secondary border-opacity-10">
                                        <td class="small text-secondary font-monospace">@loan.CreatedAt.ToString("MMM dd")</td>
                                        <td class="fw-bold text-white small">@FormatValue(loan.Amount) <small class="text-muted">@loan.CurrencyType?.CurrencyCode</small></td>
                                        <td><span class="badge rounded-0 tiny-caps @GetLoanBadgeClass(loan.Status)">@loan.Status</span></td>
                                        <td class="text-end pe-2">
                                            @if (loan.Status == LoanStatus.Open)
                                            {
                                                <button class="btn btn-sm btn-outline-danger rounded-0 tiny-caps py-1" @onclick="() => HandleDeleteLoan(loan.Id)" disabled="@isSubmitting">Abort</button>
                                            }
                                            else if (loan.Status == LoanStatus.Approved)
                                            {
                                                <button class="btn btn-sm btn-success rounded-0 tiny-caps py-1" @onclick="() => HandleRepayLoan(loan.Id)" disabled="@isSubmitting">Repay</button>
                                            }
                                            else
                                            {
                                                <i class="bi bi-lock-fill text-muted"></i>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    };

    private RenderFragment RenderLoginHistory() => __builder =>
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-black mb-0 text-white uppercase tracking-tighter">Access <span class="text-danger">Logs</span></h4>
            <div class="input-group w-50">
                <span class="input-group-text bg-black border-secondary border-opacity-25 text-muted rounded-0"><i class="bi bi-filter"></i></span>
                <input type="text" class="form-control trade-input" placeholder="Filter activities..." @bind="loginSearchTerm" @bind:event="oninput" />
            </div>
        </div>

        <div class="table-responsive bg-black border border-secondary border-opacity-25 rounded-0">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="tiny-caps text-muted">
                    <tr>
                        <th class="ps-3">Timestamp (UTC)</th>
                        <th>Origin IP</th>
                        <th>Device Signature</th>
                        <th class="text-end pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in FilteredLoginActivities)
                    {
                        <tr class="border-secondary border-opacity-10">
                            <td class="ps-3 text-secondary small font-monospace">@log.LoginTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="font-monospace text-danger small">@log.IpAddress</td>
                            <td class="text-secondary small">
                                <div class="text-truncate" style="max-width: 250px;" title="@log.UserAgent">
                                    @(string.IsNullOrEmpty(log.UserAgent) ? "Unknown" : log.UserAgent)
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <span class="badge rounded-0 tiny-caps @(log.Status == LoginStatus.Success ? "bg-success" : "bg-danger")">@log.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private RenderFragment RenderTransfer() => __builder =>
    {
        <h4 class="fw-black mb-5 text-white uppercase tracking-tighter">Data <span class="text-danger">Transfer</span></h4>
        <div class="bg-black border border-secondary border-opacity-25 p-5 rounded-0 shadow-lg mx-auto" style="max-width: 600px;">
            <div class="mb-4">
                <label class="tiny-caps text-secondary mb-2">Recipient Identity</label>
                @if (selectedRecipient == null)
                {
                    <InputAutoControl TItem="ApplicationUser" Data="allUsers" Placeholder="Search identities..."
                                      SearchSelector="@(u => u.FullName)" @bind-Value="transferSearchValue"
                                      OnItemSelected="@(u => selectedRecipient = u)">
                        <ItemTemplate Context="u"><div class="fw-bold text-white uppercase">@u.FullName</div></ItemTemplate>
                    </InputAutoControl>
                }
                else
                {
                    <div class="bg-dark border border-danger p-3 rounded-0 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold text-white uppercase ls-1">@selectedRecipient.FullName</div>
                            <div class="text-secondary small font-monospace">@selectedRecipient.Email</div>
                        </div>
                        <button class="btn btn-sm btn-outline-danger rounded-0 tiny-caps" @onclick="() => selectedRecipient = null">Change</button>
                    </div>
                }
            </div>
            <div class="mb-5">
                <label class="tiny-caps text-secondary mb-2">Transfer Units</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary border-opacity-25 text-danger fw-bold rounded-0">@user?.BankAccount?.CurrencyType?.CurrencyCode</span>
                    <input type="number" class="form-control trade-input fs-4 fw-bold py-3" @bind="transferAmount" placeholder="0.00" />
                </div>
            </div>
            <button class="btn btn-danger btn-lg w-100 rounded-0 tiny-caps fw-bold py-3 shadow" @onclick="HandleTransfer" disabled="@(isSubmitting || selectedRecipient == null || transferAmount <= 0)">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Authorize Transfer
            </button>
        </div>
    };

    private RenderFragment RenderProfile() => __builder =>
    {
        <h4 class="fw-black mb-5 text-white uppercase tracking-tighter">Security <span class="text-danger">Settings</span></h4>
        <div class="bg-black border border-secondary border-opacity-25 rounded-0 p-5 shadow-sm mb-4">
            <h6 class="tiny-caps text-danger mb-4 pb-2 border-bottom border-secondary border-opacity-25">Primary Credentials</h6>
            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <label class="tiny-caps text-secondary mb-2">Full Legal Name</label>
                    <input type="text" class="form-control trade-input" @bind="editModel.FullName" />
                </div>
                <div class="col-md-6">
                    <label class="tiny-caps text-secondary mb-2">Registry Email</label>
                    <input type="text" class="form-control trade-input text-secondary" value="@user?.Email" readonly style="border-style: dashed !important;" />
                </div>
            </div>

            <h6 class="tiny-caps text-danger mb-4 pb-2 border-bottom border-secondary border-opacity-25">Location Data</h6>
            <div class="row g-4 mb-4">
                <div class="col-md-12">
                    <label class="tiny-caps text-secondary mb-2">Street Address</label>
                    <input type="text" class="form-control trade-input" @bind="editModel.Address.Street" />
                </div>
                <div class="col-md-8">
                    <label class="tiny-caps text-secondary mb-2">City</label>
                    <input type="text" class="form-control trade-input" @bind="editModel.Address.City" />
                </div>
                <div class="col-md-4">
                    <label class="tiny-caps text-secondary mb-2">Postal Code</label>
                    <input type="text" class="form-control trade-input" @bind="editModel.Address.ZipCode" maxlength="4" />
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top border-secondary border-opacity-25">
                <a href="/login/reset" class="btn btn-outline-secondary rounded-0 tiny-caps px-4">Rekey Access</a>
                <button class="btn btn-danger px-5 py-3 rounded-0 tiny-caps shadow" @onclick="HandleUpdateProfile" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Sync Profile
                </button>
            </div>
        </div>
    };

    private RenderFragment RenderCloseAccount() => __builder =>
    {
        <div class="text-center py-5">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle mb-4 shadow" style="width: 100px; height: 100px; border: 2px solid #dc3545;">
                <i class="bi bi-exclamation-octagon" style="font-size: 3rem;"></i>
            </div>
            <h3 class="fw-black text-white uppercase tracking-tighter mb-3">Identity Purge Protocol</h3>
            <p class="text-secondary mb-5 mx-auto opacity-75" style="max-width: 450px;">Warning: This action is irreversible. All assets and encrypted logs will be permanently scrubbed from the registry.</p>
            <button class="btn btn-outline-danger btn-lg px-5 py-3 rounded-0 tiny-caps shadow" @onclick="HandleCloseProfile" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Confirm Total Purge
            </button>
        </div>
    };

    // --- LOGIC ---

    private string FormatValue(decimal val) => val.ToString("N2", new CultureInfo("en-US"));

    private string GetLoanBadgeClass(LoanStatus status) => status switch
    {
        LoanStatus.Open => "bg-secondary text-white",
        LoanStatus.UnderReview => "bg-warning text-dark",
        LoanStatus.Approved => "bg-danger text-white",
        LoanStatus.Paid => "bg-success text-white",
        LoanStatus.Denied => "bg-black text-danger border border-danger",
        _ => "bg-dark text-muted"
    };

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        toast.Show("Copied to buffer", Toast.ToastLevel.Success);
    }

    private async Task HandleTransfer()
    {
        isSubmitting = true;
        var res = await FinanceService.ExecuteTransfer(user!.Id, selectedRecipient!.Id, transferAmount);
        if (res.Success)
        {
            toast.Show("Transfer successful", Toast.ToastLevel.Success);
            await LoadData();
            transferAmount = 0;
            selectedRecipient = null;
            ActiveTab = AccountTab.Overview;
        }
        else toast.Show(res.Message, Toast.ToastLevel.Error);
        isSubmitting = false;
    }

    private async Task HandleCurrencyChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            var success = await FinanceService.UpdateAccountCurrency(user!.Id, id);
            if (success) { toast.Show("Protocol updated", Toast.ToastLevel.Success); await LoadData(); }
        }
    }

    private async Task HandleLoanRequest()
    {
        isSubmitting = true;
        loanRequest.BankAccountId = user!.BankAccount!.Id;
        var success = await FinanceService.SaveLoan(loanRequest);
        if (success)
        {
            toast.Show("Protocol transmitted", Toast.ToastLevel.Success);
            loanRequest = new LoanRequest { CurrencyTypeId = user.BankAccount.CurrencyTypeId };
            await LoadData();
        }
        else toast.Show("Transmission failed", Toast.ToastLevel.Error);
        isSubmitting = false;
    }

    private async Task HandleDeleteLoan(int loanId)
    {
        isSubmitting = true;
        var success = await FinanceService.DeleteLoanRequestAsync(loanId);
        if (success)
        {
            toast.Show("Application aborted", Toast.ToastLevel.Success);
            await LoadData();
        }
        else toast.Show("Abort failed", Toast.ToastLevel.Error);
        isSubmitting = false;
    }

    private async Task HandleRepayLoan(int loanId)
    {
        isSubmitting = true;
        var res = await FinanceService.RepayLoanAsync(loanId);
        if (res.Success)
        {
            toast.Show("Loan settled", Toast.ToastLevel.Success);
            await LoadData();
        }
        else toast.Show(res.Message, Toast.ToastLevel.Error);
        isSubmitting = false;
    }

    private async Task HandleUpdateProfile()
    {
        isSubmitting = true;
        var success = await IdentityService.UpdateUserProfileAsync(user!.Id, editModel);
        if (success)
        {
            toast.Show("Identity synced", Toast.ToastLevel.Success);
            await LoadData();
        }
        else toast.Show("Sync failed", Toast.ToastLevel.Error);
        isSubmitting = false;
    }

    private async Task HandleCloseProfile()
    {
        isSubmitting = true;
        var success = await IdentityService.DeleteAccountAsync(user!.Id);
        if (success) Nav.NavigateTo("/", forceLoad: true);
        else { toast.Show("Purge failed", Toast.ToastLevel.Error); isSubmitting = false; }
    }
}