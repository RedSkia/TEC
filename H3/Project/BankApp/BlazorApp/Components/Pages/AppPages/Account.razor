@page "/account"
@using BankApp.Data.Entities.Auth
@using BankApp.Data.Entities.Banking
@using BankApp.Data.Entities.Lending
@using Microsoft.AspNetCore.Components.Authorization
@using BankApp.Services
@using System.Security.Claims
@using BlazorApp.Components.Elements
@using System.Globalization
@rendermode InteractiveServer

@inject NavigationManager Nav
@inject IdentityService IdentityService
@inject FinanceService FinanceService

<Toast @ref="toast" DisplayTime="4.0" Location="Toast.DockLocation.BottomLeft" />

@if (showHistoryModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark border border-secondary border-opacity-25 shadow-lg rounded-0 overflow-hidden">
                <div class="modal-header border-0 py-3">
                    <h5 class="modal-title fw-bold text-white uppercase ls-1"><i class="bi bi-clock-history me-2 text-danger"></i>Transaction History</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showHistoryModal = false"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="p-3 bg-black border-bottom border-secondary border-opacity-25">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-0 text-secondary"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control bg-transparent border-0 text-white ps-0" placeholder="Filter protocols..." @bind="historySearchTerm" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-dark table-hover align-middle mb-0 border-0">
                            <thead class="bg-black sticky-top shadow-sm" style="z-index: 10;">
                                <tr class="small text-secondary text-uppercase ls-1">
                                    <th class="ps-4">Activity</th>
                                    <th>Date</th>
                                    <th class="text-end pe-4">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in FilteredTransactions)
                                {
                                    <tr class="border-secondary border-opacity-10">
                                        <td class="ps-4 py-3">
                                            <div class="fw-bold text-white">@tx.Type</div>
                                            <div class="text-secondary small">@tx.Note</div>
                                            <div class="text-danger small font-monospace" style="font-size:0.65rem">REF: @tx.TransactionReference</div>
                                        </td>
                                        <td class="text-secondary small">@tx.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                        <td class="text-end pe-4">
                                            <span class="fw-bold @(tx.Amount < 0 ? "text-danger" : "text-success")">
                                                @(tx.Amount < 0 ? "-" : "+") @FormatCurrency(Math.Abs(tx.Amount))
                                            </span>
                                            <small class="text-secondary ms-1">@tx.CurrencyType?.CurrencyCode</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-outline-secondary btn-sm px-4 rounded-0 fw-bold" @onclick="() => showHistoryModal = false">TERMINATE SESSION</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="container-fluid py-5 min-vh-100 bg-black text-white">
    <div class="container">
        @if (user == null)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5">
                <div class="spinner-border text-danger mb-3" role="status"></div>
                <h5 class="text-secondary fw-light ls-2 uppercase">Syncing Security Credentials...</h5>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-3">
                    <div class="card bg-dark border-0 shadow-lg rounded-0 overflow-hidden mb-4">
                        <div class="card-body text-center pt-5 pb-4">
                            <div class="position-relative d-inline-block mb-3">
                                <div class="rounded-circle bg-black text-danger d-flex align-items-center justify-content-center shadow"
                                     style="width: 85px; height: 85px; font-size: 2.2rem; font-weight: 700; border: 2px solid #dc3545;">
                                    @user.FullName[0]
                                </div>
                            </div>
                            <h5 class="fw-bold text-white mb-1">@user.FullName.ToUpper()</h5>
                            <p class="text-secondary small mb-3">ID: @user.Id.Substring(0, 8)...</p>

                            <div class="nav flex-column nav-pills gap-1 px-2">
                                @RenderNavButton(AccountTab.Overview, "bi-cpu", "System Overview")
                                @RenderNavButton(AccountTab.Transfer, "bi-arrow-left-right", "Data Transfer")
                                @RenderNavButton(AccountTab.Lending, "bi-safe2", "Lending Terminal")
                                @RenderNavButton(AccountTab.Profile, "bi-shield-shaded", "Security Settings")
                                <hr class="my-2 border-secondary border-opacity-25" />
                                @RenderNavButton(AccountTab.CloseAccount, "bi-trash3", "Purge Identity", "text-danger")
                            </div>
                        </div>
                    </div>

                    @if (user.BankAccount != null)
                    {
                        <div class="card bg-dark border-0 shadow-sm p-4 rounded-0 border-start border-danger border-4">
                            <label class="fw-bold small text-secondary text-uppercase mb-2 d-block ls-1">Base Protocol</label>
                            <select class="form-select bg-black border-0 text-white rounded-0 fw-bold shadow-none" @onchange="HandleCurrencyChange">
                                @foreach (var curr in availableCurrencies)
                                {
                                    <option value="@curr.Id" selected="@(curr.Id == user.BankAccount.CurrencyTypeId)">
                                        @curr.CurrencyCode.ToUpper()
                                    </option>
                                }
                            </select>
                        </div>
                    }
                </div>

                <div class="col-lg-9">
                    <div class="card bg-dark border border-secondary border-opacity-10 shadow-lg rounded-0 h-100 overflow-hidden">
                        <div class="card-body p-4 p-md-5">
                            @CurrentTabContent
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private ApplicationUser? user;
    private List<ApplicationUser> allUsers = new();
    private List<CurrencyType> availableCurrencies = new();
    private ApplicationUser? selectedRecipient;
    private Toast toast = default!;
    private string transferSearchValue = "";
    private bool isSubmitting = false;
    private LoanRequest loanRequest = new();
    private bool showHistoryModal = false;
    private string historySearchTerm = "";
    private ApplicationUser editModel = new();
    private decimal transferAmount;

    private IEnumerable<Transaction> FilteredTransactions =>
        (user?.BankAccount?.Transactions ?? new List<Transaction>())
        .Where(t => string.IsNullOrEmpty(historySearchTerm) ||
                   t.Type.ToString().Contains(historySearchTerm, StringComparison.OrdinalIgnoreCase) ||
                   (t.Note ?? "").Contains(historySearchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(t => t.CreatedAt);

    private enum AccountTab { Overview, Transfer, Lending, Profile, CloseAccount }
    private AccountTab ActiveTab { get; set; } = AccountTab.Overview;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        availableCurrencies = await FinanceService.GetList<CurrencyType>();
        if (user != null)
            allUsers = await IdentityService.GetAllUsersExceptAsync(user.Id);
    }

    private async Task LoadData()
    {
        user = await IdentityService.GetCurrentUserAsync();
        if (user != null)
        {
            // Sync the edit model to current user data
            editModel.FullName = user.FullName;
            editModel.Address = user.Address ?? new Address();

            if (loanRequest.CurrencyTypeId == 0)
                loanRequest.CurrencyTypeId = user.BankAccount?.CurrencyTypeId ?? 1;
        }
    }

    private RenderFragment CurrentTabContent => ActiveTab switch
    {
        AccountTab.Overview => RenderOverview(),
        AccountTab.Transfer => RenderTransfer(),
        AccountTab.Lending => RenderLending(),
        AccountTab.Profile => RenderProfile(),
        AccountTab.CloseAccount => RenderCloseAccount(),
        _ => __builder => { }
    };

    private RenderFragment RenderNavButton(AccountTab tab, string icon, string label, string extraClass = "") => __builder =>
    {
        var isActive = ActiveTab == tab;
        <button class="btn text-start border-0 py-3 px-3 rounded-0 @(isActive ? "bg-danger text-white shadow-sm" : "text-secondary hover-bg-dark") @extraClass"
                @onclick="() => ActiveTab = tab">
            <i class="bi @icon me-3"></i> <span class="fw-bold uppercase ls-1" style="font-size:0.75rem">@label</span>
        </button>
    };

    private RenderFragment RenderOverview() => __builder =>
    {
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h4 class="fw-bold mb-0 text-white uppercase ls-1">System <span class="text-danger">Overview</span></h4>
                <p class="text-secondary small">Access Level: Authorized User (@user?.UserName)</p>
            </div>
            <button class="btn btn-outline-danger rounded-0 px-4 fw-bold" @onclick="() => ActiveTab = AccountTab.Transfer">
                <i class="bi bi-plus-lg me-2"></i> NEW TRANSFER
            </button>
        </div>

        @if (user?.BankAccount != null)
        {
            <div class="bg-black text-white p-5 rounded-0 border border-secondary border-opacity-25 shadow-lg mb-5 position-relative overflow-hidden">
                <div class="position-absolute top-0 end-0 p-4 opacity-10">
                    <i class="bi bi-graph-up-arrow display-1"></i>
                </div>
                <small class="text-danger text-uppercase fw-bold ls-2">Net Liquidity</small>
                <h1 class="display-3 fw-bold my-3 font-monospace">
                    @FormatCurrency(user.BankAccount.Balance)
                    <span class="fs-4 fw-light opacity-50">@user.BankAccount.CurrencyType?.CurrencyCode</span>
                </h1>
                <div class="mt-4 d-flex gap-3">
                    <div class="px-3 py-1 bg-dark text-secondary small font-monospace border border-secondary border-opacity-25">ACC_ID: @user.BankAccount.AccountNumber</div>
                    <div class="px-3 py-1 bg-dark text-success small font-monospace border border-success border-opacity-25">STATUS: ENCRYPTED</div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-end mb-4">
                <h5 class="fw-bold mb-0 uppercase ls-1">Live Logs</h5>
                <button class="btn btn-sm btn-link text-danger text-decoration-none fw-bold" @onclick="() => showHistoryModal = true">ACCESS FULL LOGS</button>
            </div>

            <div class="table-responsive">
                <table class="table table-dark table-borderless align-middle">
                    <tbody>
                        @foreach (var tx in (user.BankAccount.Transactions).Take(5))
                        {
                            <tr class="border-bottom border-secondary border-opacity-10">
                                <td class="py-3">
                                    <div class="fw-bold">@tx.Type</div>
                                    <div class="text-secondary small">@tx.Note</div>
                                </td>
                                <td class="text-secondary small">@tx.CreatedAt.ToString("MMM dd")</td>
                                <td class="text-end fw-bold @(tx.Amount < 0 ? "text-danger" : "text-success")">
                                    @(tx.Amount < 0 ? "-" : "+") @FormatCurrency(Math.Abs(tx.Amount))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    };

    private RenderFragment RenderTransfer() => __builder =>
    {
        <h4 class="fw-bold mb-4 uppercase ls-1">Data <span class="text-danger">Transfer</span></h4>
        <div class="bg-black border border-secondary border-opacity-25 rounded-0 p-5 shadow-sm">
            <div class="mb-4">
                <label class="small fw-bold text-secondary text-uppercase mb-2 ls-1">Recipient Identity</label>
                @if (selectedRecipient == null)
                {
                    <InputAutoControl TItem="ApplicationUser" Data="allUsers" Placeholder="Search identities..."
                                      SearchSelector="@(u => u.FullName)" @bind-Value="transferSearchValue"
                                      OnItemSelected="@(u => selectedRecipient = u)">
                        <ItemTemplate Context="u"><div class="fw-bold">@u.FullName</div></ItemTemplate>
                    </InputAutoControl>
                }
                else
                {
                    <div class="bg-dark border border-danger border-opacity-50 d-flex justify-content-between align-items-center mb-0 p-3">
                        <div>
                            <div class="fw-bold text-white">@selectedRecipient.FullName</div>
                            <div class="small text-secondary">@selectedRecipient.Email</div>
                        </div>
                        <button class="btn btn-sm btn-outline-danger rounded-0 px-3" @onclick="() => selectedRecipient = null">CHANGE</button>
                    </div>
                }
            </div>
            <div class="mb-4">
                <label class="small fw-bold text-secondary text-uppercase mb-2 ls-1">Amount</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary border-opacity-25 text-white">@user?.BankAccount?.CurrencyType?.CurrencyCode</span>
                    <input type="number" class="form-control bg-black border-secondary border-opacity-50 text-white fw-bold shadow-none" @bind="transferAmount" placeholder="0.00" />
                </div>
            </div>
            <button class="btn btn-danger btn-lg rounded-0 fw-bold w-100 py-3 shadow" @onclick="HandleTransfer" disabled="@(isSubmitting || selectedRecipient == null || transferAmount <= 0)">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                AUTHORIZE TRANSFER
            </button>
        </div>
    };

    private RenderFragment RenderProfile() => __builder =>
    {
        <h4 class="fw-bold mb-4 uppercase ls-1">Identity <span class="text-danger">Security</span></h4>
        <div class="bg-black border border-secondary border-opacity-25 rounded-0 p-5 shadow-sm mb-4">
            <h6 class="fw-bold text-uppercase ls-2 text-danger mb-4">Credentials</h6>
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="small fw-bold text-secondary mb-2 uppercase ls-1">Full Legal Name</label>
                    <input type="text" class="form-control bg-dark border-secondary border-opacity-25 text-white rounded-0 shadow-none" @bind="editModel.FullName" />
                </div>
                <div class="col-md-6">
                    <label class="small fw-bold text-secondary mb-2 uppercase ls-1">Primary Email</label>
                    <input type="text" class="form-control bg-black border-secondary border-opacity-25 text-secondary rounded-0" value="@user?.Email" readonly />
                </div>
                <div class="col-md-12">
                    <label class="small fw-bold text-secondary mb-2 uppercase ls-1">Street Address</label>
                    <input type="text" class="form-control bg-dark border-secondary border-opacity-25 text-white rounded-0 shadow-none" @bind="editModel.Address.Street" />
                </div>
                <div class="col-md-8">
                    <label class="small fw-bold text-secondary mb-2 uppercase ls-1">City</label>
                    <input type="text" class="form-control bg-dark border-secondary border-opacity-25 text-white rounded-0 shadow-none" @bind="editModel.Address.City" />
                </div>
                <div class="col-md-4">
                    <label class="small fw-bold text-secondary mb-2 uppercase ls-1">Postal Code</label>
                    <input type="text" class="form-control bg-dark border-secondary border-opacity-25 text-white rounded-0 shadow-none" @bind="editModel.Address.ZipCode" maxlength="4" />
                </div>
                <div class="col-12 d-flex justify-content-between align-items-center mt-4">
                    <a href="/login/reset" class="btn btn-outline-secondary rounded-0 px-4 fw-bold small uppercase ls-1">REKEY PASSWORD</a>
                    <button class="btn btn-danger px-5 py-2 rounded-0 fw-bold shadow uppercase ls-1" @onclick="HandleUpdateProfile" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        SYNC CHANGES
                    </button>
                </div>
            </div>
        </div>
    };

    private RenderFragment RenderLending() => __builder =>
    {
        <h4 class="fw-bold mb-4 uppercase ls-1">Lending <span class="text-danger">Terminal</span></h4>
        <div class="bg-black border border-secondary border-opacity-25 rounded-0 p-5 shadow-sm">
            <div class="mb-4">
                <label class="small fw-bold text-secondary text-uppercase mb-2 ls-1">Requested Amount</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary border-opacity-25 text-white">@user?.BankAccount?.CurrencyType?.CurrencyCode</span>
                    <input type="number" class="form-control bg-black border-secondary border-opacity-50 text-white fw-bold shadow-none" @bind="loanRequest.Amount" />
                </div>
            </div>
            <div class="mb-4">
                <label class="small fw-bold text-secondary text-uppercase mb-2 ls-1">Purpose / Note</label>
                <textarea class="form-control bg-dark border-secondary border-opacity-25 text-white rounded-0 shadow-none" @bind="loanRequest.MessageFromCustomer" rows="3"></textarea>
            </div>
            <button class="btn btn-danger btn-lg rounded-0 fw-bold w-100 py-3 shadow" @onclick="HandleLoanRequest" disabled="@(isSubmitting || loanRequest.Amount <= 0)">
                SUBMIT FOR REVIEW
            </button>
        </div>
    };

    private RenderFragment RenderCloseAccount() => __builder =>
    {
        <div class="text-center py-5">
            <i class="bi bi-exclamation-triangle text-danger display-1 mb-4"></i>
            <h4 class="fw-bold uppercase ls-2">Identity Purge Protocol</h4>
            <p class="text-secondary mb-5">This action is irreversible. All assets and transaction logs will be permanently deleted from the registry.</p>
            <button class="btn btn-outline-danger btn-lg rounded-0 px-5 fw-bold" @onclick="HandleCloseProfile" disabled="@isSubmitting">CONFIRM PURGE</button>
        </div>
    };

    private string FormatCurrency(decimal amount) => amount.ToString("N2", new CultureInfo("en-US"));

    private async Task HandleTransfer()
    {
        isSubmitting = true;
        var res = await FinanceService.ExecuteTransfer(user!.Id, selectedRecipient!.Id, transferAmount);
        if (res.Success)
        {
            toast.Show("ENCRYPTED: Transfer Successful", Toast.ToastLevel.Success);
            await LoadData();
            transferAmount = 0;
            selectedRecipient = null;
            ActiveTab = AccountTab.Overview;
        }
        else toast.Show(res.Message, Toast.ToastLevel.Error);
        isSubmitting = false;
    }

    private async Task HandleCurrencyChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            var success = await FinanceService.UpdateAccountCurrency(user!.Id, id);
            if (success) { toast.Show("PROTOCOL SWAPPED", Toast.ToastLevel.Success); await LoadData(); }
        }
    }

    private async Task HandleLoanRequest()
    {
        isSubmitting = true;
        loanRequest.BankAccountId = user!.BankAccount!.Id;
        var success = await FinanceService.SaveLoan(loanRequest);
        if (success)
        {
            toast.Show("LOAN FILED", Toast.ToastLevel.Success);
            loanRequest = new LoanRequest { CurrencyTypeId = user.BankAccount.CurrencyTypeId };
            ActiveTab = AccountTab.Overview;
            await LoadData();
        }
        isSubmitting = false;
    }

    private async Task HandleUpdateProfile()
    {
        isSubmitting = true;
        var success = await IdentityService.UpdateUserProfileAsync(user!.Id, editModel);
        if (success)
        {
            toast.Show("IDENTITY SYNCED", Toast.ToastLevel.Success);
            await LoadData();
        }
        else toast.Show("SYNC FAILED", Toast.ToastLevel.Error);
        isSubmitting = false;
    }

    private async Task HandleCloseProfile()
    {
        isSubmitting = true;
        var success = await IdentityService.DeleteAccountAsync(user!.Id);
        if (success) Nav.NavigateTo("/", forceLoad: true);
        else { toast.Show("PURGE ERROR", Toast.ToastLevel.Error); isSubmitting = false; }
    }
}