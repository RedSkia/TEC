@page "/account"
@using BankApp.Data.Entities.Auth
@using BankApp.Data.Entities.Banking
@using BankApp.Services
@using BlazorApp.Components.Elements
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject NavigationManager Nav

@* --- COMPONENT INSTANCES --- *@
<Notification @ref="notifier"
              DisplayTime="4.0"
              Location="Notification.DockLocation.BottomLeft" />

<Modal IsVisible="showConfirmModal"
       IsLoading="isSubmitting"
       Title="Seal the Vault?"
       Message="Closing your account is permanent. This action is irreversible and will wipe all access to your records."
       ConfirmText="YES, DELETE EVERYTHING"
       IconClass="bi-shield-exclamation"
       TextColor="text-danger"
       BtnClass="btn-danger shadow"
       OnConfirm="HandleCloseAccount"
       OnCancel="() => showConfirmModal = false" />

<div class="container-fluid py-4 bg-light min-vh-100">
    <div class="container">
        @if (user == null)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5">
                <div class="spinner-border text-danger mb-3" role="status"></div>
                <h5 class="text-muted fw-light">Accessing Secure Vault...</h5>
            </div>
        }
        else
        {
            <div class="row mb-4 align-items-center">
                <div class="col-md-6">
                    <h2 class="fw-bold mb-0 text-dark">Account Management</h2>
                    <p class="text-muted mb-0">Manage your profile, security, and finances.</p>
                </div>
            </div>

            <div class="row g-4">
                @* --- TAB NAVIGATION --- *@
                <div class="col-lg-3">
                    <div class="list-group border-0 shadow-sm rounded-3 overflow-hidden">
                        <button class="list-group-item list-group-item-action border-0 py-3 @(ActiveTab == AccountTab.Overview ? "bg-dark text-white" : "")" @onclick='() => ActiveTab = AccountTab.Overview'>
                            <i class="bi bi-speedometer2 me-2"></i> Overview
                        </button>
                        <button class="list-group-item list-group-item-action border-0 py-3 @(ActiveTab == AccountTab.Profile ? "bg-dark text-white" : "")" @onclick='() => ActiveTab = AccountTab.Profile'>
                            <i class="bi bi-person-gear me-2"></i> Profile & Address
                        </button>
                        <button class="list-group-item list-group-item-action border-0 py-3 @(ActiveTab == AccountTab.Security ? "bg-dark text-white" : "")" @onclick='() => ActiveTab = AccountTab.Security'>
                            <i class="bi bi-shield-lock me-2"></i> Password & Security
                        </button>
                        <button class="list-group-item list-group-item-action border-0 py-3 text-danger @(ActiveTab == AccountTab.CloseAccount ? "bg-danger text-white" : "")" @onclick='() => ActiveTab = AccountTab.CloseAccount'>
                            <i class="bi bi-exclamation-triangle me-2"></i> Close Account
                        </button>
                    </div>
                </div>

                @* --- CONTENT AREA --- *@
                <div class="col-lg-9">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body p-4">

                            @if (ActiveTab == AccountTab.Overview)
                            {
                                <div class="bg-primary text-white p-4 rounded-3 shadow-sm mb-4">
                                    <small class="text-white-50 text-uppercase fw-bold">Total Combined Balance</small>
                                    <h1 class="display-5 fw-bold mb-3">@TotalBalance.ToString("C2")</h1>
                                    <button class="btn btn-light fw-bold px-4 rounded-pill shadow-sm" @onclick='() => Nav.NavigateTo("transfer")'>Transfer</button>
                                </div>
                            }
                            else if (ActiveTab == AccountTab.Profile)
                            {
                                <EditForm Model="user" OnValidSubmit="HandleUpdateProfile">
                                    <DataAnnotationsValidator />
                                    <h5 class="fw-bold mb-4">Update Profile Details</h5>
                                    <div class="row g-3">
                                        <div class="col-md-12">
                                            <label class="form-label small fw-bold text-muted text-uppercase">Full Name</label>
                                            <InputText @bind-Value="user.FullName" class="form-control bg-light border-0 py-2" />
                                            <ValidationMessage For="@(() => user.FullName)" class="text-danger small" />
                                        </div>

                                        @if (user.Address != null)
                                        {
                                            <div class="col-12 mt-4">
                                                <h6 class="fw-bold mb-3 border-bottom pb-2">Physical Address</h6>
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label small fw-bold text-muted text-uppercase">Street Address</label>
                                                <InputText @bind-Value="user.Address.Street" class="form-control bg-light border-0 py-2" />
                                                <ValidationMessage For="@(() => user.Address.Street)" class="text-danger small" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold text-muted text-uppercase">City</label>
                                                <InputText @bind-Value="user.Address.City" class="form-control bg-light border-0 py-2" />
                                                <ValidationMessage For="@(() => user.Address.City)" class="text-danger small" />
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label small fw-bold text-muted text-uppercase">Zip Code</label>
                                                <InputText @bind-Value="user.Address.ZipCode" class="form-control bg-light border-0 py-2" />
                                                <ValidationMessage For="@(() => user.Address.ZipCode)" class="text-danger small" />
                                            </div>
                                        }

                                        <div class="col-12 mt-4">
                                            <button type="submit" class="btn btn-dark px-4 py-2 rounded-pill fw-bold" disabled="@isSubmitting">
                                                @if (isSubmitting) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                                SAVE CHANGES
                                            </button>
                                        </div>
                                    </div>
                                </EditForm>
                            }
                            else if (ActiveTab == AccountTab.Security)
                            {
                                <h5 class="fw-bold mb-4">Security Settings</h5>
                                <div class="card bg-light border-0 p-3 mb-4 shadow-sm">
                                    <div class="d-flex align-items-center">
                                        <div class="p-3 bg-white rounded-circle me-3">
                                            <i class="bi bi-key-fill text-primary"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">Update Password</h6>
                                            <p class="text-muted small mb-0">Change your security credentials immediately.</p>
                                        </div>
                                        <NavLink href="login/reset" class="btn btn-outline-dark btn-sm ms-auto fw-bold px-3 py-2 rounded-pill">
                                            RESET PASSWORD
                                        </NavLink>
                                    </div>
                                </div>
                            }
                            else if (ActiveTab == AccountTab.CloseAccount)
                            {
                                <div class="text-center py-4">
                                    <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex p-4 mb-3">
                                        <i class="bi bi-exclamation-octagon fs-1"></i>
                                    </div>
                                    <h5 class="fw-bold">Seal the Vault?</h5>
                                    <p class="text-muted mx-auto mb-4" style="max-width: 400px;">
                                        Closing your account is permanent.
                                    </p>

                                    @if (TotalBalance > 0)
                                    {
                                        <div class="alert alert-warning border-0 small">
                                            Cannot close account with remaining balance of @TotalBalance.ToString("C2")
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-danger fw-bold px-5 py-2 rounded-pill shadow-sm" @onclick="() => showConfirmModal = true">
                                            CLOSE ACCOUNT
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private Notification notifier = default!; // Reference to the toast component
    private ApplicationUser? user;
    private bool isSubmitting = false;
    private bool showConfirmModal = false;

    private enum AccountTab { Overview, Profile, Security, CloseAccount }
    private AccountTab ActiveTab { get; set; } = AccountTab.Overview;

    private decimal TotalBalance => user?.BankAccounts?.Sum(a => a.Balance) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = await AuthService.GetCurrentApplicationUser();
            if (user != null && user.Address == null)
            {
                user.Address = new Address { UserId = user.Id };
            }
        }
        catch (Exception ex)
        {
            // Initial load error can still use notifier once it's rendered
            Console.WriteLine(ex.Message);
        }
    }

    private async Task HandleUpdateProfile()
    {
        if (user == null) return;
        isSubmitting = true;

        try
        {
            var result = await AuthService.UpdateUserProfile(user);
            if (result)
                notifier.Show("Profile updated successfully.", Notification.ToastLevel.Success);
            else
                notifier.Show("Update failed. Please check your details.", Notification.ToastLevel.Error);
        }
        catch (Exception ex)
        {
            notifier.Show($"Error: {ex.Message}", Notification.ToastLevel.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleCloseAccount()
    {
        if (user == null || TotalBalance > 0) return;
        isSubmitting = true;
        try
        {
            var result = await AuthService.CloseAccount(user.Id);
            if (result)
            {
                await AuthService.Logout();
                Nav.NavigateTo("/", true);
            }
            else
            {
                notifier.Show("Failed to close account.", Notification.ToastLevel.Error);
                showConfirmModal = false;
            }
        }
        catch (Exception ex)
        {
            notifier.Show($"Error: {ex.Message}", Notification.ToastLevel.Error);
            showConfirmModal = false;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}