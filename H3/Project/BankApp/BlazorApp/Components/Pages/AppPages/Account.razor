@attribute [Route(AppRoutes.Account)]

@rendermode InteractiveServer

@using System.Reflection
@using BlazorApp.Components.Pages.AppPages.Admin
@using BlazorApp.Components.Pages.AppPages.Officer
@using Microsoft.AspNetCore.Components.Authorization
@using SharedCore.Entities.Auth
@using SharedCore.Entities.Banking
@using SharedCore.Entities.Lending
@using SharedCore.Services

@inject AppNavigator Navigator
@inject IdentityService IdentityService
@inject FinanceService FinanceService
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>BankApp | Account Dashboard</PageTitle>

<Toast @ref="toast" DisplayTime="4.0" Location="Toast.DockLocation.BottomLeft" />

@* --- TRANSACTION HISTORY MODAL --- *@
@if (showHistoryModal)
{
    <div class="modal-backdrop fade show shadow-overlay"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-black border border-secondary border-opacity-25 shadow-lg">
                <div class="modal-header border-bottom border-secondary border-opacity-25 py-3">
                    <h5 class="modal-title fw-black text-white uppercase ls-1"><i class="bi bi-clock-history text-danger me-2"></i>Account Statement</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showHistoryModal = false"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="p-3 bg-dark border-bottom border-secondary border-opacity-25">
                        <div class="input-group">
                            <span class="input-group-text bg-black border-secondary border-opacity-25 text-muted rounded-0"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control bg-black border-secondary border-opacity-25 text-white rounded-0 shadow-none" placeholder="Search transactions..." @bind="historySearchTerm" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="table-responsive" style="max-height: 500px;">
                        <table class="table table-dark table-hover align-middle mb-0">
                            <thead>
                                <tr class="tiny-caps text-secondary border-bottom border-secondary border-opacity-25">
                                    <th class="ps-4">Description</th>
                                    <th>Date</th>
                                    <th class="text-end pe-4">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in FilteredTransactions)
                                {
                                    <tr class="border-secondary border-opacity-10">
                                        <td class="ps-4">
                                            <div class="fw-bold text-white uppercase small">@tx.Type</div>
                                            <div class="text-secondary extra-small">@tx.Note</div>
                                        </td>
                                        <td class="text-secondary small font-monospace">@tx.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td class="text-end pe-4">
                                            <span class="fw-bold @(tx.Amount < 0 ? "text-danger" : "text-success") font-monospace">
                                                @(tx.Amount < 0 ? "-" : "+") @FormatValue(Math.Abs(tx.Amount))
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="bank-shell">
    @* --- SIDEBAR --- *@
    <aside class="bank-sidebar">
        <div class="brand-section px-4 py-5 pointer" @onclick='() => Navigator.NavigateTo("/")'>
            <h4 class="fw-black text-white m-0 ls-1 uppercase">BANK<span class="text-danger">APP</span></h4>
        </div>

        @if (user != null)
        {
            <div class="user-info-box px-4 mb-4">
                <div class="d-flex align-items-center p-3 bg-dark border border-secondary border-opacity-10 rounded-1">
                    <div class="avatar-square">@user.FullName[0]</div>
                    <div class="ms-3 overflow-hidden">
                        <div class="fw-bold text-white text-truncate uppercase small">@user.FullName</div>
                        <div class="text-muted extra-small">Verified Member</div>
                    </div>
                </div>
            </div>
        }

        <nav class="bank-nav px-3 flex-grow-1 overflow-auto pb-5">

            @* 1. STANDARD USER TABS *@
            <div class="px-3 mt-2 mb-2 tiny-caps text-secondary opacity-50">Personal Vault</div>
            @RenderNavButton(AccountTab.Overview, "bi-grid-1x2", "Dashboard")
            @RenderNavButton(AccountTab.Transfer, "bi-arrow-left-right", "Transfer Money")
            @RenderNavButton(AccountTab.Lending, "bi-bank", "Loan Center")
            @RenderNavButton(AccountTab.LoginHistory, "bi-shield-check", "Login Security")
            @RenderNavButton(AccountTab.Profile, "bi-person-gear", "Profile Settings")

            @* 2. OFFICER CLEARANCE LINKS - Nu renderes de internt i siden *@
            <AuthorizeView Roles="Admin, LoanOfficer">
                <Authorized>
                    <div class="px-3 mt-4 mb-2 tiny-caps text-warning opacity-75">Officer Systems</div>
                    @RenderNavButton(AccountTab.OfficerLending, "bi-briefcase", "Loan Management", "nav-warning")
                </Authorized>
            </AuthorizeView>

            @* 3. ADMIN ROOT LINKS - Nu renderes de internt i siden *@
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <div class="px-3 mt-4 mb-2 tiny-caps text-danger opacity-75">Root Authorization</div>
                    @RenderNavButton(AccountTab.AdminMarketControl, "bi-graph-up-arrow", "Market Control", "nav-danger")
                    @RenderNavButton(AccountTab.AdminUserManagement, "bi-people", "User Management", "nav-danger")
                </Authorized>
            </AuthorizeView>

            <div class="mt-5 pt-4 border-top border-secondary border-opacity-10">
                @RenderNavButton(AccountTab.CloseAccount, "bi-x-circle", "Close Account", "nav-danger-text")
            </div>
        </nav>
    </aside>

    @* --- MAIN CONTENT --- *@
    <main class="bank-main">
        <header class="bank-header px-5 d-flex justify-content-between align-items-center">
            <h5 class="fw-black text-white uppercase ls-1 mb-0">@FormatEnumName(ActiveTab.ToString())</h5>

            @if (user?.BankAccount != null && ActiveTab == AccountTab.Overview)
            {
                <div class="d-flex align-items-center gap-3">
                    <span class="tiny-caps text-secondary">Currency:</span>
                    <select class="bank-select" @onchange="HandleCurrencyChange">
                        @foreach (var curr in availableCurrencies)
                        {
                            <option value="@curr.Id" selected="@(curr.Id == user.BankAccount.CurrencyTypeId)">@curr.CurrencyCode</option>
                        }
                    </select>
                </div>
            }
        </header>

        <div class="bank-content p-5 overflow-auto">
            @if (user == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-danger" role="status"></div>
                    <div class="tiny-caps mt-3 text-secondary">Loading Account...</div>
                </div>
            }
            else
            {
                @CurrentTabContent
            }
        </div>
    </main>
</div>

<style>
    :root {
        --bg-black: #000000;
        --bg-dark: #0d0d0d;
        --accent-red: #dc3545;
        --border-color: rgba(255, 255, 255, 0.1);
    }

    .bank-shell {
        display: flex;
        min-height: 100vh;
        color: #fff;
        font-family: 'Inter', system-ui, sans-serif;
    }

    /* Sidebar */
    .bank-sidebar {
        width: 280px;
        background: var(--bg-dark);
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        height: 100vh;
    }

    .avatar-square {
        width: 40px;
        height: 40px;
        background: var(--accent-red);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        border-radius: 4px;
    }

    .nav-btn-bank {
        width: 100%;
        border: none;
        background: transparent;
        padding: 14px 18px;
        color: #888;
        text-align: left;
        display: flex;
        align-items: center;
        font-weight: 700;
        transition: 0.2s;
        border-left: 3px solid transparent;
        margin-bottom: 4px;
        border-radius: 0 8px 8px 0;
    }

        .nav-btn-bank:hover {
            color: #fff;
            background: rgba(255,255,255,0.05);
        }

        .nav-btn-bank.active {
            color: #fff;
            background: rgba(220, 53, 69, 0.1);
            border-left-color: var(--accent-red);
        }

    .nav-warning:hover {
        color: #ffc107 !important;
    }

    .nav-danger:hover {
        color: var(--accent-red) !important;
    }

    .nav-danger-text:hover {
        color: var(--accent-red) !important;
    }

    /* Main Area */
    .bank-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        height: 100vh;
    }

    .bank-header {
        height: 80px;
        border-bottom: 1px solid var(--border-color);
        background: var(--bg-dark);
        flex-shrink: 0;
    }

    .bank-select {
        background: #000;
        color: white;
        border: 1px solid var(--border-color);
        font-weight: 700;
        padding: 6px 12px;
        font-size: 0.85rem;
        border-radius: 4px;
    }

    /* Hero */
    .hero-card {
        background: var(--bg-dark);
        border: 1px solid var(--border-color);
        border-top: 4px solid var(--accent-red);
        padding: 45px;
        border-radius: 4px;
    }

    /* Components */
    .bank-card {
        background: var(--bg-dark);
        border: 1px solid var(--border-color);
        padding: 25px;
        height: 100%;
        border-radius: 4px;
    }

    .bank-input {
        background: #000;
        border: 1px solid var(--border-color);
        color: white;
        padding: 12px;
        border-radius: 4px;
    }

        .bank-input:focus {
            border-color: var(--accent-red);
            box-shadow: none;
            outline: none;
        }

    .tiny-caps {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        font-weight: 700;
    }

    .fw-black {
        font-weight: 900;
    }

    .ls-1 {
        letter-spacing: 1px;
    }

    .extra-small {
        font-size: 11px;
    }

    .shadow-overlay {
        background: rgba(0,0,0,0.85);
        backdrop-filter: blur(4px);
    }

    .btn-bank-red {
        background: var(--accent-red);
        color: white;
        border: none;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 14px 28px;
        border-radius: 4px;
        transition: 0.2s;
    }

        .btn-bank-red:hover {
            background: #c82333;
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
        }

        .btn-bank-red:disabled {
            opacity: 0.5;
            transform: none;
            box-shadow: none;
        }

    .fade-in {
        animation: fadeIn 0.3s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private ApplicationUser? user;
    private List<ApplicationUser> allUsers = new();
    private List<CurrencyType> availableCurrencies = new();
    private List<LoanRequest> myLoans = new();
    private ApplicationUser? selectedRecipient;
    private Toast toast = default!;
    private string transferSearchValue = "";
    private bool isSubmitting = false;
    private LoanRequest loanRequest = new();
    private bool showHistoryModal = false;
    private string historySearchTerm = "";
    private string loginSearchTerm = "";
    private ApplicationUser editModel = new();
    private decimal transferAmount;

    // Fang query string-parameteren "?tab=Transfer"
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private enum AccountTab
    {
        Overview, Transfer, Lending, Profile, LoginHistory, CloseAccount,
        AdminMarketControl, AdminUserManagement, OfficerLending
    }

    private AccountTab ActiveTab { get; set; } = AccountTab.Overview;

    private IEnumerable<Transaction> FilteredTransactions =>
        (user?.BankAccount?.Transactions ?? new List<Transaction>())
        .Where(t => string.IsNullOrEmpty(historySearchTerm) ||
                    t.Type.ToString().Contains(historySearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (t.Note ?? "").Contains(historySearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (t.TransactionReference ?? "").Contains(historySearchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(t => t.CreatedAt);

    private IEnumerable<LoginActivity> FilteredLoginActivities =>
        (user?.LoginActivities ?? new List<LoginActivity>())
        .Where(l => string.IsNullOrEmpty(loginSearchTerm) ||
                    l.Status.ToString().Contains(loginSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (l.IpAddress ?? "").Contains(loginSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (l.UserAgent ?? "").Contains(loginSearchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(l => l.LoginTime);

    // Kører når komponenten modtager nye parametre (f.eks. fra URL query string)
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(TabQuery) && Enum.TryParse<AccountTab>(TabQuery, true, out var parsedTab))
        {
            ActiveTab = parsedTab;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        availableCurrencies = await FinanceService.GetList<CurrencyType>();
        await LoadData();
        if (user != null)
            allUsers = await IdentityService.GetAllUsersExceptAsync(user.Id);
    }

    private async Task LoadData()
    {
        user = await IdentityService.GetCurrentApplicationUserAsync();
        if (user != null)
        {
            editModel.FullName = user.FullName;
            editModel.Address = user.Address ?? new Address();
            if (loanRequest.CurrencyTypeId == 0)
                loanRequest.CurrencyTypeId = user.BankAccount?.CurrencyTypeId ?? 1;

            if (user.BankAccount != null)
            {
                myLoans = await FinanceService.GetUserLoansAsync(user.BankAccount.Id);
            }
        }
    }

    private string FormatEnumName(string name) =>
        System.Text.RegularExpressions.Regex.Replace(name, "([A-Z])", " $1").Trim();

    private RenderFragment CurrentTabContent => ActiveTab switch
    {
        AccountTab.Overview => RenderOverview(),
        AccountTab.Transfer => RenderTransfer(),
        AccountTab.Lending => RenderLending(),
        AccountTab.LoginHistory => RenderLoginHistory(),
        AccountTab.Profile => RenderProfile(),
        AccountTab.CloseAccount => RenderCloseAccount(),

        AccountTab.AdminMarketControl => @<MarketControl />,
        AccountTab.AdminUserManagement => @<UserManagement />,
        AccountTab.OfficerLending => @<LoanManagement />,

        _ => __builder => { }
    };

    private RenderFragment RenderNavButton(AccountTab tab, string icon, string label, string extraClass = "") => __builder =>
    {
        var isActive = ActiveTab == tab;
        <button class="nav-btn-bank @(isActive ? "active" : "") @extraClass" @onclick="() => ChangeTab(tab)">
            <i class="bi @icon me-3"></i> <span class="tiny-caps">@label</span>
        </button>
    };

    private void ChangeTab(AccountTab tab)
    {
        ActiveTab = tab;
        // Dette ændrer URL'en (så et sideoppfrisk stadig loader den samme fane)
        Nav.NavigateTo($"/account?tab={tab}", replace: true);
    }

    // ------------------------------------------------------------------------------------------------------
    // TAB RENDER FRAGMENTS
    // ------------------------------------------------------------------------------------------------------

    private RenderFragment RenderOverview() => __builder =>
    {
        @if (user?.BankAccount != null)
        {
            <div class="hero-card mb-5 fade-in">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h6 class="tiny-caps text-secondary mb-2">Available Account Balance</h6>
                        <h1 class="display-3 fw-black text-white mb-0 ls-1">
                            @FormatValue(user.BankAccount.Balance)
                            <span class="fs-4 fw-normal text-muted ms-2 font-monospace">@user.BankAccount.CurrencyType?.CurrencyCode</span>
                        </h1>
                        <div class="mt-4 d-flex align-items-center">
                            <span class="tiny-caps text-secondary me-3">Account Number:</span>
                            <span class="font-monospace text-white fw-bold">@user.BankAccount.AccountNumber</span>
                            <i class="bi bi-copy ms-3 text-danger cursor-pointer" @onclick="() => CopyToClipboard(user.BankAccount.AccountNumber)"></i>
                        </div>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                        <button class="btn-bank-red px-5" @onclick="() => ChangeTab(AccountTab.Transfer)">Transfer Funds</button>
                    </div>
                </div>
            </div>

            <div class="row g-4 fade-in">
                <div class="col-lg-7">
                    <div class="bank-card">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h6 class="tiny-caps text-white">Recent Transactions</h6>
                            <button class="btn btn-link text-danger tiny-caps text-decoration-none p-0" @onclick="() => showHistoryModal = true">Full Statement</button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-dark table-hover mb-0">
                                <tbody>
                                    @foreach (var tx in (user.BankAccount.Transactions ?? new List<Transaction>()).OrderByDescending(t => t.CreatedAt).Take(5))
                                    {
                                        <tr class="border-secondary border-opacity-10">
                                            <td class="ps-0 py-3">
                                                <div class="fw-bold text-white uppercase extra-small">@tx.Type</div>
                                                <div class="text-secondary extra-small">@tx.CreatedAt.ToString("MMM dd")</div>
                                            </td>
                                            <td class="text-end pe-0 py-3 fw-bold @(tx.Amount < 0 ? "text-danger" : "text-success") font-monospace">
                                                @(tx.Amount < 0 ? "-" : "+") @FormatValue(Math.Abs(tx.Amount))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="bank-card">
                        <h6 class="tiny-caps text-white mb-4">Account Overview</h6>
                        <div class="mb-4">
                            <div class="tiny-caps text-secondary extra-small mb-1">Approved Loans</div>
                            <div class="h3 fw-black text-danger mb-0 font-monospace">@myLoans.Count(l => l.Status == LoanStatus.Approved)</div>
                        </div>
                        <div class="mb-4">
                            <div class="tiny-caps text-secondary extra-small mb-1">Account Logins (24h)</div>
                            <div class="h3 fw-black text-white mb-0 font-monospace">@((user.LoginActivities ?? new List<LoginActivity>()).Count(l => l.LoginTime > DateTime.UtcNow.AddDays(-1)))</div>
                        </div>
                        <div class="p-3 bg-dark border border-secondary border-opacity-20 text-success tiny-caps text-center">
                            <i class="bi bi-patch-check-fill me-2"></i> Standard Security Active
                        </div>
                    </div>
                </div>
            </div>
        }
    };

    private RenderFragment RenderLending() => __builder =>
    {
        <div class="row g-4 fade-in">
            <div class="col-lg-5">
                <div class="bank-card">
                    <h6 class="tiny-caps text-danger mb-4">Apply for Loan</h6>
                    <div class="mb-4">
                        <label class="tiny-caps text-secondary mb-2">Amount Needed</label>
                        <div class="input-group">
                            <span class="input-group-text bg-black border-secondary border-opacity-25 text-danger font-monospace">@user?.BankAccount?.CurrencyType?.CurrencyCode</span>
                            <input type="number" class="form-control bank-input fw-bold" @bind="loanRequest.Amount" min="100" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="tiny-caps text-secondary mb-2">Reason for Loan</label>
                        <textarea class="form-control bank-input" @bind="loanRequest.MessageFromCustomer" rows="4" placeholder="Explain your request..."></textarea>
                    </div>
                    <button class="btn-bank-red w-100" @onclick="HandleLoanRequest"
                            disabled="@(isSubmitting || loanRequest.Amount < 100 || string.IsNullOrWhiteSpace(loanRequest.MessageFromCustomer))">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Submit Application
                    </button>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="bank-card">
                    <h6 class="tiny-caps text-white mb-4">Existing Loan Requests</h6>
                    <div class="table-responsive">
                        <table class="table table-dark align-middle">
                            <thead class="tiny-caps text-muted">
                                <tr>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var loan in myLoans)
                                {
                                    <tr class="border-secondary border-opacity-10">
                                        <td class="extra-small font-monospace">@loan.CreatedAt.ToString("MMM dd")</td>
                                        <td class="fw-bold text-white small">@FormatValue(loan.Amount) <span class="extra-small text-muted">@loan.CurrencyType?.CurrencyCode</span></td>
                                        <td><span class="badge rounded-pill @GetLoanBadgeClass(loan.Status)">@loan.Status</span></td>
                                        <td class="text-end">
                                            @if (loan.Status == LoanStatus.Open)
                                            {
                                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => HandleDeleteLoan(loan.Id)">Cancel</button>
                                            }
                                            else if (loan.Status == LoanStatus.Approved)
                                            {
                                                <button class="btn btn-sm btn-success rounded-pill fw-bold" @onclick="() => HandleRepayLoan(loan.Id)">Repay</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    };

    private RenderFragment RenderTransfer() => __builder =>
    {
        <div class="bank-card mx-auto fade-in" style="max-width: 600px;">
            <div class="text-center mb-5">
                <h4 class="fw-black text-white uppercase ls-1 mb-2">Send Money</h4>
                <p class="text-secondary tiny-caps">Transfer funds instantly to another BankApp user</p>
            </div>

            <div class="mb-4">
                <label class="tiny-caps text-secondary mb-2">Select Recipient</label>
                @if (selectedRecipient == null)
                {
                    <InputAutocomplete TItem="ApplicationUser" Data="allUsers" Placeholder="Search by name or email..."
                                       SearchSelector="@(u => u.FullName)" @bind-Value="transferSearchValue"
                                       OnItemSelected="@(u => selectedRecipient = u)">
                        <ItemTemplate Context="u">
                            <div class="d-flex align-items-center py-1">
                                <div class="avatar-square extra-small me-3" style="width:30px; height:30px">@u.FullName[0]</div>
                                <div class="fw-bold text-white extra-small uppercase">@u.FullName</div>
                            </div>
                        </ItemTemplate>
                    </InputAutocomplete>
                }
                else
                {
                    <div class="p-3 bg-dark border border-danger border-opacity-40 d-flex justify-content-between align-items-center rounded-2">
                        <div class="d-flex align-items-center">
                            <div class="avatar-square me-3">@selectedRecipient.FullName[0]</div>
                            <div>
                                <div class="fw-bold text-white uppercase small">@selectedRecipient.FullName</div>
                                <div class="extra-small text-secondary">@selectedRecipient.Email</div>
                            </div>
                        </div>
                        <button class="btn btn-link text-danger text-decoration-none tiny-caps" @onclick="() => selectedRecipient = null">Change</button>
                    </div>
                }
            </div>

            <div class="mb-5">
                <label class="tiny-caps text-secondary mb-2">Transfer Amount</label>
                <div class="input-group">
                    <span class="input-group-text bg-black border-secondary border-opacity-25 text-danger fw-bold">@user?.BankAccount?.CurrencyType?.CurrencyCode</span>
                    <input type="number" class="form-control bank-input fs-2 fw-black font-monospace" @bind="transferAmount" placeholder="0.00" />
                </div>
            </div>

            <button class="btn-bank-red w-100 py-3" @onclick="HandleTransfer"
                    disabled="@(isSubmitting || selectedRecipient == null || transferAmount <= 0)">
                @if (isSubmitting)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                Confirm Transfer
            </button>
        </div>
    };

    private RenderFragment RenderLoginHistory() => __builder =>
    {
        <div class="bank-card fade-in">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h6 class="tiny-caps text-white">Recent Security Activities</h6>
                <input type="text" class="form-control bank-input w-25 py-1 extra-small" placeholder="Filter logs..." @bind="loginSearchTerm" @bind:event="oninput" />
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead class="tiny-caps text-muted">
                        <tr>
                            <th class="ps-3">Login Time</th>
                            <th>IP Address</th>
                            <th class="text-end pe-3">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in FilteredLoginActivities)
                        {
                            <tr class="border-secondary border-opacity-10">
                                <td class="ps-3 extra-small text-secondary font-monospace">@log.LoginTime.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="font-monospace text-danger small">@log.IpAddress</td>
                                <td class="text-end pe-3">
                                    <span class="badge rounded-pill @(log.Status == LoginStatus.Success ? "bg-success" : "bg-danger")">@log.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    };

    private RenderFragment RenderProfile() => __builder =>
    {
        <div class="bank-card fade-in">
            <h6 class="tiny-caps text-danger mb-5 border-bottom border-secondary border-opacity-10 pb-3">Personal Profile Information</h6>
            <div class="row g-4 mb-5">
                <div class="col-md-6">
                    <label class="tiny-caps text-secondary mb-2">Full Name</label>
                    <input type="text" class="form-control bank-input" @bind="editModel.FullName" />
                </div>
                <div class="col-md-6">
                    <label class="tiny-caps text-secondary mb-2">Registered Email</label>
                    <input type="text" class="form-control bank-input text-secondary" value="@user?.Email" readonly />
                </div>
                <div class="col-md-12">
                    <label class="tiny-caps text-secondary mb-2">Residential Address</label>
                    <div class="row g-2">
                        <div class="col-md-6"><input type="text" class="form-control bank-input" placeholder="Street Address" @bind="editModel.Address.Street" /></div>
                        <div class="col-md-4"><input type="text" class="form-control bank-input" placeholder="City" @bind="editModel.Address.City" /></div>
                        <div class="col-md-2"><input type="text" class="form-control bank-input" placeholder="Zip" @bind="editModel.Address.ZipCode" maxlength="4" /></div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-5">
                <button class="btn btn-outline-secondary rounded-pill tiny-caps px-4 py-2" @onclick='() => Navigator.NavigateTo(AppRoutes.LoginReset)'>Change Password</button>
                <button class="btn-bank-red px-5" @onclick="HandleUpdateProfile" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Save Changes
                </button>
            </div>
        </div>
    };

    private RenderFragment RenderCloseAccount() => __builder =>
    {
        <div class="text-center py-5 fade-in mx-auto" style="max-width: 500px;">
            <div class="mb-4">
                <i class="bi bi-exclamation-circle text-danger" style="font-size: 4rem;"></i>
            </div>
            <h3 class="fw-black text-white uppercase ls-1 mb-3">Close Bank Account</h3>
            <p class="text-secondary small mb-5">Warning: Closing your account is permanent. All remaining funds must be withdrawn first, and all data will be deleted.</p>
            <button class="btn btn-outline-danger btn-lg w-100 rounded-pill tiny-caps fw-bold py-3" @onclick="HandleCloseProfile" disabled="@isSubmitting">
                Permanently Close Account
            </button>
        </div>
    };

    // --- LOGIC HELPER ---
    private string FormatValue(decimal val) => val.ToString("N2", new System.Globalization.CultureInfo("en-US"));

    private string GetLoanBadgeClass(LoanStatus status) => status switch
    {
        LoanStatus.Open => "bg-secondary text-white",
        LoanStatus.UnderReview => "bg-warning text-dark",
        LoanStatus.Approved => "bg-danger text-white",
        LoanStatus.Paid => "bg-success text-white",
        LoanStatus.Denied => "bg-black text-danger border border-danger",
        _ => "bg-dark text-muted"
    };

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        toast.Show("Copied to clipboard", Toast.ToastLevel.Success);
    }

    private async Task HandleTransfer()
    {
        isSubmitting = true;
        var res = await FinanceService.ExecuteTransfer(user!.Id, selectedRecipient!.Id, transferAmount);
        if (res.Success)
        {
            toast.Show("Transfer successful", Toast.ToastLevel.Success);
            await LoadData();
            transferAmount = 0;
            selectedRecipient = null;
            ActiveTab = AccountTab.Overview;
        }
        else toast.Show(res.Message, Toast.ToastLevel.Error);
        isSubmitting = false;
    }

    private async Task HandleCurrencyChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            var success = await FinanceService.UpdateAccountCurrency(user!.Id, id);
            if (success) { toast.Show("Currency updated", Toast.ToastLevel.Success); await LoadData(); }
        }
    }

    private async Task HandleLoanRequest()
    {
        isSubmitting = true;
        loanRequest.BankAccountId = user!.BankAccount!.Id;
        var success = await FinanceService.SaveLoan(loanRequest);
        if (success)
        {
            toast.Show("Loan application submitted", Toast.ToastLevel.Success);
            loanRequest = new LoanRequest { CurrencyTypeId = user.BankAccount.CurrencyTypeId };
            await LoadData();
        }
        else toast.Show("Request failed", Toast.ToastLevel.Error);
        isSubmitting = false;
    }

    private async Task HandleDeleteLoan(int loanId)
    {
        isSubmitting = true;
        var success = await FinanceService.DeleteLoanRequestAsync(loanId);
        if (success) { toast.Show("Application cancelled", Toast.ToastLevel.Success); await LoadData(); }
        else toast.Show("Cancellation failed", Toast.ToastLevel.Error);
        isSubmitting = false;
    }

    private async Task HandleRepayLoan(int loanId)
    {
        isSubmitting = true;
        var res = await FinanceService.RepayLoanAsync(loanId);
        if (res.Success) { toast.Show("Loan repaid successfully", Toast.ToastLevel.Success); await LoadData(); }
        else toast.Show(res.Message, Toast.ToastLevel.Error);
        isSubmitting = false;
    }

    private async Task HandleUpdateProfile()
    {
        isSubmitting = true;
        var success = await IdentityService.UpdateUserProfileAsync(user!.Id, editModel);
        if (success) { toast.Show("Profile updated", Toast.ToastLevel.Success); await LoadData(); }
        else toast.Show("Update failed", Toast.ToastLevel.Error);
        isSubmitting = false;
    }

    private async Task HandleCloseProfile()
    {
        isSubmitting = true;
        var success = await IdentityService.DeleteAccountAsync(user!.Id);
        if (success) Navigator.NavigateTo("/");
        else { toast.Show("Account closure failed", Toast.ToastLevel.Error); isSubmitting = false; }
    }
}