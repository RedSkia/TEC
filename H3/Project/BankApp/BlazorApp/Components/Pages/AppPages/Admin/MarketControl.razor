@page "/admin/market"
@using BankApp.Services
@using BankApp.Data.Entities.Market
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@inject IStockService StockService
@inject IDbContextFactory<BankApp.Data.BankAppDbContext> DbFactory
@rendermode InteractiveServer

<div class="container-fluid py-5 px-lg-5">
    @* --- HEADER --- *@
    <div class="d-flex justify-content-between align-items-start mb-5 pb-4 border-bottom border-white border-opacity-10">
        <div>
            <h1 class="display-3 fw-black text-white" style="letter-spacing: -4px;">MARKET <span class="text-danger">CORE.</span></h1>
            <p class="text-secondary text-uppercase fw-bold small" style="letter-spacing: 2px;">Manual Asset Price Override & Simulation</p>
        </div>
        <div class="text-end">
            <button @onclick="SimulateStep" disabled="@isUpdating" class="btn btn-outline-danger rounded-0 px-4 py-2 fw-black shadow-sm">
                @if (isUpdating) { <span class="spinner-border spinner-border-sm me-2"></span><span>WRITING...</span> } 
                else { <span>TRIGGER GLOBAL VOLATILITY</span> }
            </button>
        </div>
    </div>

    @* --- MARKET GRID --- *@
    <div class="row g-4">
        @foreach (var stock in stocks)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="bg-dark bg-opacity-50 border border-secondary border-opacity-25 p-4 position-relative overflow-hidden h-100" style="backdrop-filter: blur(10px);">
                    
                    @* Ticker Watermark *@
                    <div class="position-absolute top-0 end-0 p-2 opacity-10 fw-black display-6" style="pointer-events: none; font-size: 3rem; transform: rotate(-10deg);">
                        @stock.Ticker
                    </div>

                    <div class="mb-4 position-relative z-1">
                        <span class="text-danger fw-black small text-uppercase" style="letter-spacing: 1px;">@stock.Name</span>
                        <div class="h2 fw-black text-white mt-1">$@stock.CurrentPrice.ToString("N2")</div>
                    </div>

                    <div class="position-relative z-1">
                        <label class="text-secondary small fw-bold mb-2 text-uppercase" style="font-size: 0.6rem; letter-spacing: 1px;">Manual Override</label>
                        <div class="input-group">
                            <span class="input-group-text bg-black border-secondary border-opacity-50 text-secondary border-end-0 rounded-0">$</span>
                            <input type="number" step="0.01"
                                   class="form-control bg-black border-secondary border-opacity-50 text-white fw-bold border-start-0 border-end-0 rounded-0 shadow-none"
                                   @bind="manipulateValues[stock.Id]" />
                            <button class="btn btn-danger rounded-0 px-3 fw-bold" @onclick="() => SetPrice(stock.Id)" disabled="@isUpdating">
                                SET
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter] public Notification? Toast { get; set; }

    private List<Stock> stocks = new();
    private Dictionary<int, decimal> manipulateValues = new();
    private bool isUpdating = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        stocks = await db.Stocks.OrderBy(s => s.Ticker).ToListAsync();
        foreach (var s in stocks)
        {
            manipulateValues[s.Id] = s.CurrentPrice;
        }
    }

    private async Task SimulateStep()
    {
        if (isUpdating) return;
        isUpdating = true;
        
        try {
            await StockService.UpdateMarketPricesAsync();
            await LoadData();
            Toast?.Show("MARKET VOLATILITY APPLIED", Notification.ToastLevel.Warning);
        }
        catch (Exception ex) {
            Toast?.Show("CORE SYNC FAILURE", Notification.ToastLevel.Error);
            Console.WriteLine(ex.Message);
        }
        finally {
            isUpdating = false;
        }
    }

    private async Task SetPrice(int id)
    {
        if (isUpdating) return;
        isUpdating = true;

        try {
            var ticker = stocks.FirstOrDefault(x => x.Id == id)?.Ticker ?? "ASSET";
            await StockService.AdminAdjustPriceAsync(id, manipulateValues[id]);
            await LoadData();
            Toast?.Show($"{ticker} OVERRIDDEN", Notification.ToastLevel.Success);
        }
        catch (Exception ex) {
            Toast?.Show("ADJUSTMENT FAILED", Notification.ToastLevel.Error);
            Console.WriteLine(ex.Message);
        }
        finally {
            isUpdating = false;
        }
    }
}

<style>
    .fw-black { font-weight: 900 !important; }
    
    .form-control:focus {
        background-color: #000 !important;
        border-color: #dc3545 !important;
        color: white;
        box-shadow: none;
    }

    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
        -webkit-appearance: none; 
        margin: 0; 
    }
</style>