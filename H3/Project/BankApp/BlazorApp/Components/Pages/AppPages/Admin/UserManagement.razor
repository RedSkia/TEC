@attribute [Route(AppRoutes.AdminUserManagement)]

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SharedCore.Data
@using SharedCore.Entities.Auth
@using SharedCore.Services

@inject FinanceService Finance
@inject IdentityService Identity
@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<BankAppDbContext> DbFactory
@inject AppNavigator Navigator

<AuthorizeView Roles="Admin">
    <Authorized>
        <div class="admin-wrapper min-vh-100 text-white pb-5 position-relative">

            @* Subtil baggrunds-effekt for at få glasset til at se bedre ud *@
            <div class="position-absolute top-0 start-50 translate-middle-x bg-danger rounded-circle blur-bg" style="width: 600px; height: 300px; opacity: 0.05; pointer-events: none;"></div>

            <div class="container fade-in position-relative" style="z-index: 1;">

                @if (selectedUser == null && !isCreating)
                {
                    @* ========================================== *@
                    @* VIEW 1: USER REGISTRY (THE GRID)           *@
                    @* ========================================== *@
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-end mb-4 gap-3">
                        <div>
                            <h1 class="display-5 fw-bolder mb-1 tracking-tight">User Management</h1>
                            <div class="d-flex align-items-center gap-2 text-secondary small">
                                <i class="bi bi-people-fill text-danger"></i>
                                <span>Total Active Users: <strong class="text-white">@allUsers.Count</strong></span>
                            </div>
                        </div>
                        <button class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm custom-hover-lift" @onclick="() => isCreating = true">
                            <i class="bi bi-person-plus-fill me-2"></i> Create New User
                        </button>
                    </div>

                    <div class="glass-panel p-2 p-md-4 mb-4">
                        <div class="mb-4 position-relative">
                            <i class="bi bi-search text-secondary position-absolute" style="top: 50%; left: 1.2rem; transform: translateY(-50%);"></i>
                            <input type="text" class="form-control glass-input rounded-pill py-3 shadow-none"
                                   placeholder="Search by name, username, or account number..." @bind="searchQuery" @bind:event="oninput" style="padding-left: 3rem;" />
                        </div>

                        <div class="table-responsive">
                            <table class="table table-borderless text-white align-middle mb-0 custom-table">
                                <thead class="border-bottom border-white border-opacity-10">
                                    <tr class="text-secondary small text-uppercase" style="letter-spacing: 1px;">
                                        <th class="ps-3 py-3 fw-semibold">User Details</th>
                                        <th class="py-3 fw-semibold">Role</th>
                                        <th class="text-end py-3 fw-semibold">Vault Balance</th>
                                        <th class="text-end pe-3 py-3 fw-semibold">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in FilteredUsers)
                                    {
                                        <tr class="border-bottom border-white border-opacity-5 cursor-pointer custom-hover-bg transition-base" @onclick="() => LoadDeepIdentity(u.Id)">
                                            <td class="ps-3 py-3">
                                                <div class="fw-bold fs-6 text-white mb-1">@u.FullName</div>
                                                <div class="text-secondary small">@u.UserName</div>
                                            </td>
                                            <td>
                                                <span class="badge rounded-pill px-3 py-2 fw-semibold @GetRoleBadgeColor(userRoles.GetValueOrDefault(u.Id, "Customer"))">
                                                    @userRoles.GetValueOrDefault(u.Id, "Customer")
                                                </span>
                                            </td>
                                            <td class="text-end fw-semibold @(u.BankAccount?.Balance < 0 ? "text-danger" : "text-white")">
                                                $@(u.BankAccount?.Balance.ToString("N2") ?? "0.00")
                                            </td>
                                            <td class="text-end pe-3">
                                                <div class="btn btn-sm btn-glass-light rounded-circle" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                                                    <i class="bi bi-chevron-right"></i>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else if (isCreating)
                {
                    @* ========================================== *@
                    @* VIEW 2: CREATE NEW USER                    *@
                    @* ========================================== *@
                    <button class="btn btn-link text-secondary text-decoration-none p-0 mb-4 hover-white transition-base fw-semibold" @onclick="CloseViews">
                        <i class="bi bi-arrow-left me-2"></i> Back to Directory
                    </button>

                    <h2 class="display-6 fw-bolder mb-4 tracking-tight">Create New User</h2>

                    <div class="row">
                        <div class="col-lg-5">
                            <div class="glass-panel p-4 p-md-5">
                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-semibold">Full Legal Name</label>
                                    <input type="text" class="form-control glass-input rounded-3" @bind="newFullName" placeholder="e.g. Jane Doe" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-secondary small fw-semibold">System Username</label>
                                    <input type="text" class="form-control glass-input rounded-3" @bind="newUsername" placeholder="e.g. janedoe99" />
                                </div>
                                <div class="mb-4">
                                    <label class="form-label text-secondary small fw-semibold">Initial Password</label>
                                    <input type="password" class="form-control glass-input rounded-3" @bind="newPassword" placeholder="••••••••" />
                                </div>
                                <div class="mb-5">
                                    <label class="form-label text-secondary small fw-semibold">Assign Role</label>
                                    <select class="form-select glass-input rounded-3" @bind="newRole">
                                        <option value="@RoleType.Customer">Customer</option>
                                        <option value="@RoleType.LoanOfficer">Loan Officer</option>
                                        <option value="@RoleType.Admin">Administrator</option>
                                    </select>
                                </div>

                                <button class="btn btn-danger w-100 rounded-pill py-3 fw-bold shadow-sm custom-hover-lift" @onclick="ExecuteCreate">
                                    Create Account
                                </button>
                            </div>
                        </div>
                    </div>
                }
                else if (selectedUser != null)
                {
                    @* ========================================== *@
                    @* VIEW 3: USER DETAILS & OVERRIDE            *@
                    @* ========================================== *@
                    <button class="btn btn-link text-secondary text-decoration-none p-0 mb-4 hover-white transition-base fw-semibold" @onclick="CloseViews">
                        <i class="bi bi-arrow-left me-2"></i> Back to Directory
                    </button>

                    <div class="glass-panel p-4 mb-5 d-flex flex-column flex-md-row align-items-md-center gap-4">
                        <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center fw-bolder fs-2 shadow" style="width: 80px; height: 80px; flex-shrink: 0;">
                            @selectedUser.FullName[0]
                        </div>
                        <div>
                            <h2 class="display-6 fw-bolder mb-1 tracking-tight">@selectedUser.FullName</h2>
                            <div class="d-flex flex-wrap gap-3 align-items-center">
                                <span class="badge rounded-pill px-3 py-2 fw-semibold @GetRoleBadgeColor(selectedRoleChange)">
                                    @selectedRoleChange
                                </span>
                                <span class="text-secondary small">ID: @selectedUser.Id</span>
                            </div>
                        </div>
                        <div class="ms-md-auto text-md-end mt-3 mt-md-0 glass-panel-inner p-3 rounded-4">
                            <span class="text-secondary small d-block mb-1 fw-semibold">Bank Account Number</span>
                            <span class="fs-4 fw-bold text-white"><i class="bi bi-safe2 text-danger me-2"></i>@selectedUser.BankAccount?.AccountNumber</span>
                        </div>
                    </div>

                    <div class="row g-4">
                        @* 1. PERSONAL DATA (UPDATE PROFILE) *@
                        <div class="col-lg-4">
                            <div class="glass-panel p-4 h-100 d-flex flex-column">
                                <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-white border-opacity-10">
                                    <div class="bg-white bg-opacity-10 p-2 rounded-3 me-3"><i class="bi bi-person-vcard text-white fs-5"></i></div>
                                    <h5 class="fw-bold mb-0">Profile Information</h5>
                                </div>

                                <label class="form-label text-secondary small fw-semibold">Full Name</label>
                                <input type="text" class="form-control glass-input rounded-3 mb-3" @bind="selectedUser.FullName" />

                                <label class="form-label text-secondary small fw-semibold">Street Address</label>
                                <input type="text" class="form-control glass-input rounded-3 mb-3" @bind="editStreet" />

                                <div class="row g-2 mb-4">
                                    <div class="col-8">
                                        <label class="form-label text-secondary small fw-semibold">City</label>
                                        <input type="text" class="form-control glass-input rounded-3" @bind="editCity" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label text-secondary small fw-semibold">Zip</label>
                                        <input type="text" class="form-control glass-input rounded-3" @bind="editZip" />
                                    </div>
                                </div>

                                <button class="btn btn-glass-light w-100 rounded-pill py-2 fw-bold mt-auto" @onclick="ExecuteProfileUpdate">Save Changes</button>
                            </div>
                        </div>

                        @* 2. FINANCIAL OVERRIDE (MANIPULATE BALANCE) *@
                        <div class="col-lg-4">
                            <div class="glass-panel p-4 h-100 d-flex flex-column" style="background: rgba(25, 135, 84, 0.03);">
                                <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-white border-opacity-10">
                                    <div class="bg-success bg-opacity-10 p-2 rounded-3 me-3"><i class="bi bi-cash-stack text-success fs-5"></i></div>
                                    <h5 class="fw-bold mb-0 text-success">Financial Overview</h5>
                                </div>

                                <div class="glass-panel-inner p-4 rounded-4 mb-4 text-center">
                                    <span class="text-secondary small d-block mb-1 fw-semibold">Current Balance</span>
                                    <span class="fs-2 fw-bolder @(selectedUser.BankAccount?.Balance < 0 ? "text-danger" : "text-white")">
                                        $@(selectedUser.BankAccount?.Balance.ToString("N2") ?? "0.00")
                                    </span>
                                </div>

                                <label class="form-label text-secondary small fw-semibold">Adjust Amount (Use - to deduct)</label>
                                <input type="number" class="form-control glass-input rounded-3 mb-3" @bind="adjustAmount" />

                                <label class="form-label text-secondary small fw-semibold">Reason for Adjustment</label>
                                <input type="text" class="form-control glass-input rounded-3 mb-4" @bind="adjustReason" />

                                <button class="btn btn-success w-100 rounded-pill py-2 fw-bold mt-auto shadow-sm" @onclick="ExecuteCapitalAdjustment">Apply Adjustment</button>
                            </div>
                        </div>

                        @* 3. SECURITY CLEARANCE & TERMINATION *@
                        <div class="col-lg-4">
                            <div class="glass-panel p-4 h-100 d-flex flex-column" style="background: rgba(220, 53, 69, 0.03);">
                                <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-white border-opacity-10">
                                    <div class="bg-danger bg-opacity-10 p-2 rounded-3 me-3"><i class="bi bi-shield-lock text-danger fs-5"></i></div>
                                    <h5 class="fw-bold mb-0 text-danger">Security & Access</h5>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label text-secondary small fw-semibold">User Role</label>
                                    <div class="input-group">
                                        <select class="form-select glass-input rounded-start-pill" @bind="selectedRoleChange">
                                            <option value="Customer">Customer</option>
                                            <option value="LoanOfficer">Loan Officer</option>
                                            <option value="Admin">Administrator</option>
                                        </select>
                                        <button class="btn btn-outline-danger rounded-end-pill fw-bold px-4" @onclick="ExecuteRoleChange">Save</button>
                                    </div>
                                </div>

                                <div class="mb-auto">
                                    <label class="form-label text-secondary small fw-semibold">Reset Password</label>
                                    <div class="input-group mb-2">
                                        <input type="password" class="form-control glass-input rounded-start-pill" placeholder="New Password" @bind="forcePassword" />
                                        <button class="btn btn-outline-danger rounded-end-pill fw-bold px-4" @onclick="ExecutePasswordReset">Reset</button>
                                    </div>
                                </div>

                                <div class="mt-4 pt-4 border-top border-white border-opacity-10">
                                    <button class="btn btn-danger w-100 rounded-pill py-3 fw-bold custom-hover-lift" @onclick="ExecuteTermination">
                                        Delete Account
                                    </button>
                                </div>
                            </div>
                        </div>

                        @* 4. DEEP DATA OVERVIEW (STATISTICS) *@
                        <div class="col-12 mt-2">
                            <div class="row g-4">
                                <div class="col-md-4">
                                    <div class="glass-panel p-4 d-flex align-items-center justify-content-between custom-hover-lift transition-base">
                                        <div>
                                            <span class="text-secondary small fw-semibold d-block mb-1">Active Loans</span>
                                            <span class="fw-bolder fs-3 text-white">@deepLoanCount</span>
                                        </div>
                                        <div class="bg-white bg-opacity-10 p-3 rounded-circle"><i class="bi bi-file-earmark-text text-white fs-4"></i></div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glass-panel p-4 d-flex align-items-center justify-content-between custom-hover-lift transition-base">
                                        <div>
                                            <span class="text-secondary small fw-semibold d-block mb-1">Investments</span>
                                            <span class="fw-bolder fs-3 text-white">@deepInvestCount</span>
                                        </div>
                                        <div class="bg-white bg-opacity-10 p-3 rounded-circle"><i class="bi bi-graph-up-arrow text-white fs-4"></i></div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="glass-panel p-4 d-flex align-items-center justify-content-between custom-hover-lift transition-base">
                                        <div>
                                            <span class="text-secondary small fw-semibold d-block mb-1">Transactions</span>
                                            <span class="fw-bolder fs-3 text-white">@deepTransCount</span>
                                        </div>
                                        <div class="bg-white bg-opacity-10 p-3 rounded-circle"><i class="bi bi-receipt text-white fs-4"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                }

            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="min-vh-100 bg-darker d-flex align-items-center justify-content-center text-center">
            <div class="glass-panel p-5 rounded-4 max-w-sm">
                <i class="bi bi-shield-lock text-danger display-1 mb-3"></i>
                <h2 class="fw-bolder text-white mb-2">Access Denied</h2>
                <p class="text-secondary mb-0">You do not have permission to view this page.</p>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<style>
    /* Base Styles */
    .bg-darker {
        background-color: #050505;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .transition-base {
        transition: all 0.25s ease;
    }

    /* Glassmorphism Core */
    .glass-header {
        background: rgba(5, 5, 5, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .glass-panel {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1.25rem;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
    }

    .glass-panel-inner {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* Glass Inputs */
    .glass-input {
        background-color: rgba(255, 255, 255, 0.04) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #fff !important;
        transition: all 0.2s ease;
    }

        .glass-input:focus {
            background-color: rgba(255, 255, 255, 0.08) !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
            box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.05) !important;
        }

        .glass-input::placeholder {
            color: rgba(255, 255, 255, 0.3) !important;
        }

    /* Glass Buttons */
    .btn-glass-light {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
    }

        .btn-glass-light:hover {
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
        }

    .btn-glass-danger {
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid rgba(220, 53, 69, 0.2);
        color: #ff6b7b;
    }

        .btn-glass-danger:hover {
            background: #dc3545;
            color: #fff;
        }

    /* Hover Effects */
    .hover-white:hover {
        color: #fff !important;
    }

    .custom-hover-bg:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    .custom-hover-lift:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.3) !important;
    }

    /* Table Adjustments */
    .custom-table th {
        color: #adb5bd;
        font-weight: 600;
    }

    .custom-table td {
        vertical-align: middle;
    }

    /* Background Blur Blob */
    .blur-bg {
        filter: blur(100px);
    }

    /* Animations */
    .fade-in {
        animation: fadeIn 0.4s ease-out forwards;
    }
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    [CascadingParameter] public Toast? Toast { get; set; }

    private List<ApplicationUser> allUsers = new();
    private Dictionary<string, string> userRoles = new();
    private string searchQuery = "";

    // View State
    private ApplicationUser? selectedUser;
    private bool isCreating = false;

    // Create Vars
    private string newFullName = "";
    private string newUsername = "";
    private string newPassword = "";
    private RoleType newRole = RoleType.Customer;

    // Deep Edit Vars
    private string editStreet = "";
    private string editCity = "";
    private string editZip = "";
    private decimal adjustAmount;
    private string adjustReason = "Admin Adjustment";
    private string selectedRoleChange = "";
    private string forcePassword = "";

    // Deep Data Metrics
    private int deepLoanCount = 0;
    private int deepInvestCount = 0;
    private int deepTransCount = 0;

    private IEnumerable<ApplicationUser> FilteredUsers =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? allUsers
            : allUsers.Where(u => u.FullName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                  u.UserName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                  (u.BankAccount?.AccountNumber.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadMatrix();
    }

    private async Task LoadMatrix()
    {
        using var db = await DbFactory.CreateDbContextAsync();

        // Fetch all users with basic bank info for the grid
        allUsers = await db.Users
            .Include(u => u.BankAccount)
            .AsNoTracking()
            .ToListAsync();

        userRoles.Clear();
        foreach (var u in allUsers)
        {
            var roles = await UserManager.GetRolesAsync(u);
            userRoles[u.Id] = roles.FirstOrDefault() ?? "Customer";
        }
    }

    private async Task LoadDeepIdentity(string userId)
    {
        // Fetch deep relational data specifically for the selected user
        using var db = await DbFactory.CreateDbContextAsync();
        selectedUser = await db.Users
            .Include(u => u.Address)
            .Include(u => u.BankAccount)
                .ThenInclude(b => b.Transactions)
            .Include(u => u.BankAccount)
                .ThenInclude(b => b.LoanRequests)
            .Include(u => u.BankAccount)
                .ThenInclude(b => b.Investments)
            .FirstOrDefaultAsync(u => u.Id == userId);

        if (selectedUser == null) return;

        // Setup Edit Fields
        editStreet = selectedUser.Address?.Street ?? "";
        editCity = selectedUser.Address?.City ?? "";
        editZip = selectedUser.Address?.ZipCode ?? "";

        selectedRoleChange = userRoles.GetValueOrDefault(selectedUser.Id, "Customer");
        adjustAmount = 0;
        adjustReason = "Admin Adjustment";
        forcePassword = "";
        isCreating = false;

        // Populate Data Counts
        deepLoanCount = selectedUser.BankAccount?.LoanRequests.Count ?? 0;
        deepInvestCount = selectedUser.BankAccount?.Investments.Count ?? 0;
        deepTransCount = selectedUser.BankAccount?.Transactions.Count ?? 0;
    }

    private void CloseViews()
    {
        selectedUser = null;
        isCreating = false;
    }

    // ==========================================
    // EXECUTION PROTOCOLS
    // ==========================================

    private async Task ExecuteCreate()
    {
        if (string.IsNullOrWhiteSpace(newUsername) || string.IsNullOrWhiteSpace(newPassword))
        {
            Toast?.Show("Credentials required.", Toast.ToastLevel.Warning);
            return;
        }

        var newUser = new ApplicationUser
        {
            UserName = newUsername,
            Email = $"{newUsername}@bank.com",
            FullName = newFullName,
            EmailConfirmed = true
        };

        var result = await Identity.Register(newUser, newPassword, newRole);

        if (result == null)
        {
            await LoadMatrix();
            CloseViews();
            Toast?.Show("User successfully created.", Toast.ToastLevel.Success);
            newUsername = newFullName = newPassword = "";
        }
        else
        {
            Toast?.Show(string.Join(" | ", result), Toast.ToastLevel.Error);
        }
    }

    private async Task ExecuteProfileUpdate()
    {
        if (selectedUser == null) return;

        var updatedData = new ApplicationUser
        {
            FullName = selectedUser.FullName,
            Address = new Address { Street = editStreet, City = editCity, ZipCode = editZip }
        };

        var success = await Identity.UpdateUserProfileAsync(selectedUser.Id, updatedData);
        if (success)
        {
            await LoadMatrix(); // Refresh grid data
            Toast?.Show("Profile updated successfully.", Toast.ToastLevel.Success);
        }
    }

    private async Task ExecuteCapitalAdjustment()
    {
        if (selectedUser == null || adjustAmount == 0) return;

        var success = await Finance.AdjustUserBalance(selectedUser.Id, adjustAmount, adjustReason);
        if (success)
        {
            if (selectedUser.BankAccount != null) selectedUser.BankAccount.Balance += adjustAmount;

            // Re-fetch to update transaction count visually
            await LoadDeepIdentity(selectedUser.Id);
            adjustAmount = 0;
            Toast?.Show("Balance adjusted successfully.", Toast.ToastLevel.Success);
        }
    }

    private async Task ExecuteRoleChange()
    {
        if (selectedUser == null) return;

        // --- FIX FOR EF CORE TRACKING ISSUE ---
        var trackedUser = await UserManager.FindByIdAsync(selectedUser.Id);

        if (trackedUser == null)
        {
            Toast?.Show("User not found.", Toast.ToastLevel.Error);
            return;
        }

        var currentRoles = await UserManager.GetRolesAsync(trackedUser);
        await UserManager.RemoveFromRolesAsync(trackedUser, currentRoles);
        await UserManager.AddToRoleAsync(trackedUser, selectedRoleChange);

        userRoles[selectedUser.Id] = selectedRoleChange;
        Toast?.Show("Role updated successfully.", Toast.ToastLevel.Success);
    }

    private async Task ExecutePasswordReset()
    {
        if (selectedUser == null || string.IsNullOrWhiteSpace(forcePassword)) return;

        var result = await Identity.ResetPassword(selectedUser.UserName, forcePassword);
        if (result.Succeeded)
        {
            forcePassword = "";
            Toast?.Show("Password reset successfully.", Toast.ToastLevel.Success);
        }
        else
        {
            Toast?.Show("Password too weak.", Toast.ToastLevel.Error);
        }
    }

    private async Task ExecuteTermination()
    {
        if (selectedUser == null) return;

        // Safety check to prevent Admin from deleting themselves
        var currentAdmin = await Identity.GetCurrentApplicationUserAsync();
        if (currentAdmin?.Id == selectedUser.Id)
        {
            Toast?.Show("Cannot delete your own admin account.", Toast.ToastLevel.Error);
            return;
        }

        var success = await Identity.DeleteAccountAsync(selectedUser.Id);
        if (success)
        {
            await LoadMatrix();
            CloseViews();
            Toast?.Show("User account deleted.", Toast.ToastLevel.Success);
        }
    }

    private string GetRoleBadgeColor(string role) => role.ToUpper() switch
    {
        "ADMIN" => "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25",
        "LOANOFFICER" => "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25",
        _ => "bg-white bg-opacity-10 text-light border border-white border-opacity-10"
    };
}