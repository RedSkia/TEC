@attribute [Route(AppRoutes.Dashboard)]

@rendermode InteractiveServer

@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using SharedCore.Data
@using SharedCore.Entities.Banking

@inject IIdentityService IdentityService
@inject IFinanceService FinanceService
@inject NavigationManager Nav
@inject IDbContextFactory<BankAppDbContext> DbFactory

<div class="dashboard-wrapper min-vh-100 position-relative pb-5">
    @* Baggrunds-effekt for Glassmorphism *@
    <div class="position-absolute top-0 start-0 bg-danger rounded-circle blur-bg" style="width: 400px; height: 400px; opacity: 0.04; pointer-events: none;"></div>
    <div class="position-absolute bottom-0 end-0 bg-danger rounded-circle blur-bg" style="width: 600px; height: 600px; opacity: 0.03; pointer-events: none;"></div>

    <div class="container py-5 position-relative" style="z-index: 1;">

        @if (user == null)
        {
            <div class="d-flex flex-column justify-content-center align-items-center" style="height: 70vh;">
                <div class="spinner-border text-danger mb-4" style="width: 3rem; height: 3rem;" role="status"></div>
                <h5 class="fw-bold text-white tracking-widest text-uppercase fade-in">Decrypting Identity...</h5>
                <p class="text-secondary small font-monospace fade-in" style="animation-delay: 0.2s;">Establishing secure connection to RedSkia Network</p>
            </div>
        }
        else
        {
            @* --- HEADER: GREETING & STATUS --- *@
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 fade-in">
                <div>
                    <h5 class="text-danger fw-bold tracking-widest text-uppercase mb-1">@GetGreeting()</h5>
                    <h1 class="display-4 fw-black text-white mb-0 tracking-tighter text-uppercase">
                        @user.FullName<span class="text-danger">.</span>
                    </h1>
                    <div class="d-flex align-items-center gap-3 mt-3">
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2 tiny-caps">
                            <i class="bi bi-shield-check me-1"></i> SECURE UPLINK
                        </span>
                        <span class="text-secondary tiny-caps font-monospace">
                            ID: @user.Id.Substring(0, 8)
                        </span>
                    </div>
                </div>
                <div class="text-md-end mt-4 mt-md-0 d-none d-sm-block">
                    <div class="text-secondary tiny-caps mb-1">System Time (UTC)</div>
                    <div class="fw-bold font-monospace text-white fs-5 bg-black bg-opacity-50 px-3 py-2 rounded-3 border border-secondary border-opacity-25">
                        @DateTime.UtcNow.ToString("HH:mm:ss")
                        <span class="text-danger"> | </span>
                        @DateTime.UtcNow.ToString("dd.MM.yyyy")
                    </div>
                </div>
            </div>

            @* --- HERO METRICS: NET WORTH --- *@
            <div class="glass-panel p-4 p-md-5 mb-5 fade-in" style="animation-delay: 0.1s;">
                <div class="row align-items-center">
                    <div class="col-lg-5 mb-4 mb-lg-0 border-end border-secondary border-opacity-10">
                        <div class="tiny-caps text-secondary mb-2 d-flex align-items-center gap-2">
                            <i class="bi bi-globe text-danger"></i> Total Net Worth
                        </div>
                        <h1 class="display-3 fw-black tracking-tighter text-white mb-0">
                            @FormatValue(netWorth)
                        </h1>
                        <div class="text-secondary fw-bold mt-1">@user.BankAccount?.CurrencyType?.CurrencyCode</div>
                    </div>
                    <div class="col-lg-7">
                        <div class="row g-3 px-lg-4">
                            <div class="col-sm-4">
                                <div class="p-3 bg-white bg-opacity-5 rounded-4 border border-white border-opacity-10 custom-hover-lift transition-base h-100">
                                    <div class="tiny-caps text-secondary mb-2">Liquid Cash</div>
                                    <h4 class="fw-bold text-white m-0 tracking-tight">@FormatValue(user.BankAccount?.Balance ?? 0)</h4>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="p-3 bg-white bg-opacity-5 rounded-4 border border-white border-opacity-10 custom-hover-lift transition-base h-100">
                                    <div class="tiny-caps text-secondary mb-2">Market Assets</div>
                                    <h4 class="fw-bold text-success m-0 tracking-tight">@FormatValue(marketValue)</h4>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="p-3 bg-danger bg-opacity-10 rounded-4 border border-danger border-opacity-25 custom-hover-lift transition-base h-100">
                                    <div class="tiny-caps text-danger mb-2">Liabilities</div>
                                    <h4 class="fw-bold text-danger m-0 tracking-tight">@FormatValue(totalDebt)</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 fade-in" style="animation-delay: 0.2s;">

                @* --- LEFT COLUMN: TRANSACTIONS & STATS --- *@
                <div class="col-xl-8">
                    <div class="glass-panel p-4 h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-white border-opacity-10">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-white bg-opacity-10 p-2 rounded-3">
                                    <i class="bi bi-activity text-white fs-5"></i>
                                </div>
                                <h5 class="fw-bold text-white mb-0">Recent Activity Log</h5>
                            </div>
                            <button class="btn btn-sm btn-glass-light rounded-pill px-3 tiny-caps fw-bold" @onclick='() => Nav.NavigateTo("/account?tab=Overview")'>
                                View Ledger
                            </button>
                        </div>

                        <div class="flex-grow-1">
                            @if (user.BankAccount?.Transactions == null || !user.BankAccount.Transactions.Any())
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center py-5 opacity-50">
                                    <i class="bi bi-inboxes text-secondary display-4 mb-3"></i>
                                    <p class="text-secondary tiny-caps">No ledger activity detected.</p>
                                </div>
                            }
                            else
                            {
                                <div class="list-group list-group-flush bg-transparent gap-2">
                                    @foreach (var tx in user.BankAccount.Transactions.OrderByDescending(t => t.CreatedAt).Take(5))
                                    {
                                        bool isDeposit = tx.Amount > 0;
                                        string iconClass = isDeposit ? "bi-arrow-down-left text-success" : "bi-arrow-up-right text-danger";
                                        string bgClass = isDeposit ? "bg-success bg-opacity-10" : "bg-danger bg-opacity-10";

                                        <div class="list-group-item bg-transparent border border-white border-opacity-5 rounded-3 p-3 mb-2 d-flex align-items-center justify-content-between custom-hover-bg transition-base">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="@bgClass rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                    <i class="bi @iconClass fs-5"></i>
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold text-white mb-0 text-capitalize">@tx.Type.ToString()</h6>
                                                    <small class="text-secondary opacity-75">@tx.Note</small>
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <h6 class="fw-bold font-monospace mb-0 @(isDeposit ? "text-success" : "text-white")">
                                                    @(isDeposit ? "+" : "")@FormatValue(tx.Amount)
                                                </h6>
                                                <small class="text-secondary font-monospace tiny-caps">@tx.CreatedAt.ToString("MMM dd, HH:mm")</small>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* --- RIGHT COLUMN: QUICK COMMAND PAD --- *@
                <div class="col-xl-4">
                    <div class="glass-panel p-4 h-100 d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-white border-opacity-10">
                            <div class="bg-danger bg-opacity-10 p-2 rounded-3">
                                <i class="bi bi-grid-1x2-fill text-danger fs-5"></i>
                            </div>
                            <h5 class="fw-bold text-white mb-0">Command Pad</h5>
                        </div>

                        <div class="row g-3 flex-grow-1">
                            <div class="col-6">
                                <button class="btn btn-action w-100 h-100 p-4 d-flex flex-column align-items-center justify-content-center gap-2 rounded-4" @onclick='() => Nav.NavigateTo("/account?tab=Transfer")'>
                                    <i class="bi bi-send-fill fs-3 text-white"></i>
                                    <span class="tiny-caps fw-bold">Transfer</span>
                                </button>
                            </div>
                            <div class="col-6">
                                <button class="btn btn-action w-100 h-100 p-4 d-flex flex-column align-items-center justify-content-center gap-2 rounded-4" @onclick='() => Nav.NavigateTo("/market")'>
                                    <i class="bi bi-graph-up-arrow fs-3 text-success"></i>
                                    <span class="tiny-caps fw-bold">Trade</span>
                                </button>
                            </div>
                            <div class="col-6">
                                <button class="btn btn-action w-100 h-100 p-4 d-flex flex-column align-items-center justify-content-center gap-2 rounded-4" @onclick='() => Nav.NavigateTo("/account?tab=Lending")'>
                                    <i class="bi bi-bank fs-3 text-warning"></i>
                                    <span class="tiny-caps fw-bold">Finance</span>
                                </button>
                            </div>
                            <div class="col-6">
                                <button class="btn btn-action-danger w-100 h-100 p-4 d-flex flex-column align-items-center justify-content-center gap-2 rounded-4" @onclick='() => Nav.NavigateTo("/")'>
                                    <i class="bi bi-box-arrow-right fs-3"></i>
                                    <span class="tiny-caps fw-bold">Logout</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            @* --- FOOTER: BANK-WIDE STATS --- *@
            <div class="mt-5 fade-in" style="animation-delay: 0.3s;">
                <Stats />
            </div>
        }
    </div>
</div>

<style>
    /* Base Variables & Typography */
    .bg-darker {
        background-color: #050505;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .fw-black {
        font-weight: 900;
    }

    .tracking-tighter {
        letter-spacing: -2px;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }

    .tracking-widest {
        letter-spacing: 2px;
    }

    .tiny-caps {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: 800;
    }

    .transition-base {
        transition: all 0.2s ease-in-out;
    }

    /* Glassmorphism Core */
    .blur-bg {
        filter: blur(120px);
    }

    .glass-panel {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 1.25rem;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }

    /* Buttons & Interactions */
    .btn-glass-light {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
    }

        .btn-glass-light:hover {
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
        }

    .btn-action {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #adb5bd;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .btn-action:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.2);
            color: #fff;
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        }

    .btn-action-danger {
        background: rgba(220, 53, 69, 0.05);
        border: 1px solid rgba(220, 53, 69, 0.15);
        color: #dc3545;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .btn-action-danger:hover {
            background: #dc3545;
            color: #fff;
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(220, 53, 69, 0.3);
        }

    .custom-hover-lift:hover {
        transform: translateY(-3px);
    }

    .custom-hover-bg:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    /* Animations */
    .fade-in {
        animation: fadeInUp 0.5s ease-out forwards;
        opacity: 0;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private ApplicationUser? user;
    private decimal marketValue = 0;
    private decimal totalDebt = 0;
    private decimal netWorth = 0;

    protected override async Task OnInitializedAsync()
    {
        user = await IdentityService.GetCurrentUserAsync();

        if (user?.BankAccount != null)
        {
            using var db = await DbFactory.CreateDbContextAsync();

            var loans = await FinanceService.GetUserLoansAsync(user.BankAccount.Id);
            totalDebt = loans.Where(l => l.Status == LoanStatus.Approved).Sum(l => l.Amount);

            // Fetch REAL market value from the database
            marketValue = await db.Investments
                .Include(i => i.Stock)
                .Where(i => i.BankAccountId == user.BankAccount.Id)
                .SumAsync(i => i.Quantity * i.Stock.CurrentPrice);

            // Calculate actual net worth based on available factors
            netWorth = (user.BankAccount.Balance + marketValue) - totalDebt;
        }
    }

    private string FormatValue(decimal val) => val.ToString("N2", new CultureInfo("en-US"));

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour >= 5 && hour < 12) return "Good Morning";
        if (hour >= 12 && hour < 17) return "Good Afternoon";
        if (hour >= 17 && hour < 22) return "Good Evening";
        return "Good Night";
    }
}