@attribute [Route(AppRoutes.Dashboard)]
@using BankApp.Data.Entities.Auth
@using BankApp.Data.Entities.Banking
@using BankApp.Services
@rendermode InteractiveServer
@inject IAuthService AuthService

<div class="bg-black text-white min-vh-100 pb-5">
    @* --- TOP NAVIGATION STYLE BAR --- *@
    <div class="border-bottom border-white border-opacity-10 py-4 mb-5 bg-black sticky-top">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bolder tracking-tighter mb-0">Command <span class="text-danger">Center</span></h2>
                <span class="text-white-50 smaller tracking-widest text-uppercase">Encrypted Session Active</span>
            </div>
            <button class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>New Account
            </button>
        </div>
    </div>

    <div class="container">
        @if (user == null)
        {
            <div class="text-center py-5">
                <div class="spinner-grow text-danger" role="status"></div>
                <p class="mt-4 tracking-widest text-white-50">SYNCING PROTOCOLS...</p>
            </div>
        }
        else
        {
            <div class="row g-4 mb-5">
                @* --- LEFT COL: ACCOUNTS & CARDS --- *@
                <div class="col-lg-8">
                    <h5 class="text-uppercase tracking-widest text-danger small fw-bold mb-4">Financial Assets</h5>
                    <div class="row g-4 mb-5">
                        @foreach (var account in user.BankAccounts)
                        {
                            <div class="col-md-6">
                                <div class="glass-card p-4 h-100">
                                    <div class="d-flex justify-content-between mb-4">
                                        <div class="icon-box bg-danger bg-opacity-10 text-danger">
                                            <i class="bi bi-cpu"></i>
                                        </div>
                                        <span class="badge bg-white bg-opacity-5 text-success border border-success border-opacity-25 rounded-pill px-3 py-2">LIVE</span>
                                    </div>
                                    <small class="text-white-50 text-uppercase tracking-widest" style="font-size: 0.6rem;">Master Account</small>
                                    <h2 class="fw-bolder mb-3">@account.Balance.ToString("C2")</h2>
                                    <div class="d-flex justify-content-between align-items-end">
                                        <span class="font-monospace text-white-50">@FormatAccountNumber(account.AccountNumber)</span>
                                        <i class="bi bi-arrow-right-short fs-4 text-danger"></i>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <h5 class="text-uppercase tracking-widest text-danger small fw-bold mb-4">Unified Ledger</h5>
                    <div class="glass-card overflow-hidden">
                        <div class="table-responsive">
                            <table class="table table-dark table-hover align-middle mb-0">
                                <thead class="bg-white bg-opacity-5">
                                    <tr>
                                        <th class="ps-4 border-0 text-white-50 small text-uppercase">Reference</th>
                                        <th class="border-0 text-white-50 small text-uppercase">Account</th>
                                        <th class="border-0 text-white-50 small text-uppercase text-end pe-4">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tx in user.BankAccounts.SelectMany(a => a.Transactions).OrderByDescending(t => t.CreatedAt).Take(8))
                                    {
                                        <tr class="border-bottom border-white border-opacity-5">
                                            <td class="ps-4 py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="tx-indicator @(tx.Amount < 0 ? "bg-danger" : "bg-success")"></div>
                                                    <div>
                                                        <div class="fw-bold">@tx.Note</div>
                                                        <div class="text-white-50 smaller font-monospace">@tx.TransactionReference.Substring(0, 12)</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-white-50 small font-monospace">..@tx.BankAccount.AccountNumber.Substring(Math.Max(0, tx.BankAccount.AccountNumber.Length - 4))</td>
                                            <td class="text-end pe-4 fw-bolder @(tx.Amount < 0 ? "text-danger" : "text-success")">
                                                @(tx.Amount < 0 ? "-" : "+")@Math.Abs(tx.Amount).ToString("C2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @* --- RIGHT COL: CARDS & STATS --- *@
                <div class="col-lg-4">
                    <h5 class="text-uppercase tracking-widest text-danger small fw-bold mb-4">Secured Hardware</h5>
                    @foreach (var card in user.BankAccounts.SelectMany(a => a.Cards))
                    {
                        <div class="glass-card p-4 mb-4 border border-danger border-opacity-10">
                            <div class="d-flex justify-content-between mb-5">
                                <i class="bi bi-chip text-warning fs-3"></i>
                                <span class="text-white-50 font-monospace">Tier 1</span>
                            </div>
                            <div class="fs-4 mb-4 font-monospace tracking-widest text-center">**** **** **** @card.CardNumber.Substring(card.CardNumber.Length - 4)</div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small text-uppercase tracking-widest">@user.FullName</span>
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">@card.ExpiryDate</span>
                            </div>
                        </div>
                    }

                    <div class="mt-5">
                         <h5 class="text-uppercase tracking-widest text-danger small fw-bold mb-4">Global Pulse</h5>
                         <NetworkStats />
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1.5rem;
        backdrop-filter: blur(10px);
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .glass-card:hover {
        border-color: rgba(220, 53, 69, 0.3);
        transform: translateY(-5px);
    }
    .icon-box {
        width: 50px; height: 50px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 1rem; font-size: 1.5rem;
    }
    .tx-indicator {
        width: 4px; height: 30px; border-radius: 10px; margin-right: 15px;
    }
    .tracking-tighter { letter-spacing: -2px; }
    .smaller { font-size: 0.7rem; }
</style>

@code {
    private ApplicationUser? user;

    protected override async Task OnInitializedAsync() {
        user = await AuthService.GetCurrentApplicationUser();
    }

    private string FormatAccountNumber(string raw) {
        if (string.IsNullOrEmpty(raw) || raw.Length < 4) return raw;
        return raw.Length >= 12 ? string.Join("-", Enumerable.Range(0, raw.Length / 4).Select(i => raw.Substring(i * 4, 4))) : raw;
    }
}