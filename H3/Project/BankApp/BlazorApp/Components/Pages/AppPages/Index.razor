@page "/"
@layout MainLayout
@attribute [StreamRendering]
@using BankApp.Data.Entities.Auth
@using BankApp.Data.Entities.Banking
@using BlazorApp.Components @* Ensure this matches your project structure *@
@inject NavigationManager Nav

<PageTitle>RedSkia Banking | Finance at Speed</PageTitle>

<main class="bg-black text-white overflow-hidden">
    @* --- DYNAMIC BACKGROUND GRID --- *@
    <div class="fixed-top w-100 h-100 opacity-10" style="background-image: radial-gradient(#dc3545 0.5px, transparent 0.5px); background-size: 30px 30px; pointer-events: none; z-index: 0;"></div>

    @* --- HERO SECTION --- *@
    <section class="position-relative d-flex align-items-center justify-content-center pt-5" style="min-height: 100vh;">
        @* Radial Glow *@
        <div class="position-absolute top-50 start-50 translate-middle w-75 h-75" 
             style="background: radial-gradient(circle, rgba(200, 0, 0, 0.1) 0%, transparent 70%); pointer-events: none;"></div>

        <div class="container position-relative z-1 py-5">
            <div class="text-center mb-5">
                <div class="animate-bounce-subtle">
                    <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger px-3 py-2 mb-4 border border-danger border-opacity-25 small tracking-widest fw-bolder">
                        <i class="bi bi-cpu-fill me-2"></i>QUANTUM-READY LIQUIDITY
                    </span>
                </div>

                <h1 class="display-1 fw-bolder text-white mb-3 tracking-tighter hero-title">
                    Finance at the <br /> 
                    <span class="text-danger glow-text">speed of thought.</span>
                </h1>

                <p class="lead text-white-50 mx-auto mb-5 mt-4" style="max-width: 650px; font-weight: 300; line-height: 1.6;">
                    The premier institutional gateway for real-time wealth orchestration. 
                    Deploy capital across <span class="text-white fw-bold">Global Nodes</span> with zero-latency execution.
                </p>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-4">
                    <button @onclick='() => Nav.NavigateTo("register")' class="btn btn-danger btn-lg rounded-0 px-5 py-3 fw-bolder btn-cyber">
                        INITIALIZE ACCOUNT
                    </button>
                    <button @onclick='() => Nav.NavigateTo("market")' class="btn btn-outline-light btn-lg rounded-0 px-5 py-3 fw-bolder border-opacity-25 hero-secondary">
                        MARKET DATA
                    </button>
                </div>
            </div>

            @* --- COMMAND CENTER PREVIEW --- *@
            <div class="mx-auto mt-5 preview-container">
                <div class="dashboard-preview-card border border-white border-opacity-10 rounded-4 overflow-hidden shadow-2xl bg-dark bg-opacity-50 backdrop-blur">
                    <div class="preview-header border-bottom border-white border-opacity-10 p-3 d-flex align-items-center gap-2">
                        <div class="dot bg-danger"></div><div class="dot bg-warning"></div><div class="dot bg-success"></div>
                        <span class="smaller text-white-50 font-monospace ms-2">SECURE_TERMINAL // USER: ALEXANDER_STANDARD</span>
                    </div>
                    @RenderDashboard(GetMockUser())
                </div>
            </div>
        </div>
    </section>

    @* --- TICKER TAPE --- *@
    <div class="bg-danger py-2 overflow-hidden border-top border-bottom border-danger">
        <div class="ticker-wrap">
            <div class="ticker-move">
                @for(int i=0; i<10; i++) {
                    <span class="ticker-item"><b>BTC/USD</b> +4.2%</span>
                    <span class="ticker-item"><b>XAU/USD</b> -0.8%</span>
                    <span class="ticker-item"><b>LIQUIDITY TIER 1</b> ACTIVE</span>
                    <span class="ticker-item"><b>NODE SECURITY</b> 100%</span>
                }
            </div>
        </div>
    </div>
</main>

<style>
    .hero-title { font-size: calc(2rem + 4vw); letter-spacing: -5px; }
    .glow-text { filter: drop-shadow(0 0 15px rgba(220, 53, 69, 0.4)); }
    .backdrop-blur { backdrop-filter: blur(20px); }
    
    /* Cyber Button Styling */
    .btn-cyber {
        background: #dc3545;
        border: none;
        clip-path: polygon(10% 0, 100% 0, 100% 70%, 90% 100%, 0 100%, 0% 30%);
        transition: all 0.3s ease;
    }
    .btn-cyber:hover {
        background: #ff1e31;
        transform: scale(1.05);
        letter-spacing: 2px;
    }

    .preview-container {
        max-width: 1100px;
        perspective: 2000px;
    }

    .dashboard-preview-card {
        transform: rotateX(10deg) translateY(0);
        transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .preview-container:hover .dashboard-preview-card {
        transform: rotateX(0deg) translateY(-20px);
    }

    .dot { width: 8px; height: 8px; border-radius: 50%; }

    /* Ticker Animation */
    .ticker-wrap { display: flex; width: 100%; }
    .ticker-move { display: flex; white-space: nowrap; animation: ticker 30s linear infinite; }
    .ticker-item { color: black; font-weight: 800; font-family: monospace; padding: 0 2rem; font-size: 0.8rem; }
    @@keyframes ticker {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    .animate-bounce-subtle {
        animation: bounce 4s ease-in-out infinite;
    }
    @@keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
</style>

@code {
    RenderFragment RenderDashboard(ApplicationUser demoUser) => __builder =>
    {
        <div class="p-4 p-md-5">
            <div class="row g-4 mb-4">
                <div class="col-md-7">
                    <h5 class="text-danger small fw-bold tracking-widest text-uppercase mb-3">Asset Allocation</h5>
                    <div class="glass-card p-4 border border-white border-opacity-10 mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-white-50 small mb-1">TOTAL LIQUIDITY</h6>
                                <h2 class="fw-bolder mb-0">$20,950.00</h2>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-success bg-opacity-10 text-success">+12.5%</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <h5 class="text-danger small fw-bold tracking-widest text-uppercase mb-3">Protocol Health</h5>
                    <div class="glass-card p-4 border border-white border-opacity-10">
                        <NetworkStats />
                    </div>
                </div>
            </div>
        </div>
    };

    private ApplicationUser GetMockUser() => new ApplicationUser {
        FullName = "Alexander Standard",
        BankAccounts = new List<BankAccount> {
            new BankAccount { AccountNumber = "CH-9911", Balance = 12450.00m }
        }
    };
}