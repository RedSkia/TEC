@page "/dd"
@using BankApp.Data
@using BlazorApp.Components.Elements
@inject NavigationManager Nav

<div class="container py-5">
    <div class="row min-vh-60 align-items-center mb-5 mt-lg-5">
        <div class="col-lg-10">
            <div class="mb-4 d-flex align-items-center gap-3">
                <div class="bg-danger" style="width: 60px; height: 4px;"></div>
                <span class="fw-bold text-white small text-uppercase" style="letter-spacing: 5px;">Redskia Bank</span>
            </div>

            <h1 class="display-1 fw-bold text-white mb-4" style="letter-spacing: -5px; line-height: 0.85;">
                INVESTMENT <br />
                <span class="text-danger">MARKET.</span>
            </h1>

            <p class="text-light fs-4 opacity-75 mb-5" style="max-width: 800px; line-height: 1.4;">
                Access institutional-grade wealth management. Trade global assets,
                monitor market shifts, and build your private portfolio in a
                real-time financial ecosystem.
            </p>

            <div class="d-flex flex-wrap gap-3">
                <button @onclick='() => Nav.NavigateTo("/login")'
                        class="btn btn-danger btn-lg rounded-0 px-5 py-3 fw-bold border-0 shadow-lg">
                    GET STARTED
                </button>

                <button @onclick='() => Nav.NavigateTo("/market")'
                        class="btn btn-outline-light btn-lg rounded-0 px-5 py-3 fw-bold">
                    VIEW MARKET
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-5">
            <Stats />
        </div>
    </div>
</div>

<style>
    body {
        background-color: #060606;
        color: #ffffff;
        overflow-x: hidden;
    }

    .display-1 {
        font-size: clamp(4rem, 12vw, 8rem);
    }

    .btn {
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-danger:hover {
        background-color: #ffffff !important;
        color: #000000 !important;
        transform: translateY(-3px);
    }

    .btn-outline-light:hover {
        background-color: #ffffff !important;
        color: #000000 !important;
        transform: translateY(-3px);
    }

    .text-truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>