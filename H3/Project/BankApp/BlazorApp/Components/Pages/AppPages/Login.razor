@attribute [Route(AppRoutes.Login)]

@inject IdentityService IdentityService
@inject AppNavigator Navigator
@rendermode InteractiveServer

<div class="auth-container d-flex align-items-center justify-content-center min-vh-100">
    <div style="width: 100%; max-width: 400px;">

        @* TItem is set to string, and we pass the username as the model just to satisfy the EditForm *@
        <InputForm TItem="string"
                   Model="username"
                   OnSubmit="HandleLogin"
                   ButtonText="LOGIN"
                   ButtonTabIndex="3"
                   LoadingText="AUTHENTICATING..."
                   IsLoading="busy"
                   FormName="login-form"
                   Class="bg-dark bg-opacity-75 border border-secondary border-opacity-25 rounded-0 shadow-lg p-4"
                   style="backdrop-filter: blur(10px);">

            <HeaderContent>
                <div class="text-center mb-4">
                    <h4 class="fw-bold text-white mb-1" style="letter-spacing: -1px;">
                        USER <span class="text-danger">LOGIN.</span>
                    </h4>
                    <p class="text-secondary small text-uppercase mb-0" style="letter-spacing: 2px; font-size: 0.65rem;">
                        Secure Access Portal
                    </p>
                </div>

                @if (error != null)
                {
                    @* Manual Error Bar - Matches your RedSkia style *@
                    <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger small rounded-0 mb-4 py-2 fw-bold text-uppercase text-center">
                        <i class="bi bi-shield-lock-fill me-2"></i> @error
                    </div>
                }
            </HeaderContent>

            <ChildContent>
                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold text-uppercase" style="font-size: 0.7rem;">Username</label>
                    <InputText @bind-Value="username" 
                               tabindex="1" 
                               autofocus 
                               class="form-control bg-black border-secondary border-opacity-50 text-white rounded-0 shadow-none py-2" 
                               style="border-left: 3px solid #dc3545;" 
                               placeholder="Enter Username" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold text-uppercase" style="font-size: 0.7rem;">Password</label>
                    <InputText @bind-Value="password" 
                               tabindex="2" 
                               type="password" 
                               class="form-control bg-black border-secondary border-opacity-50 text-white rounded-0 shadow-none py-2" 
                               style="border-left: 3px solid #dc3545;" 
                               placeholder="••••••••" />
                </div>
            </ChildContent>

            <FooterContent>
                <div class="d-flex justify-content-between mt-1 px-1">
                    <Button Text="Create Account" 
                               Icon="bi-person-plus" 
                               Destination="@AppRoutes.LoginRegister" 
                               TabIndex="4"
                               Class="link-secondary small fw-bold text-uppercase hover-danger" />

                    <Button Text="Forgot Password?"
                               Icon="bi-shield-lock" 
                               Destination="@AppRoutes.LoginReset" 
                               TabIndex="5"
                               Class="link-secondary small fw-bold text-uppercase hover-danger" />
                </div>
            </FooterContent>
        </InputForm>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [CascadingParameter] public Toast? Toast { get; set; }
    
    private string username = "";
    private string password = "";
    private bool busy;
    private string? error;

    protected override void OnInitialized()
    {
        if (IdentityService.IsUserAuthenticated())
            Navigator.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl);
    }

    async Task HandleLogin()
    {
        // 1. Manual Validation Check
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            error = "CREDENTIALS_REQUIRED";
            Toast?.Show("Identification Failed: Missing fields.", Toast.ToastLevel.Warning);
            return;
        }

        busy = true;
        error = null;

        try 
        {
            var token = await IdentityService.Login(username, password);
            if (!string.IsNullOrEmpty(token))
            {
                await Navigator.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? AppRoutes.Index : ReturnUrl);
            }
            else 
            {
                // 2. Business Logic Errors
                error = "ACCESS_DENIED";
                Toast?.Show("Authentication Failed: Invalid Credentials.", Toast.ToastLevel.Error);
            }
        } 
        catch 
        { 
            error = "SYSTEM_OFFLINE"; 
            Toast?.Show("Critical: Security server unreachable.", Toast.ToastLevel.Error);
        }
        finally { busy = false; }
    }
}