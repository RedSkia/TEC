@attribute [Route(AppRoutes.Login)]
@inject IdentityService IdentityService
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="auth-container d-flex align-items-center justify-content-center min-vh-100">
    <div style="width: 100%; max-width: 400px;">

        <InputForm TItem="string"
                   Model="username"
                   OnSubmit="HandleLogin"
                   ButtonText="LOGIN"
                   LoadingText="AUTHENTICATING..."
                   IsLoading="busy"
                   ButtonClass="btn-outline-danger border-2 fw-bold rounded-0"
                   FormName="login-form"
                   Class="bg-dark bg-opacity-75 border border-secondary border-opacity-25 rounded-0 shadow-lg p-4"
                   style="backdrop-filter: blur(10px);">

            <HeaderContent>
                <div class="text-center mb-4">
                    <h4 class="fw-bold text-white mb-1" style="letter-spacing: -1px;">
                        USER <span class="text-danger">LOGIN.</span>
                    </h4>
                    <p class="text-secondary small text-uppercase mb-0" style="letter-spacing: 2px; font-size: 0.65rem;">
                        Secure Access Portal
                    </p>
                </div>

                @if (error != null)
                {
                    <div class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger small rounded-0 mb-4 py-2 fw-bold text-uppercase text-center">
                        <i class="bi bi-shield-lock-fill me-2"></i> @error
                    </div>
                }
            </HeaderContent>

            <ChildContent>
                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold text-uppercase" style="font-size: 0.7rem;">Username</label>
                    <InputText @bind-Value="username"
                               class="form-control bg-black border-secondary border-opacity-50 text-white rounded-0 shadow-none py-2"
                               style="border-left: 3px solid #dc3545;"
                               placeholder="Enter Username"
                               autocomplete="username" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold text-uppercase" style="font-size: 0.7rem;">Password</label>
                    <InputText @bind-Value="password"
                               type="password"
                               class="form-control bg-black border-secondary border-opacity-50 text-white rounded-0 shadow-none py-2"
                               style="border-left: 3px solid #dc3545;"
                               placeholder="••••••••"
                               autocomplete="current-password" />
                </div>
            </ChildContent>

        </InputForm>

        <div class="d-flex justify-content-between mt-3 px-1">
            <NavLink href="@AppRoutes.LoginRegister" class="link-secondary text-decoration-none small fw-bold text-uppercase hover-danger" style="font-size: 0.65rem; letter-spacing: 1px;">
                <i class="bi bi-person-plus me-1"></i>Create Account
            </NavLink>

            <NavLink href="login/reset" class="link-secondary text-decoration-none small fw-bold text-uppercase hover-danger" style="font-size: 0.65rem; letter-spacing: 1px;">
                <i class="bi bi-shield-lock me-1"></i>Forgot Password?
            </NavLink>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        background-color: #000 !important;
        border-color: #dc3545 !important;
        color: #fff !important;
    }

    .form-control::placeholder {
        color: #444 !important;
        font-size: 0.8rem;
    }

    .hover-danger:hover {
        color: #dc3545 !important;
        transition: 0.2s ease;
    }
</style>

@code {
    [CascadingParameter] public Toast? Toast { get; set; }

    private string username = "";
    private string password = "";
    private bool busy;
    private string? error;

    protected override void OnInitialized()
    {
        // Fix: If already authenticated, redirect immediately
        if (IdentityService.IsUserAuthenticated())
        {
            Nav.NavigateTo(AppRoutes.Index);
        }
    }

    async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            error = "CREDENTIALS REQUIRED";
            Toast?.Show(error, Toast.ToastLevel.Warning);
            return;
        }

        busy = true;
        error = null;

        try
        {
            var token = await IdentityService.Login(username, password);

            if (!string.IsNullOrEmpty(token))
            {
                // Navigate with true to force a reload, refreshing the AuthProvider
                // and ensuring the Header updates immediately.
                Nav.NavigateTo(AppRoutes.Index, true);
            }
            else
            {
                error = "ACCESS DENIED";
                Toast?.Show("Authentication Failed: Invalid Credentials.", Toast.ToastLevel.Error);
            }
        }
        catch (Exception ex)
        {
            error = "CRITICAL FAILURE";
            Toast?.Show("System Error: Security service unreachable.", Toast.ToastLevel.Error);
            Console.WriteLine($"Login Error: {ex.Message}");
        }
        finally
        {
            busy = false;
        }
    }
}