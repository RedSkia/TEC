@page "/login/register"
@inject IdentityService IdentityService
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="auth-container d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div style="width: 100%; max-width: 500px;" class="fade-in">

        <InputForm TItem="ApplicationUser"
                   Model="user"
                   OnSubmit="HandleRegister"
                   ButtonText="INITIALIZE ACCOUNT"
                   LoadingText="PROVISIONING..."
                   IsLoading="busy"
                   ButtonClass="btn-danger fw-black rounded-0 w-100 py-3 mt-2"
                   FormName="register-form"
                   Class="glass-panel p-4 shadow-lg"
                   style="border-top: 4px solid #dc3545;">

            <HeaderContent>
                <div class="text-center mb-4">
                    <div class="badge bg-danger pulse-red mb-2">SYSTEM ONBOARDING</div>
                    <h2 class="fw-black text-white mb-1 tracking-tighter">NEW <span class="text-danger">USER.</span></h2>
                    <p class="text-secondary tiny-caps mb-0">Identity & Asset Initialization</p>
                </div>

                @if (error != null)
                {
                    <div class="alert bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger tiny-caps py-2 fw-bold text-center mb-4">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i> @error
                    </div>
                }
            </HeaderContent>

            <ChildContent>
                <div class="row g-3 mb-3">
                    <div class="col-md-12">
                        <label class="tiny-caps text-secondary mb-1">Legal Full Name</label>
                        <InputText @bind-Value="user.FullName" class="form-control trade-input" placeholder="JOHN DOE" />
                    </div>
                    <div class="col-md-12">
                        <label class="tiny-caps text-secondary mb-1">Network Identity (Email)</label>
                        <InputText @bind-Value="user.Email" class="form-control trade-input" placeholder="IDENTITY@NETWORK.COM" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="tiny-caps text-secondary mb-1">Residential Vector (Street)</label>
                    <InputText @bind-Value="user.Address.Street" class="form-control trade-input" placeholder="123 SECURITY LN" />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-7">
                        <label class="tiny-caps text-secondary mb-1">City</label>
                        <InputText @bind-Value="user.Address.City" class="form-control trade-input" placeholder="NEO-CITY" />
                    </div>
                    <div class="col-5">
                        <label class="tiny-caps text-secondary mb-1">Zip</label>
                        <InputText @bind-Value="user.Address.ZipCode" class="form-control trade-input" placeholder="00000" />
                    </div>
                </div>

                <div class="row g-3 mb-2">
                    <div class="col-md-6">
                        <label class="tiny-caps text-secondary mb-1">Username</label>
                        <InputText @bind-Value="user.UserName" class="form-control trade-input" placeholder="UID_01" />
                    </div>
                    <div class="col-md-6">
                        <label class="tiny-caps text-secondary mb-1">Access Key</label>
                        <input type="password" @bind="password" class="form-control trade-input" placeholder="••••••••" />
                    </div>
                </div>
            </ChildContent>
        </InputForm>

        <div class="text-center mt-4">
            <NavLink href="/login" class="text-decoration-none tiny-caps text-secondary hover-danger">
                <i class="bi bi-shield-lock me-1"></i> Return to Terminal Login
            </NavLink>
        </div>
    </div>
</div>

<style>
    /* Reusing your Market Terminal Styles */
    .glass-panel {
        background: #0c0c0c;
        border: 1px solid #1f1f1f;
        border-radius: 4px;
    }

    .fw-black { font-weight: 900; }
    .tracking-tighter { letter-spacing: -2px; }
    .tiny-caps { font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; }

    .trade-input {
        background: #000 !important;
        border: 1px solid #333 !important;
        color: white !important;
        font-weight: 600;
        border-radius: 0;
        font-size: 0.9rem;
    }

    .trade-input:focus {
        border-color: #dc3545 !important;
        box-shadow: none !important;
    }

    .hover-danger:hover {
        color: #dc3545 !important;
        transition: 0.2s ease;
    }

    .pulse-red {
        animation: pulseR 2s infinite;
        font-size: 9px;
    }

    @@keyframes pulseR {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }
</style>

@code {
    [CascadingParameter] public Toast? Toast { get; set; }

    private ApplicationUser user = new() { Address = new Address() };
    private string password = "";
    private bool busy;
    private string? error;

    async Task HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(user.FullName) ||
            string.IsNullOrWhiteSpace(user.Email) ||
            string.IsNullOrWhiteSpace(user.UserName) ||
            string.IsNullOrWhiteSpace(user.Address?.Street) ||
            string.IsNullOrWhiteSpace(password))
        {
            error = "FIELD_MANDATORY_CRITICAL";
            Toast?.Show("Missing required identification fields.", Toast.ToastLevel.Warning);
            return;
        }

        busy = true;
        error = null;

        try
        {
            // IdentityService handles the UserManager logic and Role assignment
            var validationErrors = await IdentityService.Register(user, password);

            if (validationErrors == null || !validationErrors.Any())
            {
                Toast?.Show("Access Granted. Identity Synchronized.", Toast.ToastLevel.Success);
                Nav.NavigateTo("/login");
            }
            else
            {
                error = string.Join(" | ", validationErrors).ToUpper();
                Toast?.Show("Network Rejected Identity", Toast.ToastLevel.Error);
            }
        }
        catch (Exception ex)
        {
            error = "ID_SYNC_FAILURE";
            Toast?.Show("Critical connection error to Identity Provider.", Toast.ToastLevel.Error);
            Console.WriteLine(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }
}