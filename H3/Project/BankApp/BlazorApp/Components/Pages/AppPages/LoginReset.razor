@page "/login/reset"
@using BankApp.Services
@using BankApp.Data.Entities.Auth
@using BlazorApp.Components.Elements
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IdentityService IdentityService
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="auth-container d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div style="width: 100%; max-width: 450px;" class="fade-in">

        <div class="mb-4 text-center">
            <NavLink href="/" class="text-decoration-none tiny-caps text-secondary hover-danger">
                <i class="bi bi-terminal me-1"></i> Return to Main Terminal
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                @* LOGGED IN VIEW: 
                   The system knows you. Just enter the new key.
                *@
                <InputForm TItem="object"
                           Model="this"
                           OnSubmit="HandleOverride"
                           ButtonText="UPDATE ACCESS KEY"
                           IsLoading="isBusy"
                           ButtonClass="btn-danger fw-black rounded-0 w-100 py-3"
                           Class="glass-panel p-4 shadow-lg"
                           style="border-top: 4px solid #dc3545;">

                    <HeaderContent>
                        <div class="text-center mb-4">
                            <div class="badge bg-danger pulse-red mb-2">SESSION_ACTIVE</div>
                            <h2 class="fw-black text-white mb-1 tracking-tighter">SEC_ <span class="text-danger">OVERRIDE.</span></h2>
                            <p class="text-secondary tiny-caps mb-0">Modifying: <span class="text-white">@context.User.Identity?.Name</span></p>
                        </div>
                        @RenderStatus()
                    </HeaderContent>

                    <ChildContent>
                        <div class="mb-3">
                            <label class="tiny-caps text-secondary mb-1">New Access Key</label>
                            <input type="password" @bind="newPassword" class="form-control trade-input" placeholder="••••••••" />
                            <div class="mt-2 text-muted" style="font-size: 0.6rem;">* Internal bypass active. Old key not required.</div>
                        </div>
                    </ChildContent>
                </InputForm>
            </Authorized>

            <NotAuthorized>
                @* GUEST VIEW: 
                   Emergency recovery protocol.
                *@
                <InputForm TItem="object"
                           Model="this"
                           OnSubmit="HandleGuestReset"
                           ButtonText="INITIALIZE RECOVERY"
                           IsLoading="isBusy"
                           ButtonClass="btn-outline-danger fw-black rounded-0 w-100 py-3"
                           Class="glass-panel p-4 shadow-lg"
                           style="border-top: 4px solid #6c757d;">

                    <HeaderContent>
                        <div class="text-center mb-4">
                            <div class="badge bg-secondary mb-2">EMERGENCY_PROTOCOL</div>
                            <h2 class="fw-black text-white mb-1 tracking-tighter">ACCOUNT <span class="text-danger">RECOVERY.</span></h2>
                            <p class="text-secondary tiny-caps mb-0">Identity Access Restoration</p>
                        </div>
                        @RenderStatus()
                    </HeaderContent>

                    <ChildContent>
                        <div class="mb-3">
                            <label class="tiny-caps text-secondary mb-1">Target Identity (Username)</label>
                            <InputText @bind-Value="targetUsername" class="form-control trade-input" placeholder="UID_UNKNOWN" />
                        </div>
                        <div class="mb-3">
                            <label class="tiny-caps text-secondary mb-1">Emergency Access Key</label>
                            <input type="password" @bind="newPassword" class="form-control trade-input" placeholder="••••••••" />
                        </div>
                    </ChildContent>
                </InputForm>
            </NotAuthorized>
        </AuthorizeView>

    </div>
</div>

<style>
    .glass-panel {
        background: #0c0c0c;
        border: 1px solid #1f1f1f;
        border-radius: 4px;
    }

    .fw-black {
        font-weight: 900;
    }

    .tracking-tighter {
        letter-spacing: -2px;
    }

    .tiny-caps {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: 700;
    }

    .trade-input {
        background: #000 !important;
        border: 1px solid #333 !important;
        color: white !important;
        font-weight: 600;
        border-radius: 0;
    }

        .trade-input:focus {
            border-color: #dc3545 !important;
            box-shadow: none !important;
        }

    .hover-danger:hover {
        color: #dc3545 !important;
        transition: 0.2s ease;
    }

    .pulse-red {
        animation: pulseR 2s infinite;
        font-size: 9px;
    }

    @@keyframes pulseR {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }
    }
</style>

@code {
    [CascadingParameter] public Toast? Toast { get; set; }

    private string targetUsername = "";
    private string newPassword = "";
    private bool isBusy;
    private string? statusMessage;
    private bool isError;

    private async Task HandleOverride()
    {
        if (string.IsNullOrWhiteSpace(newPassword)) return;
        isBusy = true;

        // In the Authorized view, we pull the username directly from the current context
        var user = await IdentityService.GetCurrentUserAsync();

        if (user != null)
        {
            var result = await IdentityService.ResetPassword(user.UserName!, newPassword);
            ProcessResult(result.Succeeded, result.Succeeded ? "ENCRYPTED: Access Key Updated." : GetError(result));
        }
        else
        {
            ProcessResult(false, "SESSION_EXPIRED: RE-AUTHENTICATION REQUIRED.");
        }
    }

    private async Task HandleGuestReset()
    {
        if (string.IsNullOrWhiteSpace(targetUsername) || string.IsNullOrWhiteSpace(newPassword))
        {
            ProcessResult(false, "IDENT_MISSING: Provide Username and Key.");
            return;
        }

        isBusy = true;
        var result = await IdentityService.ResetPassword(targetUsername, newPassword);
        ProcessResult(result.Succeeded, result.Succeeded ? "RECOVERY_SUCCESS: Access Restored." : GetError(result));
    }

    private void ProcessResult(bool success, string msg)
    {
        isError = !success;
        statusMessage = msg.ToUpper();
        if (success)
        {
            Toast?.Show(msg, Toast.ToastLevel.Success);
            newPassword = targetUsername = "";
        }
        else
        {
            Toast?.Show(msg, Toast.ToastLevel.Error);
        }
        isBusy = false;
    }

    private string GetError(Microsoft.AspNetCore.Identity.IdentityResult result)
        => result.Errors.FirstOrDefault()?.Description ?? "UNKNOWN_AUTH_ERROR";

    RenderFragment RenderStatus() => __builder =>
    {
        if (statusMessage != null)
        {
            <div class="alert @(isError ? "bg-danger" : "bg-success") bg-opacity-10 border-0 rounded-0 py-2 tiny-caps mb-4 text-center @(isError ? "text-danger" : "text-success")">
                <i class="bi @(isError ? "bi-shield-slash" : "bi-shield-check") me-2"></i>
                @statusMessage
            </div>
        }
    };
}