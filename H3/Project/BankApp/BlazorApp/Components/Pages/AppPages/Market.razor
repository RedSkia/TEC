@page "/market"
@using BankApp.Data.Entities.Auth
@using BankApp.Data.Entities.Market
@using BankApp.Data.Entities.Banking
@using BankApp.Services
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject IStockService StockService
@inject IDbContextFactory<BankApp.Data.BankAppDbContext> DbFactory
@inject IJSRuntime JS
@implements IDisposable

<div class="container-fluid py-4 bg-black min-vh-100">
    @if (availableStocks == null)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 80vh;">
            <div class="spinner-grow text-danger" role="status"></div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @* --- 1. WATCHLIST --- *@
            <div class="col-xl-3 col-lg-4">
                <div class="glass-panel p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-danger fw-black small text-uppercase m-0 tracking-wider">Market Terminal</h6>
                        <span class="badge bg-danger pulse-red">LIVE</span>
                    </div>

                    @* SEARCH BAR *@
                    <div class="search-box mb-3">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" @bind="searchTerm" @bind:event="oninput"
                               class="form-control search-input" placeholder="Search Ticker..." />
                    </div>

                    <div class="list-group list-group-flush custom-scroll" style="max-height: 70vh; overflow-y: auto;">
                        @foreach (var stock in FilteredStocks)
                        {
                            var trend = GetTrend(stock);
                            <button @onclick="() => SelectStock(stock)"
                                    class="stock-card @(selectedStock?.Id == stock.Id ? "active" : "")">
                                <div class="d-flex justify-content-between align-items-center w-100">
                                    <div>
                                        <div class="fw-black text-white m-0">@stock.Ticker</div>
                                        <div class="text-secondary small-caps">@stock.Name</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold @(trend >= 0 ? "text-success" : "text-danger")">
                                            $@stock.CurrentPrice.ToString("N2")
                                            <i class="bi @(trend >= 0 ? "bi-caret-up-fill" : "bi-caret-down-fill")"></i>
                                        </div>
                                        <div class="small @(trend >= 0 ? "text-success" : "text-danger")" style="font-size: 0.7rem;">
                                            @(trend >= 0 ? "+" : "")@trend.ToString("F2")%
                                        </div>
                                    </div>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            </div>

            @* --- 2. CHART --- *@
            <div class="col-xl-6 col-lg-8">
                <div class="glass-panel p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h1 class="display-6 fw-black text-white mb-0">@selectedStock?.Ticker</h1>
                            <p class="text-danger tracking-widest small fw-bold text-uppercase">@selectedStock?.Name</p>
                        </div>
                        <div class="text-end">
                            <h2 class="fw-black text-white m-0 tracking-tighter">$@selectedStock?.CurrentPrice.ToString("N2")</h2>
                            @{
                                var selTrend = GetTrend(selectedStock);
                            }
                            <span class="badge @(selTrend >= 0 ? "bg-success" : "bg-danger") bg-opacity-20 @(selTrend >= 0 ? "text-success" : "text-danger") border @(selTrend >= 0 ? "border-success" : "border-danger") border-opacity-25 rounded-0">
                                @(selTrend >= 0 ? "+" : "")@selTrend.ToString("F2")% TODAY
                            </span>
                        </div>
                    </div>
                    <div class="chart-container border border-secondary border-opacity-10 bg-black bg-opacity-30">
                        <canvas id="stockChart"></canvas>
                    </div>
                </div>
            </div>

            @* --- 3. EXECUTION --- *@
            <div class="col-xl-3">
                <div class="glass-panel p-4 mb-4">
                    <h6 class="text-white fw-black small text-uppercase mb-4 border-bottom border-secondary border-opacity-25 pb-2">Order Desk</h6>

                    <div class="mb-4">
                        <label class="text-secondary tiny-caps mb-2">Quantity (Units)</label>
                        <div class="input-group">
                            <input type="number" @bind="orderQuantity" class="form-control trade-input" />
                            <span class="input-group-text bg-transparent border-secondary text-secondary">SHARES</span>
                        </div>
                    </div>

                    <div class="mb-4 p-3 bg-white bg-opacity-5 rounded">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-secondary small">Total Requirement</span>
                            <span class="text-white fw-black fs-5">$@((orderQuantity * (selectedStock?.CurrentPrice ?? 0)).ToString("N2"))</span>
                        </div>
                    </div>

                    @if (user != null)
                    {
                        <button @onclick="HandleBuy" class="btn btn-danger w-100 fw-black rounded-0 py-3 trade-btn mb-2">EXECUTE ACQUISITION</button>
                        <p class="text-center text-success small">@tradeMessage</p>
                    }
                    else
                    {
                        <a href="/login" class="btn btn-outline-secondary w-100 rounded-0 py-3 text-uppercase fw-black">Login to Authorize</a>
                    }
                </div>

                @if (user?.BankAccount != null)
                {
                    <div class="glass-panel p-3 border-danger border-opacity-50 border-start border-4">
                        <small class="text-danger tiny-caps d-block">Available Liquidity</small>
                        <h4 class="text-white fw-black m-0">$@user.BankAccount.Balance.ToString("N2")</h4>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .glass-panel {
        background: rgba(20, 20, 20, 0.8);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255,255,255,0.05);
    }

    .fw-black {
        font-weight: 900;
    }

    .tracking-wider {
        letter-spacing: 2px;
    }

    .tracking-widest {
        letter-spacing: 4px;
    }

    .tracking-tighter {
        letter-spacing: -2px;
    }

    .small-caps {
        font-size: 0.65rem;
        text-transform: uppercase;
        font-weight: bold;
        opacity: 0.6;
    }

    .tiny-caps {
        font-size: 0.55rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 800;
    }

    .search-box {
        position: relative;
    }

    .search-input {
        background: #000;
        border: 1px solid #333;
        color: white;
        padding-left: 35px;
        border-radius: 0;
        font-size: 0.8rem;
    }

        .search-input:focus {
            background: #111;
            border-color: #dc3545;
            box-shadow: none;
        }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #666;
        font-size: 0.8rem;
    }

    .stock-card {
        background: transparent;
        border: none;
        width: 100%;
        text-align: left;
        padding: 12px;
        border-bottom: 1px solid rgba(255,255,255,0.03);
        transition: 0.2s;
    }

        .stock-card:hover {
            background: rgba(255,255,255,0.03);
        }

        .stock-card.active {
            background: rgba(220, 53, 69, 0.1);
            border-left: 3px solid #dc3545;
        }

    .chart-container {
        height: 400px;
        width: 100%;
        position: relative;
    }

    .trade-input {
        background: #000;
        border: 1px solid #333;
        color: white;
        font-weight: 900;
        border-radius: 0;
    }

    .trade-btn {
        transition: 0.3s;
        box-shadow: 0 0 15px rgba(220, 53, 69, 0);
    }

        .trade-btn:hover {
            box-shadow: 0 0 25px rgba(220, 53, 69, 0.4);
            transform: translateY(-2px);
        }

    .pulse-red {
        animation: pulse 1.5s infinite;
        font-size: 0.6rem;
        letter-spacing: 1px;
    }

    @@keyframes pulse {
        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.4;
        }

        100% {
            opacity: 1;
        }
    }

    .custom-scroll::-webkit-scrollbar {
        width: 4px;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
        background: #222;
    }

        .custom-scroll::-webkit-scrollbar-thumb:hover {
            background: #dc3545;
        }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    window.renderStockChart = (labels, prices) => {
        const canvas = document.getElementById('stockChart');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (window.myChart) { window.myChart.destroy(); }

        const gradient = ctx.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, 'rgba(220, 53, 69, 0.2)');
        gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');

        window.myChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    data: prices,
                    borderColor: '#dc3545',
                    borderWidth: 2,
                    fill: true,
                    backgroundColor: gradient,
                    tension: 0.4,
                    pointRadius: 0,
                    pointHoverRadius: 5,
                    pointHoverBackgroundColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { display: false },
                    y: {
                        position: 'right',
                        ticks: { color: '#444', font: { size: 10 } },
                        grid: { color: 'rgba(255,255,255,0.03)' }
                    }
                }
            }
        });
    };
</script>

@code {
    private ApplicationUser? user;
    private List<Stock>? availableStocks;
    private Stock? selectedStock;
    private Dictionary<int, decimal> _previousPrices = new();
    private decimal orderQuantity = 1;
    private string tradeMessage = "";
    private string searchTerm = "";
    private System.Threading.Timer? _timer;
    private bool _jsInitialized = false;

    private IEnumerable<Stock> FilteredStocks =>
        string.IsNullOrWhiteSpace(searchTerm) ? (availableStocks ?? new()) :
        (availableStocks ?? new()).Where(s => s.Ticker.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || s.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        user = await AuthService.GetCurrentApplicationUser();
        await RefreshMarketData();
        if (availableStocks?.Any() == true) selectedStock = availableStocks.First();

        _timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await RefreshMarketData();
                if (_jsInitialized) await UpdateChart();
                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _jsInitialized = true;
    }

    private async Task RefreshMarketData()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var currentStocks = await db.Stocks.ToListAsync();

        if (availableStocks != null)
        {
            foreach (var old in availableStocks)
            {
                if (!_previousPrices.ContainsKey(old.Id)) _previousPrices[old.Id] = old.CurrentPrice;
                // If price changed, update the tracking for the arrow
                var updated = currentStocks.FirstOrDefault(s => s.Id == old.Id);
                if (updated != null && updated.CurrentPrice != old.CurrentPrice)
                    _previousPrices[old.Id] = old.CurrentPrice;
            }
        }

        availableStocks = currentStocks;
        if (selectedStock != null) selectedStock = availableStocks.FirstOrDefault(s => s.Id == selectedStock.Id);
    }

    private decimal GetTrend(Stock? stock)
    {
        if (stock == null || !_previousPrices.TryGetValue(stock.Id, out var prevPrice) || prevPrice == 0) return 0;
        return ((stock.CurrentPrice - prevPrice) / prevPrice) * 100;
    }

    private async Task SelectStock(Stock stock)
    {
        selectedStock = stock;
        await UpdateChart();
    }

    private async Task HandleBuy()
    {
        var result = await StockService.ExecuteTradeAsync(user?.Id, selectedStock!.Id, orderQuantity, true);
        tradeMessage = result.Message;
    }

    private async Task UpdateChart()
    {
        if (selectedStock == null) return;
        using var db = await DbFactory.CreateDbContextAsync();
        var history = await db.StockHistory
            .Where(h => h.StockId == selectedStock.Id)
            .OrderByDescending(h => h.Timestamp).Take(40).OrderBy(h => h.Timestamp).ToListAsync();

        if (history.Any())
        {
            var labels = history.Select(h => h.Timestamp.ToString("HH:mm:ss")).ToArray();
            var prices = history.Select(h => h.Price).ToArray();
            try { await JS.InvokeVoidAsync("renderStockChart", labels, prices); } catch { }
        }
    }

    public void Dispose() => _timer?.Dispose();
}