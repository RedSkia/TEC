@page "/market"
@using BankApp.Data.Entities.Auth
@using BankApp.Data.Entities.Market
@using BankApp.Data.Entities.Banking
@using BankApp.Services
@using Microsoft.EntityFrameworkCore
@using BlazorApp.Components.Elements
@rendermode InteractiveServer

@inject IdentityService IdentityService
@inject StockMarketService MarketService
@inject IDbContextFactory<BankApp.Data.BankAppDbContext> DbFactory
@inject NavigationManager Nav
@implements IDisposable

<div class="market-container bg-black min-vh-100">
    @if (availableStocks == null)
    {
        <div class="d-flex justify-content-center align-items-center" style="height: 90vh;">
            <div class="spinner-border text-danger" style="width: 3rem; height: 3rem;" role="status"></div>
        </div>
    }
    else
    {
        <div class="container-fluid py-3">
            <div class="row g-3">
                <div class="col-xl-3 col-lg-4">
                    <div class="glass-panel d-flex flex-column h-100 overflow-hidden">
                        <div class="p-3 border-bottom border-secondary border-opacity-10 bg-dark-base">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="text-white fw-black small text-uppercase m-0 tracking-wider">Market Assets</h6>
                                <span class="badge bg-danger pulse-red">LIVE</span>
                            </div>
                            <div class="position-relative">
                                <input type="text" @bind="searchTerm" @bind:event="oninput"
                                       class="form-control search-input ps-4" placeholder="Search ticker..." />
                                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-2 text-secondary small"></i>
                            </div>
                        </div>

                        <div class="list-group list-group-flush custom-scroll flex-grow-1" style="max-height: 75vh; overflow-y: auto;">
                            @foreach (var stock in FilteredStocks)
                            {
                                var changePercent = ((stock.CurrentPrice % 1.5m) - 0.75m);
                                var isPositive = changePercent >= 0;

                                <button @onclick="() => SelectStock(stock)"
                                        class="stock-card @(selectedStock?.Id == stock.Id ? "active" : "")">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="ticker-text">@stock.Ticker</div>
                                            <div class="text-secondary tiny-caps">@stock.Name</div>
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-bold text-white">@FormatCurrency(GetConvertedPrice(stock.CurrentPrice))</div>
                                            <div class="small @(isPositive ? "text-success" : "text-danger")">
                                                @(isPositive ? "▲" : "▼") @Math.Abs(changePercent).ToString("P2")
                                            </div>
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-xl-6 col-lg-8">
                    <div class="glass-panel p-4 h-100">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <div class="badge bg-secondary bg-opacity-10 text-secondary mb-1">EQUITY / USD</div>
                                <h1 class="display-5 fw-black text-white mb-0 tracking-tighter">@selectedStock?.Ticker</h1>
                                <p class="text-danger small fw-bold tracking-widest opacity-75">INTERACTIVE TERMINAL v2.0</p>
                            </div>
                            <div class="text-end">
                                <div class="text-secondary tiny-caps fw-bold">@(hoverPrice > 0 ? "QUERY PRICE" : "MARKET PRICE")</div>
                                <h2 class="fw-black @(hoverPrice > 0 ? "text-info" : "text-white") m-0 tracking-tighter transition-all">
                                    @FormatCurrency(GetConvertedPrice(hoverPrice > 0 ? hoverPrice : (selectedStock?.CurrentPrice ?? 0)))
                                </h2>
                            </div>
                        </div>

                        <div class="graph-wrapper bg-dark-base rounded-2 border border-secondary border-opacity-10"
                             style="height: 500px; position: relative;" @onmouseleave="() => hoverPrice = 0">
                            @if (candles.Any())
                            {
                                <svg viewBox="0 0 1000 500" preserveAspectRatio="none" style="width: 100%; height: 100%;">
                                    @for (int i = 0; i <= 5; i++)
                                    {
                                        var y = i * 100;
                                        <line x1="0" y1="@y" x2="1000" y2="@y" stroke="#1a1a1a" stroke-width="1" />
                                    }

                                    @foreach (var c in candles)
                                    {
                                        <rect x="@(c.X - 8)" y="@(500 - (c.VolumeHeight * 1.5f))" width="16" height="@(c.VolumeHeight * 1.5f)"
                                              fill="@(c.IsUp ? "#19875411" : "#dc354511")" />
                                    }

                                    @foreach (var c in candles)
                                    {
                                        <line x1="@c.X" y1="@c.HighY" x2="@c.X" y2="@c.LowY" stroke="@(c.IsUp ? "#198754" : "#dc3545")" stroke-width="1" />
                                        <rect x="@(c.X - 5)" y="@Math.Min(c.OpenY, c.CloseY)" width="10" height="@Math.Max(3, Math.Abs(c.OpenY - c.CloseY))"
                                              fill="@(c.IsUp ? "#198754" : "#dc3545")" rx="1" />

                                        @if (c.TradeType != null)
                                        {
                                            <g class="fade-in">
                                                <rect x="@(c.X - 25)" y="@(c.HighY - 35)" width="50" height="20" rx="4" fill="@(c.TradeType == "BUY" ? "#198754" : "#dc3545")" />
                                                <text x="@c.X" y="@(c.HighY - 21)" fill="white" font-size="10" font-weight="900" text-anchor="middle">@c.TradeType</text>
                                            </g>
                                        }
                                    }

                                    @foreach (var c in candles)
                                    {
                                        <rect x="@(c.X - 10)" y="0" width="20" height="500" fill="transparent" style="cursor: crosshair;" @onmouseover="() => hoverPrice = c.Price" />
                                        @if (hoverPrice == c.Price)
                                        {
                                            <line x1="0" y1="@c.CloseY" x2="1000" y2="@c.CloseY" stroke="#0dcaf0" stroke-width="1" stroke-dasharray="4" />
                                            <circle cx="@c.X" cy="@c.CloseY" r="5" fill="#0dcaf0" />
                                        }
                                    }
                                </svg>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-xl-3">
                    <div class="glass-panel p-4 mb-3 border-top border-4 @(user == null ? "border-secondary" : "border-danger")">
                        @if (user == null)
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-lock-fill text-secondary mb-3 d-block" style="font-size: 2.5rem;"></i>
                                <h6 class="text-white fw-bold mb-3">AUTH REQUIRED</h6>
                                <button class="btn btn-danger w-100 rounded-pill fw-black btn-sm" @onclick='() => Nav.NavigateTo("/login")'>SIGN IN TO TRADE</button>
                            </div>
                        }
                        else
                        {
                            <h6 class="text-white fw-black small text-uppercase mb-4 opacity-50">Execution Engine</h6>

                            <div class="mb-4">
                                <label class="text-secondary tiny-caps mb-2 d-flex justify-content-between">
                                    <span>Positions</span>
                                    <span class="text-white">@ownedQuantity.ToString("N2") Units</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-black border-secondary border-opacity-25 text-secondary">QTY</span>
                                    <input type="number" step="0.01" @bind="orderQuantity" @bind:event="oninput"
                                           class="form-control trade-input text-center" />
                                </div>
                                <div class="text-end mt-2">
                                    <small class="text-secondary tiny-caps">EST. VALUE</small>
                                    <div class="text-danger fw-black h5 m-0">@FormatCurrency(GetConvertedPrice(selectedStock?.CurrentPrice ?? 0) * orderQuantity)</div>
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6"><button @onclick="() => HandleTrade(true)" class="btn btn-success w-100 fw-black py-3 border-0 shadow-lg">BUY</button></div>
                                <div class="col-6"><button @onclick="() => HandleTrade(false)" class="btn btn-danger w-100 fw-black py-3 border-0 shadow-lg">SELL</button></div>
                            </div>
                            <div class="row g-2">
                                <div class="col-6"><button @onclick="ExecuteBuyMax" class="btn btn-outline-secondary w-100 fw-bold tiny-caps py-2">MAX BUY</button></div>
                                <div class="col-6"><button @onclick="ExecuteSellAll" class="btn btn-outline-secondary w-100 fw-bold tiny-caps py-2">LIQUIDATE</button></div>
                            </div>
                        }
                    </div>

                    @if (user?.BankAccount != null)
                    {
                        <div class="glass-panel p-3 bg-gradient-dark">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0 bg-danger bg-opacity-10 p-2 rounded-2 me-3">
                                    <i class="bi bi-wallet2 text-danger h4 m-0"></i>
                                </div>
                                <div>
                                    <small class="text-secondary tiny-caps d-block">Available Liquidity</small>
                                    <h4 class="text-white fw-black m-0">@FormatCurrency(user.BankAccount.Balance)</h4>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .market-container {
        color: #e0e0e0;
        font-family: 'Inter', sans-serif;
    }

    .bg-dark-base {
        background: #050505;
    }

    .glass-panel {
        background: #0c0c0c;
        border: 1px solid #1f1f1f;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    .fw-black {
        font-weight: 900;
    }

    .tracking-tighter {
        letter-spacing: -2px;
    }

    .tracking-wider {
        letter-spacing: 2px;
    }

    .ticker-text {
        font-weight: 800;
        color: white;
        font-size: 1.2rem;
        line-height: 1;
    }

    .search-input {
        background: #111;
        border: 1px solid #222;
        color: white;
        border-radius: 6px;
        font-size: 0.85rem;
        transition: border-color 0.3s;
    }

        .search-input:focus {
            background: #151515;
            border-color: #dc3545;
            box-shadow: none;
            color: white;
        }

    .stock-card {
        background: transparent;
        border: none;
        width: 100%;
        padding: 18px 20px;
        border-bottom: 1px solid #151515;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .stock-card:hover {
            background: #121212;
            padding-left: 25px;
        }

        .stock-card.active {
            background: #1a1a1a;
            border-left: 5px solid #dc3545;
            box-shadow: inset 10px 0 20px rgba(220, 53, 69, 0.1);
        }

    .trade-input {
        background: #000;
        border: 1px solid #333;
        color: white;
        font-weight: 800;
        font-size: 1.2rem;
    }

        .trade-input:focus {
            background: #000;
            border-color: #dc3545;
            color: white;
            box-shadow: none;
        }

    .pulse-red {
        animation: pulseR 2s infinite;
        font-size: 10px;
        font-weight: 900;
        vertical-align: middle;
    }

    @@keyframes pulseR {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.5;
            transform: scale(0.95);
        }
    }

    .tiny-caps {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: 700;
    }

    .custom-scroll::-webkit-scrollbar {
        width: 3px;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 10px;
    }

    .transition-all {
        transition: all 0.2s ease;
    }

    .fade-in {
        animation: fadeIn 0.3s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>

@code {
    // Logic remains exactly as your original, but ensure GetCurrentUserAsync
    // is called in OnAfterRenderAsync to avoid the spinner trap if needed.
    // (Kept original logic for brevity as requested)

    [CascadingParameter] public Toast? Toast { get; set; }

    private ApplicationUser? user;
    private List<Stock>? availableStocks;
    private Stock? selectedStock;
    private decimal orderQuantity = 1;
    private decimal ownedQuantity = 0;
    private decimal hoverPrice = 0;
    private string searchTerm = "";
    private System.Threading.Timer? _timer;
    private List<CandleModel> candles = new();
    private Dictionary<long, string> tradeHistoryMarkers = new();

    private IEnumerable<Stock> FilteredStocks => (availableStocks ?? new()).Where(s => string.IsNullOrEmpty(searchTerm) || s.Ticker.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        user = await IdentityService.GetCurrentUserAsync();
        await RefreshMarketData();
        if (availableStocks?.Any() == true) selectedStock = availableStocks.First();
        await BuildGraph();

        // Subscribe to the service event
        MarketService.OnMarketUpdated += RefreshUI;
    }

    // This runs whenever the background service finishes an update
    private async void RefreshUI()
    {
        await InvokeAsync(async () =>
        {
            await RefreshMarketData();
            await BuildGraph();
            StateHasChanged();
        });
    }

    private async Task RefreshMarketData()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        availableStocks = await db.Stocks.AsNoTracking().ToListAsync();

        if (selectedStock != null)
        {
            selectedStock = availableStocks.FirstOrDefault(s => s.Id == selectedStock.Id);
            if (user?.BankAccount != null)
            {
                var inv = await db.Investments.AsNoTracking()
                    .FirstOrDefaultAsync(i => i.BankAccountId == user.BankAccount.Id && i.StockId == selectedStock.Id);
                ownedQuantity = inv?.Quantity ?? 0;
            }
        }
    }

    private string FormatCurrency(decimal amount) => $"{(user?.BankAccount?.CurrencyType?.CurrencySymbol ?? "$")}{amount:N2}";

    private async Task BuildGraph()
    {
        if (selectedStock == null) return;
        using var db = await DbFactory.CreateDbContextAsync();
        var history = await db.StockHistory.AsNoTracking()
            .Where(h => h.StockId == selectedStock.Id)
            .OrderByDescending(h => h.Timestamp).Take(40).OrderBy(h => h.Timestamp).ToListAsync();

        if (history.Count < 2) return;

        decimal minPrice = history.Min(h => h.Price);
        decimal maxPrice = history.Max(h => h.Price);
        decimal range = (maxPrice - minPrice) == 0 ? 1 : (maxPrice - minPrice) * 1.5m;
        decimal baseline = minPrice - (range * 0.2m);

        candles.Clear();
        float step = 1000f / history.Count;
        Random rng = new();

        for (int i = 0; i < history.Count; i++)
        {
            var current = history[i].Price;
            var prev = i == 0 ? current : history[i - 1].Price;
            decimal vol = range * 0.05m;
            candles.Add(new CandleModel
            {
                Id = history[i].Id,
                X = i * step + (step / 2),
                OpenY = Map(prev, baseline, range),
                CloseY = Map(current, baseline, range),
                HighY = Map(Math.Max(current, prev) + (decimal)rng.NextDouble() * vol, baseline, range),
                LowY = Map(Math.Min(current, prev) - (decimal)rng.NextDouble() * vol, baseline, range),
                IsUp = current >= prev,
                Price = current,
                VolumeHeight = rng.Next(30, 80),
                TradeType = tradeHistoryMarkers.GetValueOrDefault(history[i].Id)
            });
        }
    }

    private float Map(decimal val, decimal min, decimal range) => 400 - (float)((val - min) / range * 350);
    private string GetTrendPoints() => string.Join(" ", candles.Select(c => $"{c.X},{c.CloseY}"));

    private async Task HandleTrade(bool isBuy)
    {
        if (user == null || selectedStock == null || orderQuantity <= 0) return;

        var (success, msg) = await MarketService.ExecuteTrade(user.Id, selectedStock.Id, orderQuantity, isBuy);

        if (success)
        {
            Toast?.Show(msg, Toast.ToastLevel.Success);
            using var db = await DbFactory.CreateDbContextAsync();
            var last = await db.StockHistory.Where(h => h.StockId == selectedStock.Id).OrderByDescending(h => h.Timestamp).FirstOrDefaultAsync();
            if (last != null) tradeHistoryMarkers[last.Id] = isBuy ? "BUY" : "SELL";

            user = await IdentityService.GetCurrentUserAsync();
            await RefreshMarketData();
            await BuildGraph();
        }
        else { Toast?.Show(msg, Toast.ToastLevel.Error); }
    }

    private async Task ExecuteBuyMax()
    {
        if (selectedStock != null && user?.BankAccount != null)
        {
            decimal p = GetConvertedPrice(selectedStock.CurrentPrice);
            orderQuantity = p > 0 ? Math.Floor((user.BankAccount.Balance / p) * 100m) / 100m : 0;
            if (orderQuantity > 0) await HandleTrade(true);
        }
    }

    private async Task ExecuteSellAll() { orderQuantity = ownedQuantity; if (orderQuantity > 0) await HandleTrade(false); }
    private decimal GetConvertedPrice(decimal p) => user?.BankAccount?.CurrencyType == null ? p : p * user.BankAccount.CurrencyType.Rate;
    public void Dispose()
    {
        // Unsubscribe to prevent memory leaks!
        MarketService.OnMarketUpdated -= RefreshUI;
        _timer?.Dispose();
    }
    private async Task SelectStock(Stock stock) { selectedStock = stock; tradeHistoryMarkers.Clear(); await BuildGraph(); }

    public class CandleModel
    {
        public long Id; public float X, OpenY, CloseY, HighY, LowY, VolumeHeight;
        public bool IsUp; public decimal Price; public string? TradeType;
    }
}