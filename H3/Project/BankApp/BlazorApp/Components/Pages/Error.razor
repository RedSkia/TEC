@page "/error"
@page "/error/{StatusCode:int}"
@layout BlazorApp.Components.Layout.MainLayout
@inject NavigationManager Nav

<PageTitle>@Title | RedSkia Security</PageTitle>

<div class="container min-vh-100 d-flex align-items-center justify-content-center">
    <div class="text-center position-relative">

        @* Background Ghost Code *@
        <h1 class="position-absolute top-50 start-50 translate-middle fw-black text-white opacity-05"
            style="font-size: clamp(8rem, 25vw, 18rem); z-index: 1; letter-spacing: -10px; pointer-events: none;">
            @DisplayCode
        </h1>

        <div class="card bg-dark border-white border-opacity-10 p-5 shadow-2xl position-relative"
             style="z-index: 2; max-width: 650px; backdrop-filter: blur(15px); border-radius: 2rem;">

            <div class="mb-4">
                <div class="bg-danger bg-opacity-10 d-inline-flex p-4 rounded-circle border border-danger border-opacity-25 shadow-sm">
                    <i class="bi @Icon text-danger" style="font-size: 3.5rem;"></i>
                </div>
            </div>

            <h2 class="display-6 fw-bold text-white tracking-tight mb-2">@Title</h2>

            <div class="mb-4">
                <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 ls-wide small fw-bold">
                    SECURE_PROTOCOL: @DisplayCode
                </span>
            </div>

            <p class="text-white-50 mx-auto mb-4 lead" style="font-size: 1.1rem;">
                @Description
            </p>

            @if (!string.IsNullOrEmpty(TraceId))
            {
                <div class="bg-black p-3 rounded-3 mb-4 border border-white border-opacity-5">
                    <small class="text-danger fw-bold d-block x-small mb-1 tracking-widest">REFERENCE TRACE</small>
                    <code class="text-white-50 small">@TraceId</code>
                </div>
            }

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                <button class="btn btn-danger rounded-pill px-5 py-3 fw-bold shadow-lg transition-all"
                        @onclick='() => Nav.NavigateTo("/")'>
                    <i class="bi bi-shield-lock me-2"></i>RE-INITIALIZE
                </button>
                <button class="btn btn-outline-light rounded-pill px-5 py-3 fw-bold opacity-50 transition-all hover-opacity-100"
                        onclick="history.back()">
                    BACK TO SECTOR
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? StatusCode { get; set; }

    // Catch-all for general exceptions if passed via Query String or internal state
    [SupplyParameterFromQuery] public string? Message { get; set; }

    private string Title => StatusCode switch
    {
        404 => "COORDINATES UNKNOWN",
        403 => "ACCESS RESTRICTED",
        401 => "IDENTITY UNVERIFIED",
        _ => "PROTOCOL EXCEPTION"
    };

    private string Description => StatusCode switch
    {
        404 => "The requested terminal address does not exist within the RedSkia network.",
        403 => "Your credentials lack the clearance required for this secure sector.",
        401 => "Session expired or identity not verified. Please re-authenticate.",
        _ => Message ?? "An internal system breach or protocol error has interrupted your session."
    };

    private string Icon => StatusCode switch
    {
        404 => "bi-geo-alt-fill",
        403 => "bi-shield-slash-fill",
        401 => "bi-person-badge-fill",
        _ => "bi-exclamation-triangle-fill"
    };

    private string DisplayCode => StatusCode?.ToString() ?? "500";
    private string? TraceId { get; set; }

    protected override void OnInitialized()
    {
        TraceId = Activity.Current?.Id ?? Guid.NewGuid().ToString();
    }
}