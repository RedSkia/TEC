<Router AppAssembly="@typeof(Program).Assembly">

    <Found Context="routeData">

        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(BlazorApp.Components.Layout.MainLayout)">

            <NotAuthorized>
                <p>Access denied.</p>
            </NotAuthorized>

            <Authorizing>
                <div class="vh-100 d-flex flex-column align-items-center justify-content-center bg-black text-white">
                    <div class="spinner-border text-danger mb-3" style="width:3rem;height:3rem"></div>
                    <h5 class="fw-bold opacity-50">ENCRYPTING SESSION...</h5>
                </div>
            </Authorizing>

        </AuthorizeRouteView>

        <FocusOnNavigate RouteData="@routeData" Selector="h1" />

    </Found>

    <NotFound>
        <LayoutView Layout="@typeof(BlazorApp.Components.Layout.MainLayout)">
            <div class="text-white p-5 text-center">
                <h1>404</h1>
                <p>Vault entry denied. Resource not found.</p>
            </div>
        </LayoutView>
    </NotFound>

</Router>