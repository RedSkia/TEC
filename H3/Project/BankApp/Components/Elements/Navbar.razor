@using Microsoft.AspNetCore.Components.Authorization
@using BankApp.Services
@using System.Security.Claims
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<header class="p-3 mb-4 border-bottom bg-white shadow-sm sticky-top">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between">

            @* BRANDING *@
            <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 text-decoration-none">
                <h2 class="fw-bold text-primary mb-0">Bank<span class="text-dark">App</span></h2>
            </a>

            @* DYNAMIC NAVIGATION *@
            <div class="d-flex align-items-center">
                <AuthorizeView>
                    <Authorized>
                        @* Navigation Links *@
                        <ul class="nav me-4 d-none d-md-flex">
                            <li><a href="/dashboard" class="nav-link px-3 link-dark fw-medium">Dashboard</a></li>
                            <li><a href="/transfer" class="nav-link px-3 link-dark fw-medium">Transfer</a></li>

                            @* Role-Based Link: Only visible to Staff *@
                            @if (context.User.IsInRole("LoanOfficer"))
                            {
                                <li><a href="/staff/loans" class="nav-link px-3 text-primary fw-bold">Staff Panel</a></li>
                            }

                            <li><a href="/profile" class="nav-link px-3 link-dark fw-medium">My Profile</a></li>
                        </ul>

                        @* User Dropdown *@
                        <div class="dropdown">
                            <button class="btn btn-light border dropdown-toggle d-flex align-items-center gap-2"
                                    type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 32px; height: 32px;">
                                    @(context.User.Identity?.Name?[..1].ToUpper() ?? "U")
                                </div>
                                <div class="text-start me-1">
                                    <span class="fw-semibold d-block lh-1">@context.User.Identity?.Name</span>
                                    <small class="text-muted" style="font-size: 0.7rem;">
                                        @context.User.FindFirst(ClaimTypes.Role)?.Value
                                    </small>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userMenu">
                                <li class="px-3 py-2 border-bottom">
                                    <small class="text-muted d-block">Signed in as</small>
                                    <p class="fw-bold text-truncate mb-0">@context.User.Identity?.Name</p>
                                </li>
                                <li><a class="dropdown-item py-2" href="/profile"><i class="bi bi-person me-2"></i>Settings</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item text-danger py-2" @onclick="HandleLogout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Sign out
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </Authorized>

                    <NotAuthorized>
                        <div class="text-end">
                            <a href="/login" class="btn btn-outline-primary me-2 px-4 border-2 fw-bold">Login</a>
                            <a href="/register" class="btn btn-primary px-4 fw-bold">Open Account</a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="text-center mt-4 pb-2 animate-fade-in">
                <h3 class="fw-bold text-dark">@Title</h3>
                <p class="text-muted lead fs-6">@Subtitle</p>
            </div>
        }
    </div>
</header>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }

    private async Task HandleLogout()
    {
        // Use your custom provider to clear the token
        if (AuthStateProvider is JwtAuthStateProvider jwtProvider)
        {
            await jwtProvider.NotifyUserLogout();
            Nav.NavigateTo("/login", forceLoad: true);
        }
    }
}