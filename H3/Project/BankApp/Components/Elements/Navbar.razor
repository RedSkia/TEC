@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IJSRuntime JS

<header class="p-3 mb-4 border-bottom bg-white shadow-sm">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between">
            
            @* BRANDING *@
            <a href="/" class="d-flex align-items-center mb-2 mb-lg-0 text-decoration-none">
                <h2 class="fw-bold text-primary mb-0">Bank<span class="text-dark">App</span></h2>
            </a>

            @* DYNAMIC NAVIGATION *@
            <div class="d-flex align-items-center">
                <AuthorizeView>
                    <Authorized>
                        @* Visible only when Logged In *@
                        <ul class="nav me-3">
                            <li><a href="/dashboard" class="nav-link px-2 link-secondary">Dashboard</a></li>
                            <li><a href="/transfer" class="nav-link px-2 link-dark">Transfer</a></li>
                            <li><a href="/profile" class="nav-link px-2 link-dark">My Profile</a></li>
                        </ul>

                        <div class="dropdown text-end">
                            <button class="btn btn-outline-primary dropdown-toggle" id="userMenu" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i> @context.User.Identity?.Name
                            </button>
                            <ul class="dropdown-menu text-small shadow">
                                <li><button class="dropdown-item text-danger" @onclick="HandleLogout">Sign out</button></li>
                            </ul>
                        </div>
                    </Authorized>
                    
                    <NotAuthorized>
                        @* Visible only when Logged Out *@
                        <div class="text-end">
                            <a href="/login" class="btn btn-outline-primary me-2">Login</a>
                            <a href="/register" class="btn btn-primary">Sign-up</a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
        
        @* YOUR ORIGINAL HEADER LOGIC (Optional: displayed on specific pages) *@
        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="text-center mt-4">
                <h4 class="mt-2 fw-bold">@Title</h4>
                <p class="text-muted">@Subtitle</p>
            </div>
        }
    </div>
</header>

