@page "/market"
@using BankApp.Data.Entities.Auth
@using BankApp.Data.Entities.Market
@using BankApp.Data.Entities.Banking
@using BankApp.Services
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject BankApp.Data.BankAppDbContext DbContext
@inject IJSRuntime JS

<div class="container-fluid bg-dark min-vh-100 text-white py-4">
    <div class="container">
        @if (user == null || availableStocks == null)
        {
            <div class="d-flex justify-content-center align-items-center" style="height: 80vh;">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @* --- 1. WATCHLIST (LEFT) --- *@
                <div class="col-lg-3">
                    <div class="card bg-secondary bg-opacity-10 border-secondary h-100">
                        <div class="card-header border-secondary bg-transparent">
                            <h6 class="mb-0 fw-bold"><i class="bi bi-list-ul me-2"></i>Market Watch</h6>
                        </div>
                        <div class="list-group list-group-flush overflow-auto" style="max-height: 700px;">
                            @foreach (var stock in availableStocks)
                            {
                                <button @onclick="() => SelectStock(stock)"
                                        class="list-group-item list-group-item-action bg-transparent text-white border-secondary @(selectedStock?.Id == stock.Id ? "bg-primary bg-opacity-25" : "")">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold">@stock.Ticker</div>
                                            <small class="text-muted">@stock.Name</small>
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-bold">@stock.CurrentPrice.ToString("N2")</div>
                                            <small class="text-success small">+0.5%</small>
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                </div>

                @* --- 2. CHART & DATA (CENTER) --- *@
                <div class="col-lg-6">
                    <div class="card bg-secondary bg-opacity-10 border-secondary mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div>
                                    <h3 class="mb-0 fw-bold">@selectedStock?.Ticker <span class="fs-6 fw-light text-muted">/ USD</span></h3>
                                    <h4 class="text-success fw-bold mb-0">@selectedStock?.CurrentPrice.ToString("C2")</h4>
                                </div>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary active">1D</button>
                                    <button class="btn btn-outline-secondary">1W</button>
                                    <button class="btn btn-outline-secondary">1M</button>
                                </div>
                            </div>

                            @* Chart Placeholder *@
                            <div style="height: 350px; background: linear-gradient(to bottom, #1e1e1e, #121212); position: relative;" class="rounded border border-secondary d-flex align-items-center justify-content-center">
                                <canvas id="stockChart"></canvas>
                                @if (selectedStock == null)
                                {
                                    <div class="text-muted">Select a stock to view performance</div>
                                }
                            </div>
                        </div>
                    </div>

                    @* STATS GRID *@
                    <div class="row g-2">
                        <div class="col-4">
                            <div class="card bg-secondary bg-opacity-10 border-secondary p-3 text-center">
                                <small class="text-muted d-block">Market Cap</small>
                                <span class="fw-bold">2.8T</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="card bg-secondary bg-opacity-10 border-secondary p-3 text-center">
                                <small class="text-muted d-block">P/E Ratio</small>
                                <span class="fw-bold">28.4</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="card bg-secondary bg-opacity-10 border-secondary p-3 text-center">
                                <small class="text-muted d-block">Dividend</small>
                                <span class="fw-bold">0.65%</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- 3. EXECUTION PANEL (RIGHT) --- *@
                <div class="col-lg-3">
                    <div class="card bg-secondary bg-opacity-10 border-secondary mb-3">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3 text-uppercase small text-muted">Execution</h6>
                            <div class="mb-3">
                                <label class="small text-muted">Quantity</label>
                                <input type="number" @bind="orderQuantity" class="form-control bg-dark text-white border-secondary" placeholder="0.00" />
                            </div>
                            <div class="mb-3">
                                <label class="small text-muted">Estimated Total</label>
                                <h4 class="fw-bold">@((orderQuantity * (selectedStock?.CurrentPrice ?? 0)).ToString("C2"))</h4>
                            </div>
                            <button class="btn btn-success w-100 fw-bold mb-2 py-3" disabled="@(selectedStock == null)">BUY @selectedStock?.Ticker</button>
                            <button class="btn btn-outline-danger w-100 fw-bold py-2" disabled="@(selectedStock == null)">SELL</button>
                        </div>
                    </div>

                    @* PORTFOLIO SUMMARY *@
                    <div class="card bg-primary bg-opacity-10 border-primary border-opacity-25">
                        <div class="card-body">
                            <h6 class="small text-uppercase text-primary fw-bold">Buying Power</h6>
                            <h4 class="fw-bold mb-0">@user.BankAccounts.FirstOrDefault()?.Balance.ToString("C2")</h4>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    window.renderStockChart = (data) => {
        const ctx = document.getElementById('stockChart').getContext('2d');
        if (window.myChart) { window.myChart.destroy(); }
        window.myChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['9:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00'],
                datasets: [{
                    label: 'Price',
                    data: data,
                    borderColor: '#00ff88',
                    backgroundColor: 'rgba(0, 255, 136, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointRadius: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { grid: { color: 'rgba(255,255,255,0.1)' } }
                }
            }
        });
    }
</script>

@code {
    private ApplicationUser? user;
    private List<Stock>? availableStocks;
    private Stock? selectedStock;
    private decimal orderQuantity = 1;

    protected override async Task OnInitializedAsync()
    {
        user = await AuthService.GetCurrentUser();
        availableStocks = await DbContext.Stocks.ToListAsync();
        if (availableStocks.Any()) selectedStock = availableStocks.First();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (selectedStock != null)
        {
            await GenerateChart();
        }
    }

    private async Task SelectStock(Stock stock)
    {
        selectedStock = stock;
        await GenerateChart();
    }

    private async Task GenerateChart()
    {
        // Generate random-ish data for the chart effect
        var random = new Random();
        var basePrice = (double)selectedStock.CurrentPrice;
        var mockData = Enumerable.Range(0, 7)
            .Select(_ => basePrice + (random.NextDouble() * 10 - 5))
            .ToArray();

        await JS.InvokeVoidAsync("renderStockChart", mockData);
    }
}