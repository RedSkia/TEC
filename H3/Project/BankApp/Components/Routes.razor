@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(BankApp.Components.Layout.MainLayout)">
            <NotAuthorized>
                @{
                    // Auto-redirect to login
                    Nav.NavigateTo("login");
                }
            </NotAuthorized>
            <Authorizing>
                <div class="text-center p-5">
                    <div class="spinner-border text-primary"></div>
                    <p>Validating session...</p>
                </div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(BankApp.Components.Layout.MainLayout)">
            <p class="p-5">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>