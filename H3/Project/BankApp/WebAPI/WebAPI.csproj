<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>47a7eac3-3519-4c76-be76-1667b3177bd3</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharedCore\SharedCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SharedCore" />
    <Using Include="SharedCore.Data" />
    <Using Include="SharedCore.Entities" />
    <Using Include="SharedCore.Entities.Auth" />
    <Using Include="SharedCore.Entities.Banking" />
    <Using Include="SharedCore.Entities.Lending" />
    <Using Include="SharedCore.Entities.Market" />
    <Using Include="SharedCore.Services" />
  </ItemGroup>

</Project>
