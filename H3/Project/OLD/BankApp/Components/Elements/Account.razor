@page "/account"
@using BankApp.Data.Entities.Auth
@using BankApp.Data.Entities.Banking
@using BankApp.Services
@using System.Security.Claims
@rendermode InteractiveServer
@inject IAuthService AuthService

<div class="container-fluid py-5 bg-light min-vh-100">
    <div class="container">
        @if (user == null)
        {
            <div class="d-flex flex-column align-items-center justify-content-center py-5">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <h5 class="text-muted fw-light">Accessing Secure Vault...</h5>
            </div>
        }
        else
        {
            @* --- HEADER SECTION --- *@
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h1 class="fw-bold mb-0">Welcome back, @user.FullName.Split(' ')[0]!</h1>
                    <p class="text-muted mb-0">Last login: @(user.LoginActivities.OrderByDescending(l => l.LoginTime).Skip(1).FirstOrDefault()?.LoginTime.ToString("MMM dd, HH:mm") ?? "First session")</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-white text-dark shadow-sm border px-3 py-2 rounded-pill">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> Account Secured
                    </span>
                </div>
            </div>

            <div class="row g-4">
                @* --- LEFT COLUMN: FINANCE & CARDS --- *@
                <div class="col-lg-8">

                    @* TOTAL BALANCE CARD *@
                    <div class="card border-0 shadow-sm bg-primary text-white mb-4 overflow-hidden position-relative">
                        <div class="card-body p-4 z-1">
                            <h6 class="text-white-50 text-uppercase small fw-bold">Total Combined Balance</h6>
                            <h1 class="display-4 fw-bold mb-3">@user.BankAccounts.Sum(a => a.Balance).ToString("C2")</h1>
                            <div class="d-flex gap-3">
                                <button class="btn btn-light btn-sm fw-bold px-3">Transfer Funds</button>
                                <button class="btn btn-outline-light btn-sm fw-bold px-3">Send Money</button>
                            </div>
                        </div>
                        @* Subtle background decoration *@
                        <div class="position-absolute end-0 top-0 p-4 opacity-25">
                            <i class="bi bi-wallet2 display-1"></i>
                        </div>
                    </div>

                    @* BANK ACCOUNTS LIST *@
                    <h5 class="fw-bold mb-3">Your Accounts</h5>
                    @foreach (var account in user.BankAccounts)
                    {
                        <div class="card border-0 shadow-sm mb-3 hover-shadow transition">
                            <div class="card-body d-flex align-items-center p-4">
                                <div class="rounded-circle bg-primary-subtle p-3 me-4 text-primary">
                                    <i class="bi bi-piggy-bank fs-4"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-0 fw-bold">Standard Savings</h6>
                                    <code class="text-muted">@account.AccountNumber</code>
                                </div>
                                <div class="text-end">
                                    <h5 class="mb-0 fw-bold">@account.Balance.ToString("C2")</h5>
                                    <span class="text-success small fw-bold"><i class="bi bi-arrow-up-short"></i> +2.4%</span>
                                </div>
                            </div>
                        </div>
                    }

                    @* RECENT TRANSACTIONS *@
                    <div class="card border-0 shadow-sm mt-4">
                        <div class="card-header bg-white py-3">
                            <h6 class="mb-0 fw-bold">Recent Activity</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <tbody class="border-top-0">
                                        @foreach (var tx in user.BankAccounts.SelectMany(a => a.Transactions).OrderByDescending(t => t.CreatedAt).Take(5))
                                        {
                                            <tr>
                                                <td class="ps-4 py-3">
                                                    <div class="rounded-3 bg-light p-2 d-inline-block me-3">
                                                        <i class="bi @(tx.Amount < 0 ? "bi-cart" : "bi-cash-stack") text-dark"></i>
                                                    </div>
                                                    <span class="fw-medium">@tx.Note</span>
                                                </td>
                                                <td class="text-muted small">@tx.CreatedAt.ToString("MMM dd")</td>
                                                <td class="pe-4 text-end fw-bold @(tx.Amount < 0 ? "text-danger" : "text-success")">
                                                    @(tx.Amount < 0 ? "-" : "+") @Math.Abs(tx.Amount).ToString("C2")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- RIGHT COLUMN: PROFILE & SECURITY --- *@
                <div class="col-lg-4">

                    @* PROFILE INFO *@
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4">
                            <div class="text-center mb-4">
                                <div class="bg-dark text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                     style="width: 70px; height: 70px; font-size: 1.5rem; font-weight: bold;">
                                    @(user.FullName[0])
                                </div>
                                <h5 class="fw-bold mb-0">@user.FullName</h5>
                                <p class="text-muted small">@user.Email</p>
                            </div>

                            <div class="mb-3">
                                <label class="text-muted small text-uppercase fw-bold">Primary Address</label>
                                <p class="mb-0 fw-medium">
                                    @* @user.Address.Street<br /> *@
                                    @* @user.Address.City, @user.Address.ZipCode *@
                                </p>
                            </div>

                            <button class="btn btn-outline-primary btn-sm w-100 fw-bold py-2">Update Profile</button>
                        </div>
                    </div>

                    @* SECURITY LOG *@
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3">
                            <h6 class="mb-0 fw-bold">Security Log</h6>
                        </div>
                        <div class="card-body p-0">
                            @foreach (var login in user.LoginActivities.OrderByDescending(l => l.LoginTime).Take(3))
                            {
                                <div class="d-flex align-items-start p-3 border-bottom">
                                    <div class="me-3 mt-1">
                                        <i class="bi bi-laptop fs-5 text-muted"></i>
                                    </div>
                                    <div>
                                        <p class="mb-0 small fw-bold">@login.IpAddress</p>
                                        <p class="mb-0 smaller text-muted" style="font-size: 0.75rem;">@login.LoginTime.ToString("g")</p>
                                        <span class="badge @(login.Status == LoginStatus.Success ? "bg-success" : "bg-danger")" style="font-size: 0.6rem;">@login.Status</span>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-white text-center py-2">
                            <a href="#" class="small text-decoration-none">View All Activity</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .transition {
        transition: all 0.3s ease;
    }

    .hover-shadow:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.08) !important;
        cursor: pointer;
    }

    .smaller {
        font-size: 0.8rem;
    }

    .animate-fade-in {
        animation: fadeIn 0.5s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@code {
    private ApplicationUser? user;

    protected override async Task OnInitializedAsync()
    {
        user = await AuthService.GetCurrentApplicationUser();
    }
}