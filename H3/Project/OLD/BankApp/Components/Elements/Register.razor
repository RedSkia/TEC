@page "/register"
@using BankApp.Data.Entities.Auth
@using BankApp.Services
@inject IAuthService AuthService
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <InputForm Model="user" OnSubmit="HandleRegister" ButtonText="Create Account" IsLoading="busy">
                <HeaderContent>
                    <h3 class="fw-bold text-center">Open Account</h3>
                    <p class="text-center text-muted small">Join BankApp as a new Customer</p>
                    @if (error != null)
                    {
                        <div class="alert alert-danger py-2 small">@error</div>
                    }
                </HeaderContent>

                <ChildContent>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Full Name</label>
                        <InputText @bind-Value="user.FullName" class="form-control" placeholder="John Doe" />
                        <ValidationMessage For="@(() => user.FullName)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Username</label>
                        <InputText @bind-Value="user.UserName" class="form-control" placeholder="viking_banker" />
                        <ValidationMessage For="@(() => user.UserName)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Email</label>
                        <InputText @bind-Value="user.Email" class="form-control" placeholder="name@bank.com" />
                        <ValidationMessage For="@(() => user.Email)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Password</label>
                        <InputText @bind-Value="password" type="password" class="form-control" placeholder="••••••••" />
                    </div>
                </ChildContent>
            </InputForm>

            <div class="text-center mt-3">
                <a href="/login" class="small text-muted text-decoration-none">Already have an account? <b>Login</b></a>
            </div>
        </div>
    </div>
</div>

@code {
    private ApplicationUser user = new();
    private string password = "";
    private bool busy;
    private string? error;

    async Task HandleRegister()
    {
        busy = true;
        error = null;

        try
        {
            // VIKING FIX: Hardcode the role to Customer here.
            // Only Admins will have a separate UI/Method to create LoanOfficers.
            var identityErrors = await AuthService.Register(
                user.Email!,
                password,
                user.FullName,
                RoleType.Customer,
                user.UserName!
            );

            if (identityErrors == null)
            {
                Nav.NavigateTo("/login");
            }
            else
            {
                error = string.Join(" ", identityErrors);
            }
        }
        catch (Exception)
        {
            error = "An unexpected error occurred.";
        }
        finally
        {
            busy = false;
        }
    }
}