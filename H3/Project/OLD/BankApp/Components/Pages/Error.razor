@page "/error"
@page "/error/{StatusCode:int}"
@layout BankApp.Components.Layout.MainLayout
@inject NavigationManager Nav
@using System.Diagnostics

<PageTitle>@Title | RedSkia Security</PageTitle>

<div class="container min-vh-100 d-flex align-items-center justify-content-center animate-fade-in">
    <div class="text-center position-relative">

        @* Background Ghost Code *@
        <h1 class="position-absolute top-50 start-50 translate-middle fw-black text-white opacity-05"
            style="font-size: clamp(8rem, 25vw, 18rem); z-index: 1; letter-spacing: -10px; pointer-events: none;">
            @DisplayCode
        </h1>

        <div class="card bg-dark border-white border-opacity-10 p-5 shadow-2xl position-relative" style="z-index: 2; max-width: 650px; backdrop-filter: blur(10px);">
            <div class="mb-4">
                <div class="bg-danger bg-opacity-10 d-inline-flex p-4 rounded-circle border border-danger border-opacity-25">
                    <i class="bi @Icon text-danger" style="font-size: 3.5rem;"></i>
                </div>
            </div>

            <h2 class="display-5 fw-bold text-white tracking-tight mb-2">@Title</h2>

            <div class="mb-4">
                <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 ls-wide small fw-bold">
                    SECURE_PROTOCOL: @DisplayCode
                </span>
            </div>

            <p class="text-white-50 mx-auto mb-4 lead">
                @Description
            </p>

            @if (!string.IsNullOrEmpty(RequestId))
            {
                <div class="bg-black p-2 rounded-3 mb-4 border border-white border-opacity-5">
                    <small class="text-danger fw-bold d-block x-small mb-1">REFERENCE TRACE</small>
                    <code class="text-white opacity-50 small">@RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center gap-3">
                <button class="btn btn-primary rounded-pill px-5 py-3 fw-bold shadow-lg transition-all"
                        @onclick='() => Nav.NavigateTo("/")'>
                    <i class="bi bi-shield-check me-2"></i>RE-INITIALIZE
                </button>
                <button class="btn btn-outline-light rounded-pill px-5 py-3 fw-bold opacity-50 transition-all"
                        onclick="history.back()">
                    BACK TO SECTOR
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? StatusCode { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string Title => StatusCode switch
    {
        404 => "COORDINATES UNKNOWN",
        403 => "ACCESS RESTRICTED",
        _ => "PROTOCOL EXCEPTION"
    };

    private string Description => StatusCode switch
    {
        404 => "The requested terminal address does not exist within the RedSkia network.",
        403 => "Your credentials lack the clearance required for this secure sector.",
        _ => "An internal system breach or protocol error has interrupted your session."
    };

    private string Icon => StatusCode switch
    {
        404 => "bi-geo-alt-fill",
        403 => "bi-lock-fill",
        _ => "bi-exclamation-triangle-fill"
    };

    private string DisplayCode => StatusCode?.ToString() ?? "500";
    private string? RequestId { get; set; }

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}