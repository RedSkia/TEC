name: dockercompose2368925463031383100
services:
  consoleapp:
    build:
      context: D:\Desktop\TEC\H3\Database\Restful
      dockerfile: ConsoleApp/Dockerfile
    container_name: consoleapp_service
    depends_on:
      mssql:
        condition: service_started
        required: true
    networks:
      default: null
  mssql:
    container_name: mssql_db
    environment:
      ACCEPT_EULA: "Y"
      SA_PASSWORD: DbPassw0rd
    image: mcr.microsoft.com/mssql/server:2022-latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 1433
        published: "1433"
        protocol: tcp
networks:
  default:
    name: dockercompose2368925463031383100_default